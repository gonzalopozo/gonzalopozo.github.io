div data-kid=\"187\" class=\"mobile-proof\">\n\t\t\t\t<p data-kid=\"188\" class=\"section-label\">320px header proof</p>\n\t\t\t\t<div data-kid=\"189\" class=\"mobile-frame\">\n\t\t\t\t\t<div data-kid=\"190\" class=\"mobile-row\">\n\t\t\t\t\t\t<span data-kid=\"191\" class=\"role-label\">Full Stack Developer</span>\n\t\t\t\t\t\t<a data-kid=\"192\" class=\"dl dl--compact\" aria-label=\"Download CV\" href=\"#download-cv\" target=\"_blank\" rel=\"noopener noreferrer\">\n\t\t\t<span data-kid=\"193\" class=\"dl__surface\" aria-hidden=\"true\"></span>\n\t\t\t<span data-kid=\"194\" class=\"dl__label\">Download CV</span>\n\t\t\t<span data-kid=\"195\" class=\"dl__slot\" aria-hidden=\"true\">\n\t\t\t\t<svg data-kid=\"196\" class=\"dl__icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n\t<path data-kid=\"197\" d=\"M20 7h-3a2 2 0 0 1-2-2V2\"></path>\n\t<path data-kid=\"198\" d=\"M9 18a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h6l5 5v9a2 2 0 0 1-2 2Z\"></path>\n\t<path data-kid=\"199\" d=\"M3 7v13a2 2 0 0 0 2 2h10\"></path>\n</svg>\n\t\t\t\t<span data-kid=\"200\" class=\"dl__tray\"></span>\n\t\t\t</span>\n\t\t\t<span data-kid=\"201\" class=\"dl__baseline\" aria-hidden=\"true\"></span>\n\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</section>\n\t</div>\n</main>",
