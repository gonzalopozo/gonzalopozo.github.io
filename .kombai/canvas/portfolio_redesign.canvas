" stroke-linejoin=\"round\">\n\t<path data-kid=\"53\" d=\"M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z\"></path>\n\t<path data-kid=\"54\" d=\"M14 2v6h6\"></path>\n\t<path data-kid=\"55\" d=\"M8 13h8\"></path>\n\t<path data-kid=\"56\" d=\"M8 17h5\"></path>\n</svg>\n\t\t\t\t<span data-kid=\"57\" class=\"dl__tray\"></span>\n\t\t\t</span>\n\t\t\t<span data-kid=\"58\" class=\"dl__baseline\" aria-hidden=\"true\"></span>\n\t\t</a>\n\t\t\t\t\t<p data-kid=\"59\" class=\"state-name\">Pressed</p>\n\t\t\t\t</div><div data-kid=\"60\" class=\"state-cell\">\n\t\t\t\t\t<a data-kid=\"61\" class=\"dl dl--compact\" data-state=\"reduced\" aria-label=\"Download CV\" href=\"#download-cv\" target=\"_blank\" rel=\"noopener noreferrer\">\n\t\t\t<span data-kid=\"62\" class=\"dl__surface\" aria-hidden=\"true\"></span>\n\t\t\t<span data-kid=\"63\" class=\"dl__label\">Download CV</span>\n\t\t\t<span data-kid=\"64\" class=\"dl__slot\" aria-hidden=\"true\">\n\t\t\t\t<svg data-kid=\"65\" class=\"dl__icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n\t<path data-kid=\"66\" d=\"M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z\"></path>\n\t<path data-kid=\"67\" d=\"M14 2v6h6\"></path>\n\t<path data-kid=\"68\" d=\"M8 13h8\"></path>\n\t<path data-kid=\"69\" d=\"M8 17h5\"></path>\n</svg>\n\t\t\t\t<span data-kid=\"70\" class=\"dl__tray\"></span>\n\t\t\t</span>\n\t\t\t<span data-kid=\"71\" class=\"dl__baseline\" aria-hidden=\"true\"></span>\n\t\t</a>\n\t\t\t\t\t<p data-kid=\"72\" class=\"state-name\">Reduced</p>\n\t\t\t\t</div></div>\n\t\t\t</div>\n\t\t\t<div data-kid=\"96\" class=\"mobile-proof\">\n\t\t\t\t<p data-kid=\"97\" class=\"section-label\">320px header proof</p>\n\t\t\t\t<div data-kid=\"98\" class=\"mobile-frame\">\n\t\t\t\t\t<div data-kid=\"99\" class=\"mobile-row\">\n\t\t\t\t\t\t<span data-kid=\"100\" class=\"role-label\">Full Stack Developer</span>\n\t\t\t\t\t\t<a data-kid=\"101\" class=\"dl dl--compact\" aria-label=\"Download CV\" href=\"#download-cv\" target=\"_blank\" rel=\"noopener noreferrer\">\n\t\t\t<span data-kid=\"102\" class=\"dl__surface\" aria-hidden=\"true\"></span>\n\t\t\t<span data-kid=\"103\" class=\"dl__label\">Download CV</span>\n\t\t\t<span data-kid=\"104\" class=\"dl__slot\" aria-hidden=\"true\">\n\t\t\t\t<svg data-kid=\"105\" class=\"dl__icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n\t<path data-kid=\"106\" d=\"M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z\"></path>\n\t<path data-kid=\"107\" d=\"M14 2v6h6\"></path>\n\t<path data-kid=\"108\" d=\"M8 13h8\"></path>\n\t<path data-kid=\"109\" d=\"M8 17h5\"></path>\n</svg>\n\t\t\t\t<span data-kid=\"110\" class=\"dl__tray\"></span>\n\t\t\t</span>\n\t\t\t<span data-kid=\"111\" class=\"dl__baseline\" aria-hidden=\"true\"></span>\n\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</section>\n\t\t<section data-kid=\"177\" class=\"theme-panel dark\">\n\t\t\t<p data-kid=\"178\" class=\"theme-kicker\">Dark theme</p>\n\t\t\t<div data-kid=\"179\" class=\"context-card\">\n\t\t\t\t<div data-kid=\"180\" class=\"header-row\">\n\t\t\t\t\t<span data-kid=\"181\" class=\"role-label\">Full Stack Developer</span>\n\t\t\t\t\t<a data-kid=\"182\" class=\"dl\" aria-label=\"Download CV\" href=\"#download-cv\" target=\"_blank\" rel=\"noopener noreferrer\">\n\t\t\t<span data-kid=\"183\" class=\"dl__surface\" aria-hidden=\"true\"></span>\n\t\t\t<span data-kid=\"184\" class=\"dl__label\">Download CV</span>\n\t\t\t<span data-kid=\"185\" class=\"dl__slot\" aria-hidden=\"true\">\n\t\t\t\t<svg data-kid=\"186\" class=\"dl__icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n\t<path data-kid=\"187\" d=\"M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z\"></path>\n\t<path data-kid=\"188\" d=\"M14 2v6h6\"></path>\n\t<path data-kid=\"189\" d=\"M8 13h8\"></path>\n\t<path data-kid=\"190\" d=\"M8 17h5\"></path>\n</svg>\n\t\t\t\t<span data-kid=\"191\" class=\"dl__tray\"></span>\n\t\t\t</span>\n\t\t\t<span data-kid=\"192\" class=\"dl__baseline\" aria-hidden=\"true\"></span>\n\t\t</a>\n\t\t\t\t\t<div data-kid=\"193\" class=\"status\">\n\t\t\t\t\t\t<span data-kid=\"194\" class=\"status-dot\" aria-hidden=\"true\"></span>\n\t\t\t\t\t\t<span data-kid=\"195\">¡ACTUALMENTE BUSCANDO EMPLEO!</span>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<p data-kid=\"196\" class=\"live-note\">Live control: hover, Tab to focus, or press. Only the centered icon scales; the outer 138 × 44px box stays fixed.</p>\n\t\t\t</div>\n\t\t\t<div data-kid=\"197\" class=\"states-block\">\n\t\t\t\t<p data-kid=\"198\" class=\"section-label\">State matrix</p>\n\t\t\t\t<div data-kid=\"199\" class=\"state-grid\"><div data-kid=\"112\" class=\"state-cell\">\n\t\t\t\t\t<a data-kid=\"113\" class=\"dl dl--compact\" aria-label=\"Download CV\" href=\"#download-cv\" target=\"_blank\" rel=\"noopener noreferrer\">\n\t\t\t<span data-kid=\"114\" class=\"dl__surface\" aria-hidden=\"true\"></span>\n\t\t\t<span data-kid=\"115\" class=\"dl__label\">Download CV</span>\n\t\t\t<span data-kid=\"116\" class=\"dl__slot\" aria-hidden=\"true\">\n\t\t\t\t<svg data-kid=\"117\" class=\"dl__icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n\t<path data-kid=\"118\" d=\"M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z\"></path>\n\t<path data-kid=\"119\" d=\"M14 2v6h6\"></path>\n\t<path data-kid=\"120\" d=\"M8 13h8\"></path>\n\t<path data-kid=\"121\" d=\"M8 17h5\"></path>\n</svg>\n\t\t\t\t<span data-kid=\"122\" class=\"dl__tray\"></span>\n\t\t\t</span>\n\t\t\t<span data-kid=\"123\" class=\"dl__baseline\" aria-hidden=\"true\"></span>\n\t\t</a>\n\t\t\t\t\t<p data-kid=\"124\" class=\"state-name\">Rest</p>\n\t\t\t\t</div><div data-kid=\"125\" class=\"state-cell\">\n\t\t\t\t\t<a data-kid=\"126\" class=\"dl dl--compact\" data-state=\"hover\" aria-label=\"Download C