    "var_9e461ab730c1": {
      "type": "variant",
      "label": "Download CV — Scale 1: Quiet Magnify",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 12420,
        "y": 0,
        "w": 1280,
        "h": 800
