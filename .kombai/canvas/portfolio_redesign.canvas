    "var_2a81264a1dbc": {
      "type": "variant",
      "label": "Editorial C: Structured Elegance",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n\n  body {\n    font-family: 'Inter', sans-serif;\n    margin: 0;\n    background-color: transparent;\n  }\n\n  .mask-linear {\n    mask-image: linear-gradient(to right, black calc(100% - 2rem), transparent);\n  }\n</style>\n<div class=\"flex items-center justify-center min-h-screen p-8 bg-(--background)\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"group/card relative w-full max-w-4xl bg-(--card) rounded-(--radius-4xl) border border-(--border) overflow-hidden transition-all duration-500 hover:shadow-2xl hover:shadow-(--primary)/5\" data-kid=\"1-1\" data-name=\"profile card\">\n        <div class=\"flex flex-col md:flex-row min-h-[400px]\" data-kid=\"1-1-1\" data-name=\"profile card content wrapper\">\n            <!-- Left Column (40%) -->\n            <div class=\"w-full md:w-[40%] relative border-b md:border-b-0 md:border-r border-(--border) p-8 flex flex-col items-center justify-center\" data-kid=\"1-1-1-1\" data-name=\"profile image column\">\n                <div class=\"relative w-full max-w-[280px] aspect-[3/4] rounded-2xl overflow-hidden bg-(--muted)\" data-kid=\"1-1-1-1-1\" data-name=\"profile image container\">\n                    <img alt=\"Gonzalo Pozo - Payton Tuttle on Unsplash\" class=\"size-full object-cover grayscale transition-all duration-700 ease-out group-hover/card:grayscale-0 group-hover/card:scale-105\" data-kid=\"1-1-1-1-1-1\" data-name=\"profile photograph\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1558730234-d8b2281b0d00?auto=format&w=800&q=80&fit=crop\"/>\n                    <!-- Integrated Status Badge -->\n                    <div class=\"absolute bottom-0 left-0 right-0 bg-(--card)/90 backdrop-blur-md border-t border-(--border) py-3 px-4 transform transition-transform duration-500 translate-y-full group-hover/card:translate-y-0 flex items-center gap-3\" data-kid=\"1-1-1-1-1-2\" data-name=\"status badge container\">\n                        <span class=\"relative flex size-2.5\" data-kid=\"1-1-1-1-1-2-1\" data-name=\"status ping animation container\">\n                            <span class=\"absolute inline-flex size-full rounded-full bg-(--status-active) opacity-75 animate-ping\" data-kid=\"1-1-1-1-1-2-1-1\" data-name=\"status pulse ripple circle\">\n                            </span>\n                            <span class=\"relative inline-flex size-2.5 rounded-full bg-(--status-active)\" data-kid=\"1-1-1-1-1-2-1-2\" data-name=\"status active dot\">\n                            </span>\n                        </span>\n                        <span class=\"text-[10px] font-bold uppercase tracking-widest text-(--foreground)\" data-kid=\"1-1-1-1-1-2-2\" data-name=\"status availability text\">\n                            Available for work\n                        </span>\n                    </div>\n                </div>\n                <!-- Subtle text behind image for editorial feel -->\n                <div class=\"absolute -left-4 top-1/2 -rotate-90 origin-center select-none pointer-events-none opacity-[0.03] text-8xl font-black text-(--foreground) whitespace-nowrap\" data-kid=\"1-1-1-1-2\" data-name=\"editorial background text\">\n                    DEVELOPER\n                </div>\n            </div>\n            <!-- Right Column (60%) -->\n            <div class=\"w-full md:w-[60%] flex flex-col p-8 md:p-12 relative\" data-kid=\"1-1-1-2\" data-name=\"profile information column\">\n                <!-- Secondary Header Area -->\n                <div class=\"flex justify-end mb-8\" data-kid=\"1-1-1-2-1\" data-name=\"secondary header area\">\n                    <a class=\"group/cv flex items-center gap-2 text-xs font-semibold tracking-wide text-(--muted-foreground) transition-colors hover:text-(--primary)\" data-kid=\"1-1-1-2-1-1\" data-name=\"download cv link\" href=\"#\">\n                        <span class=\"relative\" data-kid=\"1-1-1-2-1-1-1\" data-name=\"download cv label\">\n                            DOWNLOAD CV\n                            <span class=\"absolute -bottom-1 left-0 w-0 h-px bg-(--primary) transition-all duration-300 group-hover/cv:w-full\" data-kid=\"1-1-1-2-1-1-1-1\" data-name=\"download cv underline animation\">\n                            </span>\n                        </span>\n                        <svg class=\"lucide lucide-arrow-down-to-line\" data-kid=\"1-1-1-2-1-1-2\" data-name=\"download cv icon\" fill=\"none\" height=\"14\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" width=\"14\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path d=\"M12 17V3\">\n                            </path>\n                            <path d=\"m6 11 6 6 6-6\">\n                            </path>\n                            <path d=\"M19 21H5\">\n                            </path>\n                        </svg>\n                    </a>\n                </div>\n                <!-- Main Bio -->\n                <div class=\"flex-grow flex flex-col justify-center\" data-kid=\"1-1-1-2-2\" data-name=\"main bio content\">\n                    <div class=\"mb-4\" data-kid=\"1-1-1-2-2-1\" data-name=\"job title category container\">\n                        <span class=\"text-xs font-bold tracking-[0.2em] text-(--primary) uppercase\" data-kid=\"1-1-1-2-2-1-1\" data-name=\"job title text\">\n                            Full Stack Developer\n                        </span>\n                    </div>\n                    <h1 class=\"text-3xl md:text-4xl font-extrabold tracking-tight text-(--foreground) mb-6 leading-[1.1]\" data-kid=\"1-1-1-2-2-2\" data-name=\"hero headline text\">\n                        Hey, I'm\n                        <span class=\"relative inline-block px-1\" data-kid=\"1-1-1-2-2-2-1\" data-name=\"highlighted name container\">\n                            Gonzalo\n                            <span class=\"absolute inset-x-0 bottom-1 h-3 bg-(--primary)/10 -z-10\" data-kid=\"1-1-1-2-2-2-1-1\" data-name=\"highlight background shape\">\n                            </span>\n                        </span>\n                        .\n                    </h1>\n                    <p class=\"text-base/relaxed md:text-lg/relaxed text-(--muted-foreground) font-medium max-w-md\" data-kid=\"1-1-1-2-2-3\" data-name=\"bio description text\">\n                        I love turning ideas into real products people can use. I care about thoughtful interfaces, solid backend foundations, and curious, collaborative work.\n                    </p>\n                </div>\n                <!-- Pronounced About Me CTA -->\n                <div class=\"flex justify-end mt-12\" data-kid=\"1-1-1-2-3\" data-name=\"about me call-to-action container\">\n                    <button class=\"group/cta relative flex items-center justify-center h-14 pr-4 rounded-full overflow-hidden transition-all duration-500 hover:pr-6\" data-kid=\"1-1-1-2-3-1\" data-name=\"about me button\">\n                        <!-- Background expansion -->\n                        <div class=\"absolute inset-0 bg-(--secondary) translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover/cta:translate-x-0\" data-kid=\"1-1-1-2-3-1-1\" data-name=\"about me button background expansion layer\">\n                        </div>\n                        <div class=\"relative flex items-center\" data-kid=\"1-1-1-2-3-1-2\" data-name=\"about me button content wrapper\">\n                            <!-- Masked text reveal -->\n                            <div class=\"max-w-0 overflow-hidden transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover/cta:max-w-[120px]\" data-kid=\"1-1-1-2-3-1-2-1\" data-name=\"about me text container\">\n                                <span class=\"px-4 text-sm font-bold tracking-tight text-(--foreground) whitespace-nowrap opacity-0 group-hover/cta:opacity-100 transition-opacity duration-300 delay-100\" data-kid=\"1-1-1-2-3-1-2-1-1\" data-name=\"about me text\">\n                                    ABOUT ME\n                                </span>\n                            </div>\n                            <!-- Icon Circle -->\n                            <div class=\"size-10 rounded-full bg-(--primary) flex items-center justify-center text-(--primary-foreground) transition-all duration-500 group-hover/cta:scale-110 shadow-lg shadow-(--primary)/20\" data-kid=\"1-1-1-2-3-1-2-2\" data-name=\"about me arrow circle\">\n                                <svg class=\"lucide lucide-arrow-right transition-transform duration-500 group-hover/cta:translate-x-0.5\" data-kid=\"1-1-1-2-3-1-2-2-1\" data-name=\"arrow right icon\" fill=\"none\" height=\"18\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"3\" viewbox=\"0 0 24 24\" width=\"18\" xmlns=\"http://www.w3.org/2000/svg\">\n                                    <path d=\"M5 12h14\">\n                                    </path>\n                                    <path d=\"m12 5 7 7-7 7\">\n                                    </path>\n                                </svg>\n                            </div>\n                        </div>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n",
      "comments": [],
      "created": "2026-07-23T12:07:28.127327+00:00",
      "modified": "2026-07-23T12:07:41.039557+00:00",
      "id": "var_2a81264a1dbc"
    },
    "var_97ad88183d63": {
      "type": "variant",
      "label": "Editorial A: Clean Split",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<link data-kid=\"1\" data-name=\"Tabler icon web font library\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n\n  .font-sans {\n    font-family: 'Inter', sans-serif;\n  }\n\n  .ticket-stub {\n    clip-path: polygon(\n      0% 0%, 100% 0%, \n      100% 30%, 95% 40%, 95% 60%, 100% 70%, 100% 100%, \n      0% 100%, \n      0% 70%, 5% 60%, 5% 40%, 0% 30%\n    );\n  }\n\n  .cv-link::after {\n    content: '';\n    position: absolute;\n    bottom: -2px;\n    left: 0;\n    width: 0;\n    height: 1px;\n    background-color: var(--primary);\n    transition: width 0.3s ease;\n  }\n  .cv-link:hover::after {\n    width: 100%;\n  }\n\n  /* Custom Status Marquee if needed, though for editorial we might keep it simple */\n  @keyframes pulse-soft {\n    0%, 100% { opacity: 1; transform: scale(1); }\n    50% { opacity: 0.7; transform: scale(1.1); }\n  }\n  .animate-pulse-soft {\n    animation: pulse-soft 2s ease-in-out infinite;\n  }\n</style>\n<div class=\"font-sans min-h-screen bg-[var(--background)] flex items-center justify-center p-8\" data-kid=\"2\" data-name=\"main page layout wrapper\">\n    <div class=\"bg-[var(--card)] text-[var(--card-foreground)] rounded-[2rem] border border-[var(--border)] shadow-xl overflow-hidden max-w-4xl w-full grid grid-cols-1 md:grid-cols-[40%_60%] group/card\" data-kid=\"2-1\" data-name=\"profile card container\">\n        <!-- Profile Section (Left 40%) -->\n        <div class=\"relative p-6 md:p-8 flex items-center justify-center\" data-kid=\"2-1-1\" data-name=\"profile photo wrapper\">\n            <div class=\"relative w-full aspect-[3/4] overflow-hidden rounded-2xl\" data-kid=\"2-1-1-1\" data-name=\"profile photo container\">\n                <img alt=\"Gonzalo Pozo\" class=\"w-full h-full object-cover grayscale group-hover/card:grayscale-0 transition-all duration-700 ease-in-out scale-105 group-hover/card:scale-100\" data-kid=\"2-1-1-1-1\" data-name=\"profile portrait image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1558730234-d8b2281b0d00?auto=format&w=800&q=80&fit=crop\"/>\n                <!-- Ticket-stub Status Badge -->\n                <div class=\"absolute bottom-6 -right-3 ticket-stub bg-[var(--secondary)] px-6 py-3 shadow-lg flex items-center gap-3 border border-[var(--border)] transition-transform duration-500 group-hover/card:translate-x-1\" data-kid=\"2-1-1-1-2\" data-name=\"status badge ticket stub\">\n                    <span class=\"relative flex size-2.5\" data-kid=\"2-1-1-1-2-1\" data-name=\"status pulse indicator wrapper\">\n                        <span class=\"absolute inline-flex h-full w-full rounded-full bg-[var(--status-active)] opacity-75 animate-ping\" data-kid=\"2-1-1-1-2-1-1\" data-name=\"status ping animation effect\">\n                        </span>\n                        <span class=\"relative inline-flex size-2.5 rounded-full bg-[var(--status-active)]\" data-kid=\"2-1-1-1-2-1-2\" data-name=\"status active dot\">\n                        </span>\n                    </span>\n                    <span class=\"text-[10px] font-bold tracking-[0.2em] uppercase text-[var(--secondary-foreground)]\" data-kid=\"2-1-1-1-2-2\" data-name=\"working status label\">\n                        Working\n                    </span>\n                </div>\n            </div>\n        </div>\n        <!-- Content Section (Right 60%) -->\n        <div class=\"p-8 md:p-12 flex flex-col justify-between border-t md:border-t-0 md:border-l border-[var(--border)]\" data-kid=\"2-1-2\" data-name=\"profile content container\">\n            <!-- Top Actions -->\n            <div class=\"flex justify-end\" data-kid=\"2-1-2-1\" data-name=\"top actions wrapper\">\n                <a class=\"cv-link relative inline-flex items-center gap-2 text-xs font-semibold tracking-wider uppercase text-[var(--muted-foreground)] hover:text-[var(--primary)] transition-colors duration-300\" data-kid=\"2-1-2-1-1\" data-name=\"download cv link\" href=\"#\">\n                    <i class=\"ti ti-file-download text-sm\" data-kid=\"2-1-2-1-1-1\" data-name=\"file download icon\">\n                    </i>\n                    <span data-kid=\"2-1-2-1-1-2\" data-name=\"download cv label\">\n                        Download CV\n                    </span>\n                </a>\n            </div>\n            <!-- Main Bio -->\n            <div class=\"py-12 md:py-0\" data-kid=\"2-1-2-2\" data-name=\"main bio content\">\n                <p class=\"text-lg md:text-xl leading-[1.8] text-[var(--card-foreground)] font-light text-pretty\" data-kid=\"2-1-2-2-1\" data-name=\"bio introductory text\">\n                    Hey, I'm\n                    <span class=\"font-bold text-[var(--primary)] decoration-[var(--primary)]/30 underline-offset-4 decoration-2\" data-kid=\"2-1-2-2-1-1\" data-name=\"name highlight text\">\n                        Gonzalo\n                    </span>\n                    , a full-stack developer from Madrid who loves turning ideas into real products people can use.\n                </p>\n                <p class=\"mt-6 text-sm md:text-base leading-[1.75] text-[var(--muted-foreground)] text-pretty\" data-kid=\"2-1-2-2-2\" data-name=\"bio detailed description text\">\n                    I care about thoughtful interfaces, solid backend foundations, and the kind of curious, collaborative work that keeps improving the product, the code, and the people building it.\n                </p>\n            </div>\n            <!-- Bottom Actions -->\n            <div class=\"flex justify-end\" data-kid=\"2-1-2-3\" data-name=\"bottom actions wrapper\">\n                <button class=\"group/btn relative flex items-center justify-between h-12 px-1.5 rounded-full bg-[var(--secondary)] border border-[var(--border)] transition-all duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] hover:pr-5 hover:bg-[var(--primary)] hover:border-[var(--primary)] min-w-[3rem] w-12 hover:w-44\" data-kid=\"2-1-2-3-1\" data-name=\"about me button\">\n                    <span class=\"ml-4 text-xs font-bold tracking-widest uppercase opacity-0 group-hover/btn:opacity-100 text-[var(--primary-foreground)] transition-opacity duration-300 whitespace-nowrap overflow-hidden\" data-kid=\"2-1-2-3-1-1\" data-name=\"about me label\">\n                        About me\n                    </span>\n                    <div class=\"flex items-center justify-center size-9 rounded-full bg-[var(--card)] group-hover/btn:bg-[var(--primary-foreground)] text-[var(--card-foreground)] group-hover/btn:text-[var(--primary)] transition-colors duration-300 shrink-0\" data-kid=\"2-1-2-3-1-2\" data-name=\"button icon wrapper\">\n                        <i class=\"ti ti-arrow-right text-lg transition-transform duration-500 group-hover/btn:rotate-[-45deg]\" data-kid=\"2-1-2-3-1-2-1\" data-name=\"arrow right icon\">\n                        </i>\n                    </div>\n                </button>\n            </div>\n        </div>\n    </div>\n</div>\n",
      "comments": [],
