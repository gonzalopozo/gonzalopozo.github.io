      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap');\n\n:root {\n\t--background: oklch(0.975 0.008 270);\n\t--foreground: oklch(0.155 0.025 270);\n\t--card: oklch(1 0 0);\n\t--card-foreground: oklch(0.155 0.025 270);\n\t--primary: oklch(0.4 0.17 250);\n\t--primary-foreground: oklch(0.985 0.005 250);\n\t--secondary: oklch(0.945 0.012 270);\n\t--secondary-foreground: oklch(0.195 0.025 270);\n\t--muted: oklch(0.92 0.008 270);\n\t--muted-foreground: oklch(0.43 0.02 265);\n\t--accent: oklch(0.7 0.18 55);\n\t--accent-foreground: oklch(0.2 0.05 55);\n\t--border: oklch(0.885 0.012 270);\n\t--ring: oklch(0.48 0.17 250);\n\t--status-active: oklch(0.52 0.175 155);\n\n\t/* derived control tokens — resolve lazily, so they adapt to .dark automatically */\n\t--dl-border-rest: color-mix(in oklch, var(--border) 70%, transparent);\n\t--dl-border-hot: color-mix(in oklch, var(--accent) 50%, transparent);\n\t--dl-fill: color-mix(in oklch, var(--accent) 14%, transparent);\n\t--dl-fill-active: color-mix(in oklch, var(--accent) 26%, transparent);\n\t--dl-tray-rest: color-mix(in oklch, var(--border) 60%, transparent);\n\t--dl-ring: color-mix(in oklch, var(--accent) 55%, transparent);\n\t--dl-glow: 0 0 6px color-mix(in oklch, var(--accent) 45%, transparent);\n\t--status-border: color-mix(in oklch, var(--status-active) 35%, transparent);\n\t--status-bg: color-mix(in oklch, var(--status-active) 10%, transparent);\n\t--dl-ease: cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n.dark {\n\t--background: oklch(0.12 0.025 275);\n\t--foreground: oklch(0.95 0.008 265);\n\t--card: oklch(0.175 0.022 270);\n\t--card-foreground: oklch(0.95 0.008 265);\n\t--primary: oklch(0.75 0.17 235);\n\t--primary-foreground: oklch(0.12 0.035 235);\n\t--secondary: oklch(0.225 0.018 275);\n\t--secondary-foreground: oklch(0.91 0.008 265);\n\t--muted: oklch(0.225 0.018 275);\n\t--muted-foreground: oklch(0.58 0.016 265);\n\t--accent: oklch(0.8 0.17 50);\n\t--accent-foreground: oklch(0.12 0.045 50);\n\t--border: oklch(0.265 0.018 275);\n\t--ring: oklch(0.75 0.17 235);\n\t--status-active: oklch(0.7 0.175 155);\n}\n\n/* ─────────────────────────────────────────────────────────────\n   THE CONTROL — variant B, \"loading tray fill\"\n   Outer <a> geometry is frozen: only color, an absolutely\n   positioned fill layer, the tray bar and the icon ever change.\n   ───────────────────────────────────────────────────────────── */\n.dl {\n\tposition: relative;\n\tisolation: isolate;\n\tdisplay: inline-flex;\n\tflex-shrink: 0;\n\talign-items: center;\n\tgap: 0.375rem;\n\tmin-height: 2.75rem; /* 44px touch target — never changes */\n\tpadding-inline: 0.75rem; /* never changes */\n\tborder: 1px solid var(--dl-border-rest); /* present at rest; width never changes */\n\tborder-radius: 9999px;\n\toverflow: hidden;\n\tfont-size: 0.75rem;\n\tline-height: 1rem;\n\tfont-weight: 600;\n\tletter-spacing: 0.025em;\n\tcolor: var(--muted-foreground);\n\tbackground: transparent;\n\ttext-decoration: none;\n\ttransition:\n\t\tcolor 300ms var(--dl-ease),\n\t\tborder-color 300ms var(--dl-ease),\n\t\tbox-shadow 200ms var(--dl-ease);\n}\n\n.dl__fill {\n\tposition: absolute;\n\tinset: 0;\n\tz-index: -1;\n\tborder-radius: inherit;\n\tbackground: var(--dl-fill);\n\ttransform: scaleY(0);\n\ttransform-origin: bottom;\n\tpointer-events: none;\n\ttransition:\n\t\ttransform 380ms var(--dl-ease),\n\t\tbackground-color 200ms ease-out;\n}\n\n.dl__tray {\n\tposition: absolute;\n\tright: 0.625rem;\n\tbottom: 7px;\n\tleft: 0.625rem;\n\theight: 2px;\n\tborder-radius: 9999px;\n\tbackground: var(--dl-tray-rest);\n\tpointer-events: none;\n\ttransition:\n\t\tbackground-color 300ms ease-out,\n\t\tbox-shadow 300ms ease-out,\n\t\topacity 120ms ease-out;\n}\n\n/* fixed inline box reserves the icon area — travel can never push the label */\n.dl__slot {\n\tposition: relative;\n\tdisplay: block;\n\tflex-shrink: 0;\n\twidth: 0.875rem;\n\theight: 1.25rem;\n\toverflow: hidden;\n}\n\n.dl__icon {\n\tposition: absolute;\n\ttop: 3px;\n\tleft: 0;\n\twidth: 0.875rem;\n\theight: 0.875rem;\n}\n\n/* ── engaged states: hover, real focus, forced matrix states ── */\n.dl:hover,\n.dl:focus-visible,\n.dl[data-state='hover'],\n.dl[data-state='focus'],\n.dl[data-state='active'],\n.dl[data-state='reduced'] {\n\tcolor: var(--foreground);\n\tborder-color: var(--dl-border-hot);\n}\n\n.dl:hover .dl__fill,\n.dl:focus-visible .dl__fill,\n.dl[data-state='hover'] .dl__fill,\n.dl[data-state='focus'] .dl__fill {\n\ttransform: scaleY(1);\n}\n\n.dl:hover .dl__tray,\n.dl:focus-visible .dl__tray,\n.dl[data-state='hover'] .dl__tray,\n.dl[data-state='focus'] .dl__tray,\n.dl[data-state='active'] .dl__tray,\n.dl[data-state='reduced'] .dl__tray {\n\tbackground: var(--accent);\n\tbox-shadow: var(--dl-glow);\n}\n\n/* signature offset ring — painted outside the box, layout untouched */\n.dl:focus-visible,\n.dl[data-state='focus'] {\n\toutline: none;\n\tbox-shadow:\n\t\t0 0 0 2px var(--card),\n\t\t0 0 0 4px var(--dl-ring);\n}\n\n/* pressed: tray fills instantly and deepens one step, bar dims in opacity only */\n.dl:active .dl__fill,\n.dl[data-state='active'] .dl__fill {\n\ttransform: scaleY(1);\n\tbackground: var(--dl-fill-active);\n\ttransition-duration: 0ms;\n}\n\n.dl:active .dl__tray,\n.dl[data-state='active'] .dl__tray {\n\topacity: 0.5;\n}\n\n/* two-beat settle: down 2px, back with a slight overshoot, inside the slot */\n@keyframes dl-settle {\n\t0% {\n\t\ttransform: translateY(0);\n\t}\n\t38% {\n\t\ttransform: translateY(2px);\n\t}\n\t70% {\n\t\ttransform: translateY(-1px);\n\t}\n\t100% {\n\t\ttransform: translateY(0);\n\t}\n}\n\n@media (prefers-reduced-motion: no-preference) {\n\t.dl:hover .dl__icon,\n\t.dl:focus-visible .dl__icon {\n\t\tanimation: dl-settle 460ms var(--dl-ease);\n\t}\n}\n\n/* reduced motion: fill + settle stand down, colour/border/tray still fire */\n@media (prefers-reduced-motion: reduce) {\n\t.dl__fill,\n\t.dl:hover .dl__fill,\n\t.dl:focus-visible .dl__fill {\n\t\ttransform: scaleY(0);\n\t\ttransition: none;\n\t}\n}\n\n.dl[data-state='reduced'] .dl__fill {\n\ttransform: scaleY(0);\n}\n\n/* scaled-up diagram pill — proportional, not transform-scaled, so strokes stay honest */\n.dl-x3 {\n\tposition: relative;\n\tisolation: isolate;\n\tdisplay: inline-flex;\n\talign-items: center;\n\tgap: 0.75rem;\n\theight: 5.5rem;\n\tpadding-inline: 1.5rem;\n\tborder: 2px solid var(--dl-border-hot);\n\tborder-radius: 9999px;\n\toverflow: hidden;\n\tfont-size: 1.5rem;\n\tfont-weight: 600;\n\tletter-spacing: 0.025em;\n\tcolor: var(--foreground);\n}\n\n.dl-x3__fill {\n\tposition: absolute;\n\tinset: 0;\n\tz-index: -1;\n\tbackground: var(--dl-fill);\n\ttransform-origin: bottom;\n}\n\n.dl-x3__tray {\n\tposition: absolute;\n\tright: 1.25rem;\n\tbottom: 14px;\n\tleft: 1.25rem;\n\theight: 4px;\n\tborder-radius: 9999px;\n\tbackground: var(--accent);\n\tbox-shadow: 0 0 14px color-mix(in oklch, var(--accent) 45%, transparent);\n}\n\n/* keep the diagram's icon slot proportional to the scaled pill */\n.dl-x3 > span:nth-child(3) {\n\twidth: 1.75rem;\n\theight: 2.5rem;\n}\n\n.dl-x3 > span:nth-child(3) svg {\n\ttop: 6px;\n\twidth: 1.75rem;\n\theight: 1.75rem;\n}\n\n/* the fully-filled frame shows the arrow at the bottom of its travel (+2px, scaled) */\n.dl-x3:has(> span[style*='scaleY(1)']) > span:nth-child(3) svg {\n\ttop: 11px;\n}\n\n.lbl {\n\tfont-size: 11px;\n\tfont-weight: 600;\n\tletter-spacing: 0.18em;\n\ttext-transform: uppercase;\n\tcolor: var(--muted-foreground);\n}\n\n.guide {\n\tposition: absolute;\n\ttop: -0.75rem;\n\tbottom: -0.75rem;\n\twidth: 0;\n\tborder-left: 1px dashed color-mix(in oklch, var(--accent) 55%, transparent);\n}\n\n.code {\n\tfont-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;\n\tfont-size: 11.5px;\n\tline-height: 1.85;\n}\n</style>\n<div class=\"w-full\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family: 'Geist', system-ui, sans-serif\">\n    <!-- ══════════════════ DARK HALF ══════════════════ -->\n    <div class=\"dark bg-[var(--background)] px-14 pt-12 pb-16 text-[var(--foreground)]\" data-kid=\"1-1\" data-name=\"dark theme section container\">\n        <div class=\"mb-10 flex items-end justify-between gap-8 border-b border-[var(--border)] pb-6\" data-kid=\"1-1-1\" data-name=\"header row container\">\n            <div data-kid=\"1-1-1-1\" data-name=\"header title group\">\n                <p class=\"lbl mb-2\" data-kid=\"1-1-1-1-1\" data-name=\"spec section label\">\n                    Micro-interaction spec · variant B of 3\n                </p>\n                <h2 class=\"text-[22px] leading-tight font-semibold tracking-tight\" data-kid=\"1-1-1-1-2\" data-name=\"spec section title\">\n                    B — Loading Tray Fill\n                </h2>\n                <p class=\"mt-2 max-w-2xl text-[13px] leading-relaxed text-[var(--muted-foreground)]\" data-kid=\"1-1-1-1-3\" data-name=\"spec section description\">\n                    The pill behaves like a tiny download tray: an accent wash grows from the bottom\n\t\t\t\t\tedge upward while the baseline bar lights up and the arrow settles onto it — as\n\t\t\t\t\tif the file just landed. The outer link never moves.\n                </p>\n            </div>\n            <div class=\"shrink-0 text-right\" data-kid=\"1-1-1-2\" data-name=\"timing information container\">\n                <p class=\"lbl mb-1.5\" data-kid=\"1-1-1-2-1\" data-name=\"timing label\">\n                    Dark mode\n                </p>\n                <p class=\"code text-[var(--muted-foreground)]\" data-kid=\"1-1-1-2-2\" data-name=\"timing details\">\n                    380ms fill · 460ms settle\n                    <br data-kid=\"1-1-1-2-2-1\" data-name=\"line break\"/>\n                    cubic-bezier(.16,1,.3,1)\n                </p>\n            </div>\n        </div>\n        <!-- ── BLOCK 1 · in context ── -->\n        <p class=\"lbl mb-4\" data-kid=\"1-1-2\" data-name=\"context section label\">\n            01 — In context · live, hover the control\n        </p>\n        <div class=\"mb-14 flex flex-wrap items-start gap-10\" data-kid=\"1-1-3\" data-name=\"live preview section\">\n            <div class=\"grid h-[288px] w-[583px] shrink-0 grid-cols-[minmax(0,2fr)_minmax(0,3fr)] overflow-hidden rounded-[2rem] bg-[var(--card)] text-[var(--card-foreground)]\" data-kid=\"1-1-3-1\" data-name=\"profile card\">\n                <div class=\"flex min-h-0 min-w-0 items-center justify-center border-r border-[var(--border)] p-5\" data-kid=\"1-1-3-1-1\" data-name=\"profile image container\">\n                    <div class=\"relative aspect-3/4 h-full max-w-[17.5rem] overflow-hidden rounded-2xl bg-[var(--muted)]\" data-kid=\"1-1-3-1-1-1\" data-name=\"profile image wrapper\">\n                        <img alt=\"Gonzalo Pozo, Full Stack Developer\" class=\"size-full object-cover grayscale\" data-kid=\"1-1-3-1-1-1-1\" data-name=\"profile photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/cv_pic.png\"/>\n                    </div>\n                </div>\n                <div class=\"grid min-h-0 min-w-0 grid-rows-[auto_minmax(0,1fr)_auto] gap-3 p-5\" data-kid=\"1-1-3-1-2\" data-name=\"profile content area\">\n                    <div class=\"flex min-w-0 flex-wrap items-center justify-between gap-x-2 gap-y-3\" data-kid=\"1-1-3-1-2-1\" data-name=\"profile header row\">\n                        <span class=\"min-w-0 truncate text-xs font-semibold text-[var(--muted-foreground)]\" data-kid=\"1-1-3-1-2-1-1\" data-name=\"job title text\">\n                            Full Stack Developer\n                        </span>\n                        <a aria-label=\"Download CV\" class=\"dl -mr-1\" data-kid=\"1-1-3-1-2-1-2\" data-name=\"download cv button\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            <span aria-hidden=\"true\" class=\"dl__fill\" data-kid=\"1-1-3-1-2-1-2-1\" data-name=\"download button fill layer\">\n                            </span>\n                            <span data-kid=\"1-1-3-1-2-1-2-2\" data-name=\"download button text\">\n                                Download CV\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl__slot\" data-kid=\"1-1-3-1-2-1-2-3\" data-name=\"download icon slot\">\n                                <svg class=\"dl__icon\" data-kid=\"1-1-3-1-2-1-2-3-1\" data-name=\"download arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl__tray\" data-kid=\"1-1-3-1-2-1-2-4\" data-name=\"download tray bar\">\n                            </span>\n                        </a>\n                        <div class=\"flex max-h-16 min-w-0 basis-full items-start gap-2.5 rounded-xl border px-3 py-2 text-xs/relaxed font-semibold\" data-kid=\"1-1-3-1-2-1-3\" data-name=\"status badge\" style=\"\n\t\t\t\t\t\t\t\tborder-color: var(--status-border);\n\t\t\t\t\t\t\t\tbackground: var(--status-bg);\n\t\t\t\t\t\t\t\tcolor: var(--foreground);\n\t\t\t\t\t\t\t\">\n                            <span aria-hidden=\"true\" class=\"mt-1 size-2 shrink-0 rounded-full bg-[var(--status-active)] motion-safe:animate-pulse\" data-kid=\"1-1-3-1-2-1-3-1\" data-name=\"status pulse dot\">\n                            </span>\n                            <span class=\"min-w-0\" data-kid=\"1-1-3-1-2-1-3-2\" data-name=\"status label text\">\n                                Actualmente buscando empleo\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"flex min-h-0 min-w-0 flex-col justify-center gap-2 overflow-hidden\" data-kid=\"1-1-3-1-2-2\" data-name=\"profile main text container\">\n                        <h1 class=\"text-2xl/tight font-bold tracking-tight text-[var(--foreground)]\" data-kid=\"1-1-3-1-2-2-1\" data-name=\"profile headline\">\n                            Hey, I'm Gonzalo.\n                        </h1>\n                        <p class=\"line-clamp-3 max-w-md text-sm/relaxed text-[var(--muted-foreground)]\" data-kid=\"1-1-3-1-2-2-2\" data-name=\"profile description\">\n                            I love turning ideas into real products people can use. I care about\n\t\t\t\t\t\t\tthoughtful interfaces, solid backend foundations, and the kind of\n\t\t\t\t\t\t\tcurious, collaborative work that keeps improving the product, the code,\n\t\t\t\t\t\t\tand the people building it.\n                        </p>\n                    </div>\n                    <div class=\"flex min-w-0 justify-end\" data-kid=\"1-1-3-1-2-3\" data-name=\"footer cta container\">\n                        <a class=\"inline-flex min-h-11 items-center gap-2 rounded-full bg-[var(--primary)] px-5 text-sm font-medium text-[var(--primary-foreground)] no-underline\" data-kid=\"1-1-3-1-2-3-1\" data-name=\"about me button\" href=\"#\">\n                            About Me\n                            <svg aria-hidden=\"true\" class=\"size-4\" data-kid=\"1-1-3-1-2-3-1-1\" data-name=\"about me arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n                                <path d=\"M5 12h14\">\n                                </path>\n                                <path d=\"m12 5 7 7-7 7\">\n                                </path>\n                            </svg>\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"min-w-[300px] max-w-[420px] flex-1\" data-kid=\"1-1-3-2\" data-name=\"features explanation container\">\n                <p class=\"lbl mb-3\" data-kid=\"1-1-3-2-1\" data-name=\"features list label\">\n                    Header row, recalibrated\n                </p>\n                <ul class=\"space-y-2.5 text-[13px] leading-relaxed text-[var(--muted-foreground)]\" data-kid=\"1-1-3-2-2\" data-name=\"features list\">\n                    <li data-kid=\"1-1-3-2-2-1\" data-name=\"feature list item 1\">\n                        <span class=\"font-semibold text-[var(--foreground)]\" data-kid=\"1-1-3-2-2-1-1\" data-name=\"feature label 1\">\n                            Eyebrow calmed\n                        </span>\n                        —\n\t\t\t\t\t\tsentence case, muted, no longer primary cyan. It labels, it doesn't shout.\n                    </li>\n                    <li data-kid=\"1-1-3-2-2-2\" data-name=\"feature list item 2\">\n                        <span class=\"font-semibold text-[var(--foreground)]\" data-kid=\"1-1-3-2-2-2-1\" data-name=\"feature label 2\">\n                            Status softened\n                        </span>\n                        —\n\t\t\t\t\t\tsentence case, pulse dot kept. Still readable, no longer a second badge\n\t\t\t\t\t\tcompeting for the eye.\n                    </li>\n                    <li data-kid=\"1-1-3-2-2-3\" data-name=\"feature list item 3\">\n                        <span class=\"font-semibold text-[var(--foreground)]\" data-kid=\"1-1-3-2-2-3-1\" data-name=\"feature label 3\">\n                            Colour re-budgeted\n                        </span>\n                        — cyan now belongs to the About Me CTA alone; the download spends\n                        <em data-kid=\"1-1-3-2-2-3-2\" data-name=\"emphasized text 3\">\n                            gold accent\n                        </em>\n                        , so the two never read as the same thing.\n                    </li>\n                    <li data-kid=\"1-1-3-2-2-4\" data-name=\"feature list item 4\">\n                        <span class=\"font-semibold text-[var(--foreground)]\" data-kid=\"1-1-3-2-2-4-1\" data-name=\"feature label 4\">\n                            Visible at rest\n                        </span>\n                        —\n\t\t\t\t\t\ta hairline border plus the always-present tray bar mark it as an action\n\t\t\t\t\t\tbefore the cursor arrives.\n                    </li>\n                </ul>\n            </div>\n        </div>\n        <!-- ── BLOCK 2 · state matrix ── -->\n        <p class=\"lbl mb-4\" data-kid=\"1-1-4\" data-name=\"state matrix section label\">\n            02 — State matrix · all states forced, zero geometry drift\n        </p>\n        <div class=\"mb-14 rounded-2xl bg-[var(--card)] p-8\" data-kid=\"1-1-5\" data-name=\"state matrix container\">\n            <div class=\"flex items-start gap-8\" data-kid=\"1-1-5-1\" data-name=\"state matrix grid\">\n                <div class=\"relative w-max shrink-0\" data-kid=\"1-1-5-1-1\" data-name=\"state preview column\">\n                    <span class=\"guide\" data-kid=\"1-1-5-1-1-1\" data-name=\"left dashed guide\" style=\"left: 0\">\n                    </span>\n                    <span class=\"guide\" data-kid=\"1-1-5-1-1-2\" data-name=\"right dashed guide\" style=\"right: 0\">\n                    </span>\n                    <div class=\"flex w-max flex-col gap-3\" data-kid=\"1-1-5-1-1-3\" data-name=\"download buttons stack\">\n                        <a aria-label=\"Download CV\" class=\"dl\" data-kid=\"1-1-5-1-1-3-1\" data-name=\"rest state button\" href=\"#\">\n                            <span aria-hidden=\"true\" class=\"dl__fill\" data-kid=\"1-1-5-1-1-3-1-1\">\n                            </span>\n                            <span data-kid=\"1-1-5-1-1-3-1-2\">\n                                Download CV\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl__slot\" data-kid=\"1-1-5-1-1-3-1-3\">\n                                <svg class=\"dl__icon\" data-kid=\"1-1-5-1-1-3-1-3-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl__tray\" data-kid=\"1-1-5-1-1-3-1-4\">\n                            </span>\n                        </a>\n                        <a aria-label=\"Download CV\" class=\"dl\" data-kid=\"1-1-5-1-1-3-2\" data-name=\"hover state button\" data-state=\"hover\" href=\"#\">\n                            <span aria-hidden=\"true\" class=\"dl__fill\" data-kid=\"1-1-5-1-1-3-2-1\">\n                            </span>\n                            <span data-kid=\"1-1-5-1-1-3-2-2\">\n                                Download CV\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl__slot\" data-kid=\"1-1-5-1-1-3-2-3\">\n                                <svg class=\"dl__icon\" data-kid=\"1-1-5-1-1-3-2-3-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl__tray\" data-kid=\"1-1-5-1-1-3-2-4\">\n                            </span>\n                        </a>\n                        <a aria-label=\"Download CV\" class=\"dl\" data-kid=\"1-1-5-1-1-3-3\" data-name=\"focus state button\" data-state=\"focus\" href=\"#\">\n                            <span aria-hidden=\"true\" class=\"dl__fill\" data-kid=\"1-1-5-1-1-3-3-1\">\n                            </span>\n                            <span data-kid=\"1-1-5-1-1-3-3-2\">\n                                Download CV\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl__slot\" data-kid=\"1-1-5-1-1-3-3-3\">\n                                <svg class=\"dl__icon\" data-kid=\"1-1-5-1-1-3-3-3-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl__tray\" data-kid=\"1-1-5-1-1-3-3-4\">\n                            </span>\n                        </a>\n                        <a aria-label=\"Download CV\" class=\"dl\" data-kid=\"1-1-5-1-1-3-4\" data-name=\"active state button\" data-state=\"active\" href=\"#\">\n                            <span aria-hidden=\"true\" class=\"dl__fill\" data-kid=\"1-1-5-1-1-3-4-1\">\n                            </span>\n                            <span data-kid=\"1-1-5-1-1-3-4-2\">\n                                Download CV\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl__slot\" data-kid=\"1-1-5-1-1-3-4-3\">\n                                <svg class=\"dl__icon\" data-kid=\"1-1-5-1-1-3-4-3-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl__tray\" data-kid=\"1-1-5-1-1-3-4-4\">\n                            </span>\n                        </a>\n                        <a aria-label=\"Download CV\" class=\"dl\" data-kid=\"1-1-5-1-1-3-5\" data-name=\"reduced motion state button\" data-state=\"reduced\" href=\"#\">\n                            <span aria-hidden=\"true\" class=\"dl__fill\" data-kid=\"1-1-5-1-1-3-5-1\">\n                            </span>\n                            <span data-kid=\"1-1-5-1-1-3-5-2\">\n                                Download CV\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl__slot\" data-kid=\"1-1-5-1-1-3-5-3\">\n                                <svg class=\"dl__icon\" data-kid=\"1-1-5-1-1-3-5-3-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl__tray\" data-kid=\"1-1-5-1-1-3-5-4\">\n                            </span>\n                        </a>\n                    </div>\n                </div>\n                <div class=\"flex flex-col gap-3 pt-px\" data-kid=\"1-1-5-1-2\" data-name=\"state description column\">\n                    <div class=\"flex h-11 flex-col justify-center\" data-kid=\"1-1-5-1-2-1\" data-name=\"rest state label group\">\n                        <p class=\"text-[13px] font-semibold\" data-kid=\"1-1-5-1-2-1-1\" data-name=\"rest state title\">\n                            Rest\n                        </p>\n                        <p class=\"text-[11.5px] text-[var(--muted-foreground)]\" data-kid=\"1-1-5-1-2-1-2\" data-name=\"rest state description\">\n                            hairline border · grey tray bar · muted label\n                        </p>\n                    </div>\n                    <div class=\"flex h-11 flex-col justify-center\" data-kid=\"1-1-5-1-2-2\" data-name=\"hover state label group\">\n                        <p class=\"text-[13px] font-semibold\" data-kid=\"1-1-5-1-2-2-1\" data-name=\"hover state title\">\n                            Hover\n                        </p>\n                        <p class=\"text-[11.5px] text-[var(--muted-foreground)]\" data-kid=\"1-1-5-1-2-2-2\" data-name=\"hover state description\">\n                            fill grown from bottom · tray lit gold + glow · label to foreground ·\n\t\t\t\t\t\t\tarrow settles\n                        </p>\n                    </div>\n                    <div class=\"flex h-11 flex-col justify-center\" data-kid=\"1-1-5-1-2-3\" data-name=\"focus state label group\">\n                        <p class=\"text-[13px] font-semibold\" data-kid=\"1-1-5-1-2-3-1\" data-name=\"focus state title\">\n                            Focus-visible\n                        </p>\n                        <p class=\"text-[11.5px] text-[var(--muted-foreground)]\" data-kid=\"1-1-5-1-2-3-2\" data-name=\"focus state description\">\n                            hover treatment + 2px offset accent ring on the card surface\n                        </p>\n                    </div>\n                    <div class=\"flex h-11 flex-col justify-center\" data-kid=\"1-1-5-1-2-4\" data-name=\"active state label group\">\n                        <p class=\"text-[13px] font-semibold\" data-kid=\"1-1-5-1-2-4-1\" data-name=\"active state title\">\n                            Active / pressed\n                        </p>\n                        <p class=\"text-[11.5px] text-[var(--muted-foreground)]\" data-kid=\"1-1-5-1-2-4-2\" data-name=\"active state description\">\n                            fill jumps to full instantly and deepens · tray dims in opacity only\n                        </p>\n                    </div>\n                    <div class=\"flex h-11 flex-col justify-center\" data-kid=\"1-1-5-1-2-5\" data-name=\"reduced motion state label group\">\n                        <p class=\"text-[13px] font-semibold\" data-kid=\"1-1-5-1-2-5-1\" data-name=\"reduced motion state title\">\n                            Reduced motion (hover)\n                        </p>\n                        <p class=\"text-[11.5px] text-[var(--muted-foreground)]\" data-kid=\"1-1-5-1-2-5-2\" data-name=\"reduced motion state description\">\n                            no fill growth, no settle — border, label and lit tray still answer\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <p class=\"mt-7 border-t border-[var(--border)] pt-5 text-[12px] text-[var(--muted-foreground)]\" data-kid=\"1-1-5-2\" data-name=\"matrix footer note\">\n                <span class=\"font-semibold text-[var(--foreground)]\" data-kid=\"1-1-5-2-1\" data-name=\"note bold label\">\n                    Dashed guides\n                </span>\n                mark the\n\t\t\t\tRest pill's left and right edges. Every state sits exactly between them: identical\n\t\t\t\twidth, identical 44px height, identical padding, gap, font size and border width.\n\t\t\t\tNothing the interaction touches participates in layout.\n            </p>\n        </div>\n        <!-- ── BLOCK 3 · mechanic ── -->\n        <p class=\"lbl mb-4\" data-kid=\"1-1-6\" data-name=\"mechanic section label\">\n            03 — Mechanic · fill layer grows from origin-bottom\n        </p>\n        <div class=\"mb-4 rounded-2xl bg-[var(--card)] p-8\" data-kid=\"1-1-7\" data-name=\"mechanic container\">\n            <div class=\"flex flex-wrap items-end gap-8\" data-kid=\"1-1-7-1\" data-name=\"mechanic diagram row\">\n                <div data-kid=\"1-1-7-1-1\" data-name=\"diagram unit 0 percent\">\n                    <span class=\"dl-x3\" data-kid=\"1-1-7-1-1-1\" data-name=\"scaled-up download pill\">\n                        <span class=\"dl-x3__fill\" data-kid=\"1-1-7-1-1-1-1\" data-name=\"diagram fill 0\" style=\"transform: scaleY(0)\">\n                        </span>\n                        <span data-kid=\"1-1-7-1-1-1-2\">\n                            Download CV\n                        </span>\n                        <span class=\"relative block h-[3.75rem] w-[2.625rem] overflow-hidden\" data-kid=\"1-1-7-1-1-1-3\">\n                            <svg class=\"absolute top-[9px] left-0 size-[2.625rem]\" data-kid=\"1-1-7-1-1-1-3-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                <path d=\"M12 17V3\">\n                                </path>\n                                <path d=\"m6 11 6 6 6-6\">\n                                </path>\n                                <path d=\"M19 21H5\">\n                                </path>\n                            </svg>\n                        </span>\n                        <span class=\"dl-x3__tray\" data-kid=\"1-1-7-1-1-1-4\">\n                        </span>\n                    </span>\n                    <p class=\"mt-3 text-center text-[12px] text-[var(--muted-foreground)]\" data-kid=\"1-1-7-1-1-2\" data-name=\"diagram label 0 percent\">\n                        <span class=\"font-semibold text-[var(--foreground)]\" data-kid=\"1-1-7-1-1-2-1\" data-name=\"diagram percent label 0\">\n                            0%\n                        </span>\n                        · scaleY(0)\n                    </p>\n                </div>\n                <div data-kid=\"1-1-7-1-2\" data-name=\"diagram unit 55 percent\">\n                    <span class=\"dl-x3\" data-kid=\"1-1-7-1-2-1\" data-name=\"scaled-up download pill\">\n                        <span class=\"dl-x3__fill\" data-kid=\"1-1-7-1-2-1-1\" data-name=\"diagram fill 55\" style=\"transform: scaleY(0.55)\">\n                        </span>\n                        <span data-kid=\"1-1-7-1-2-1-2\">\n                            Download CV\n                        </span>\n                        <span class=\"relative block h-[3.75rem] w-[2.625rem] overflow-hidden\" data-kid=\"1-1-7-1-2-1-3\">\n                            <svg class=\"absolute top-[9px] left-0 size-[2.625rem]\" data-kid=\"1-1-7-1-2-1-3-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                <path d=\"M12 17V3\">\n                                </path>\n                                <path d=\"m6 11 6 6 6-6\">\n                                </path>\n                                <path d=\"M19 21H5\">\n                                </path>\n                            </svg>\n                        </span>\n                        <span class=\"dl-x3__tray\" data-kid=\"1-1-7-1-2-1-4\">\n                        </span>\n                    </span>\n                    <p class=\"mt-3 text-center text-[12px] text-[var(--muted-foreground)]\" data-kid=\"1-1-7-1-2-2\" data-name=\"diagram label 55 percent\">\n                        <span class=\"font-semibold text-[var(--foreground)]\" data-kid=\"1-1-7-1-2-2-1\" data-name=\"diagram percent label 55\">\n                            55%\n                        </span>\n                        ·\n\t\t\t\t\t\tscaleY(0.55)\n                    </p>\n                </div>\n                <div data-kid=\"1-1-7-1-3\" data-name=\"diagram unit 100 percent\">\n                    <span class=\"dl-x3\" data-kid=\"1-1-7-1-3-1\" data-name=\"scaled-up download pill\">\n                        <span class=\"dl-x3__fill\" data-kid=\"1-1-7-1-3-1-1\" data-name=\"diagram fill 100\" style=\"transform: scaleY(1)\">\n                        </span>\n                        <span data-kid=\"1-1-7-1-3-1-2\">\n                            Download CV\n                        </span>\n                        <span class=\"relative block h-[3.75rem] w-[2.625rem] overflow-hidden\" data-kid=\"1-1-7-1-3-1-3\">\n                            <svg class=\"absolute top-[15px] left-0 size-[2.625rem]\" data-kid=\"1-1-7-1-3-1-3-1\" data-name=\"download arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                <path d=\"M12 17V3\">\n                                </path>\n                                <path d=\"m6 11 6 6 6-6\">\n                                </path>\n                                <path d=\"M19 21H5\">\n                                </path>\n                            </svg>\n                        </span>\n                        <span class=\"dl-x3__tray\" data-kid=\"1-1-7-1-3-1-4\">\n                        </span>\n                    </span>\n                    <p class=\"mt-3 text-center text-[12px] text-[var(--muted-foreground)]\" data-kid=\"1-1-7-1-3-2\" data-name=\"diagram label 100 percent\">\n                        <span class=\"font-semibold text-[var(--foreground)]\" data-kid=\"1-1-7-1-3-2-1\" data-name=\"diagram percent label 100\">\n                            100%\n                        </span>\n                        · scaleY(1)\n\t\t\t\t\t\t· arrow at +2px\n                    </p>\n                </div>\n                <div class=\"min-w-[280px] flex-1 pb-6\" data-kid=\"1-1-7-1-4\" data-name=\"mechanic explanation\">\n                    <p class=\"lbl mb-3\" data-kid=\"1-1-7-1-4-1\" data-name=\"mechanic explanation title\">\n                        Why it cannot reflow\n                    </p>\n                    <p class=\"code text-[var(--muted-foreground)]\" data-kid=\"1-1-7-1-4-2\" data-name=\"mechanic code list\">\n                        fill: position absolute · inset-0 · z-index -1\n                        <br data-kid=\"1-1-7-1-4-2-1\"/>\n                        → out of flow, clipped by overflow-hidden\n                        <br data-kid=\"1-1-7-1-4-2-2\"/>\n                        tray: position absolute · inset-x-2.5 · bottom-7px\n                        <br data-kid=\"1-1-7-1-4-2-3\"/>\n                        → colour + box-shadow only, never size\n                        <br data-kid=\"1-1-7-1-4-2-4\"/>\n                        icon: fixed 14×20px slot, overflow-hidden\n                        <br data-kid=\"1-1-7-1-4-2-5\"/>\n                        → 2px travel stays inside the reserved box\n                        <br data-kid=\"1-1-7-1-4-2-6\"/>\n                        ring: box-shadow, painted outside the border box\n                    </p>\n                    <p class=\"mt-4 text-[12px] leading-relaxed text-[var(--muted-foreground)]\" data-kid=\"1-1-7-1-4-3\" data-name=\"mechanic text explanation\">\n                        Timing tokens:\n                        <span class=\"code\" data-kid=\"1-1-7-1-4-3-1\">\n                            380ms\n                        </span>\n                        fill ·\n                        <span class=\"code\" data-kid=\"1-1-7-1-4-3-2\">\n                            460ms\n                        </span>\n                        icon settle ·\n                        <span class=\"code\" data-kid=\"1-1-7-1-4-3-3\">\n                            cubic-bezier(0.16, 1, 0.3, 1)\n                        </span>\n                        — the same easing the\n\t\t\t\t\t\tgrid card already uses for its hover glow. Register\n                        <span class=\"code\" data-kid=\"1-1-7-1-4-3-4\">\n                            --animate-dl-settle\n                        </span>\n                        in the existing\n                        <span class=\"code\" data-kid=\"1-1-7-1-4-3-5\">\n                            @theme\n                        </span>\n                        block in\n                        <span class=\"code\" data-kid=\"1-1-7-1-4-3-6\">\n                            app/globals.css\n                        </span>\n                        alongside the other keyframes.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </div>\n    <!-- ══════════════════ LIGHT HALF ══════════════════ -->\n    <div class=\"bg-[var(--background)] px-14 pt-12 pb-16 text-[var(--foreground)]\" data-kid=\"1-2\" data-name=\"light theme section container\">\n        <div class=\"mb-10 flex items-end justify-between gap-8 border-b border-[var(--border)] pb-6\" data-kid=\"1-2-1\" data-name=\"light header container\">\n            <div data-kid=\"1-2-1-1\" data-name=\"light header title group\">\n                <p class=\"lbl mb-2\" data-kid=\"1-2-1-1-1\" data-name=\"light header label\">\n                    Same control, same tokens\n                </p>\n                <h2 class=\"text-[22px] leading-tight font-semibold tracking-tight\" data-kid=\"1-2-1-1-2\" data-name=\"light header title\">\n                    Light mode\n                </h2>\n            </div>\n            <p class=\"code max-w-sm shrink-0 text-right text-[var(--muted-foreground)]\" data-kid=\"1-2-1-2\" data-name=\"light header timing info\">\n                accent 14% fill · accent 50% border\n                <br data-kid=\"1-2-1-2-1\" data-name=\"light header break\"/>\n                accent 55% ring · offset on --card\n            </p>\n        </div>\n        <p class=\"lbl mb-4\" data-kid=\"1-2-2\" data-name=\"light context section label\">\n            04 — In context · live, hover the control\n        </p>\n        <div class=\"mb-14 flex flex-wrap items-start gap-10\" data-kid=\"1-2-3\" data-name=\"light preview section\">\n            <div class=\"grid h-[288px] w-[583px] shrink-0 grid-cols-[minmax(0,2fr)_minmax(0,3fr)] overflow-hidden rounded-[2rem] bg-[var(--card)] text-[var(--card-foreground)]\" data-kid=\"1-2-3-1\">\n                <div class=\"flex min-h-0 min-w-0 items-center justify-center border-r border-[var(--border)] p-5\" data-kid=\"1-2-3-1-1\">\n                    <div class=\"relative aspect-3/4 h-full max-w-[17.5rem] overflow-hidden rounded-2xl bg-[var(--muted)]\" data-kid=\"1-2-3-1-1-1\">\n                        <img alt=\"Gonzalo Pozo, Full Stack Developer\" class=\"size-full object-cover grayscale\" data-kid=\"1-2-3-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/cv_pic.png\"/>\n                    </div>\n                </div>\n                <div class=\"grid min-h-0 min-w-0 grid-rows-[auto_minmax(0,1fr)_auto] gap-3 p-5\" data-kid=\"1-2-3-1-2\">\n                    <div class=\"flex min-w-0 flex-wrap items-center justify-between gap-x-2 gap-y-3\" data-kid=\"1-2-3-1-2-1\">\n                        <span class=\"min-w-0 truncate text-xs font-semibold text-[var(--muted-foreground)]\" data-kid=\"1-2-3-1-2-1-1\">\n                            Full Stack Developer\n                        </span>\n                        <a aria-label=\"Download CV\" class=\"dl -mr-1\" data-kid=\"1-2-3-1-2-1-2\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            <span aria-hidden=\"true\" class=\"dl__fill\" data-kid=\"1-2-3-1-2-1-2-1\">\n                            </span>\n                            <span data-kid=\"1-2-3-1-2-1-2-2\">\n                                Download CV\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl__slot\" data-kid=\"1-2-3-1-2-1-2-3\">\n                                <svg class=\"dl__icon\" data-kid=\"1-2-3-1-2-1-2-3-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl__tray\" data-kid=\"1-2-3-1-2-1-2-4\">\n                            </span>\n                        </a>\n                        <div class=\"flex max-h-16 min-w-0 basis-full items-start gap-2.5 rounded-xl border px-3 py-2 text-xs/relaxed font-semibold\" data-kid=\"1-2-3-1-2-1-3\" style=\"\n\t\t\t\t\t\t\t\tborder-color: var(--status-border);\n\t\t\t\t\t\t\t\tbackground: var(--status-bg);\n\t\t\t\t\t\t\t\tcolor: var(--foreground);\n\t\t\t\t\t\t\t\">\n                            <span aria-hidden=\"true\" class=\"mt-1 size-2 shrink-0 rounded-full bg-[var(--status-active)] motion-safe:animate-pulse\" data-kid=\"1-2-3-1-2-1-3-1\">\n                            </span>\n                            <span class=\"min-w-0\" data-kid=\"1-2-3-1-2-1-3-2\">\n                                Actualmente buscando empleo\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"flex min-h-0 min-w-0 flex-col justify-center gap-2 overflow-hidden\" data-kid=\"1-2-3-1-2-2\">\n                        <h1 class=\"text-2xl/tight font-bold tracking-tight text-[var(--foreground)]\" data-kid=\"1-2-3-1-2-2-1\">\n                            Hey, I'm Gonzalo.\n                        </h1>\n                        <p class=\"line-clamp-3 max-w-md text-sm/relaxed text-[var(--muted-foreground)]\" data-kid=\"1-2-3-1-2-2-2\">\n                            I love turning ideas into real products people can use. I care about\n\t\t\t\t\t\t\tthoughtful interfaces, solid backend foundations, and the kind of\n\t\t\t\t\t\t\tcurious, collaborative work that keeps improving the product, the code,\n\t\t\t\t\t\t\tand the people building it.\n                        </p>\n                    </div>\n                    <div class=\"flex min-w-0 justify-end\" data-kid=\"1-2-3-1-2-3\">\n                        <a class=\"inline-flex min-h-11 items-center gap-2 rounded-full bg-[var(--primary)] px-5 text-sm font-medium text-[var(--primary-foreground)] no-underline\" data-kid=\"1-2-3-1-2-3-1\" href=\"#\">\n                            About Me\n                            <svg aria-hidden=\"true\" class=\"size-4\" data-kid=\"1-2-3-1-2-3-1-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n                                <path d=\"M5 12h14\">\n                                </path>\n                                <path d=\"m12 5 7 7-7 7\">\n                                </path>\n                            </svg>\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"min-w-[300px] flex-1 rounded-2xl bg-[var(--card)] p-7\" data-kid=\"1-2-3-2\" data-name=\"light state matrix container\">\n                <p class=\"lbl mb-4\" data-kid=\"1-2-3-2-1\" data-name=\"light state matrix label\">\n                    State matrix · light\n                </p>\n                <div class=\"flex items-start gap-7\" data-kid=\"1-2-3-2-2\" data-name=\"light state matrix grid\">\n                    <div class=\"relative w-max shrink-0\" data-kid=\"1-2-3-2-2-1\" data-name=\"light state preview column\">\n                        <span class=\"guide\" data-kid=\"1-2-3-2-2-1-1\" style=\"left: 0\">\n                        </span>\n                        <span class=\"guide\" data-kid=\"1-2-3-2-2-1-2\" style=\"right: 0\">\n                        </span>\n                        <div class=\"flex w-max flex-col gap-3\" data-kid=\"1-2-3-2-2-1-3\">\n                            <a aria-label=\"Download CV\" class=\"dl\" data-kid=\"1-2-3-2-2-1-3-1\" href=\"#\">\n                                <span aria-hidden=\"true\" class=\"dl__fill\" data-kid=\"1-2-3-2-2-1-3-1-1\">\n                                </span>\n                                <span data-kid=\"1-2-3-2-2-1-3-1-2\">\n                                    Download CV\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl__slot\" data-kid=\"1-2-3-2-2-1-3-1-3\">\n                                    <svg class=\"dl__icon\" data-kid=\"1-2-3-2-2-1-3-1-3-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                        <path d=\"M12 17V3\">\n                                        </path>\n                                        <path d=\"m6 11 6 6 6-6\">\n                                        </path>\n                                        <path d=\"M19 21H5\">\n                                        </path>\n                                    </svg>\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl__tray\" data-kid=\"1-2-3-2-2-1-3-1-4\">\n                                </span>\n                            </a>\n                            <a aria-label=\"Download CV\" class=\"dl\" data-kid=\"1-2-3-2-2-1-3-2\" data-state=\"hover\" href=\"#\">\n                                <span aria-hidden=\"true\" class=\"dl__fill\" data-kid=\"1-2-3-2-2-1-3-2-1\">\n                                </span>\n                                <span data-kid=\"1-2-3-2-2-1-3-2-2\">\n                                    Download CV\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl__slot\" data-kid=\"1-2-3-2-2-1-3-2-3\">\n                                    <svg class=\"dl__icon\" data-kid=\"1-2-3-2-2-1-3-2-3-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                        <path d=\"M12 17V3\">\n                                        </path>\n                                        <path d=\"m6 11 6 6 6-6\">\n                                        </path>\n                                        <path d=\"M19 21H5\">\n                                        </path>\n                                    </svg>\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl__tray\" data-kid=\"1-2-3-2-2-1-3-2-4\">\n                                </span>\n                            </a>\n                            <a aria-label=\"Download CV\" class=\"dl\" data-kid=\"1-2-3-2-2-1-3-3\" data-state=\"focus\" href=\"#\">\n                                <span aria-hidden=\"true\" class=\"dl__fill\" data-kid=\"1-2-3-2-2-1-3-3-1\">\n                                </span>\n                                <span data-kid=\"1-2-3-2-2-1-3-3-2\">\n                                    Download CV\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl__slot\" data-kid=\"1-2-3-2-2-1-3-3-3\">\n                                    <svg class=\"dl__icon\" data-kid=\"1-2-3-2-2-1-3-3-3-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                        <path d=\"M12 17V3\">\n                                        </path>\n                                        <path d=\"m6 11 6 6 6-6\">\n                                        </path>\n                                        <path d=\"M19 21H5\">\n                                        </path>\n                                    </svg>\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl__tray\" data-kid=\"1-2-3-2-2-1-3-3-4\">\n                                </span>\n                            </a>\n                            <a aria-label=\"Download CV\" class=\"dl\" data-kid=\"1-2-3-2-2-1-3-4\" data-state=\"active\" href=\"#\">\n                                <span aria-hidden=\"true\" class=\"dl__fill\" data-kid=\"1-2-3-2-2-1-3-4-1\">\n                                </span>\n                                <span data-kid=\"1-2-3-2-2-1-3-4-2\">\n                                    Download CV\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl__slot\" data-kid=\"1-2-3-2-2-1-3-4-3\">\n                                    <svg class=\"dl__icon\" data-kid=\"1-2-3-2-2-1-3-4-3-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                        <path d=\"M12 17V3\">\n                                        </path>\n                                        <path d=\"m6 11 6 6 6-6\">\n                                        </path>\n                                        <path d=\"M19 21H5\">\n                                        </path>\n                                    </svg>\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl__tray\" data-kid=\"1-2-3-2-2-1-3-4-4\">\n                                </span>\n                            </a>\n                            <a aria-label=\"Download CV\" class=\"dl\" data-kid=\"1-2-3-2-2-1-3-5\" data-state=\"reduced\" href=\"#\">\n                                <span aria-hidden=\"true\" class=\"dl__fill\" data-kid=\"1-2-3-2-2-1-3-5-1\">\n                                </span>\n                                <span data-kid=\"1-2-3-2-2-1-3-5-2\">\n                                    Download CV\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl__slot\" data-kid=\"1-2-3-2-2-1-3-5-3\">\n                                    <svg class=\"dl__icon\" data-kid=\"1-2-3-2-2-1-3-5-3-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                        <path d=\"M12 17V3\">\n                                        </path>\n                                        <path d=\"m6 11 6 6 6-6\">\n                                        </path>\n                                        <path d=\"M19 21H5\">\n                                        </path>\n                                    </svg>\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl__tray\" data-kid=\"1-2-3-2-2-1-3-5-4\">\n                                </span>\n                            </a>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-col gap-3 pt-px text-[12px]\" data-kid=\"1-2-3-2-2-2\" data-name=\"light state description column\">\n                        <p class=\"flex h-11 items-center font-semibold\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"light rest label\">\n                            Rest\n                        </p>\n                        <p class=\"flex h-11 items-center font-semibold\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"light hover label\">\n                            Hover\n                        </p>\n                        <p class=\"flex h-11 items-center font-semibold\" data-kid=\"1-2-3-2-2-2-3\" data-name=\"light focus label\">\n                            Focus-visible\n                        </p>\n                        <p class=\"flex h-11 items-center font-semibold\" data-kid=\"1-2-3-2-2-2-4\" data-name=\"light active label\">\n                            Active\n                        </p>\n                        <p class=\"flex h-11 items-center font-semibold\" data-kid=\"1-2-3-2-2-2-5\" data-name=\"light reduced label\">\n                            Reduced motion\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- ── responsive proof ── -->\n        <p class=\"lbl mb-4\" data-kid=\"1-2-4\" data-name=\"light responsive label\">\n            05 — Responsive proof · header row at narrow widths\n        </p>\n        <div class=\"flex flex-wrap items-start gap-7\" data-kid=\"1-2-5\" data-name=\"light responsive container\">\n            <div data-kid=\"1-2-5-1\">\n                <div class=\"w-[375px] rounded-2xl bg-[var(--card)] p-4\" data-kid=\"1-2-5-1-1\">\n                    <div class=\"flex min-w-0 flex-wrap items-center justify-between gap-x-2 gap-y-3\" data-kid=\"1-2-5-1-1-1\">\n                        <span class=\"min-w-0 truncate text-xs font-semibold text-[var(--muted-foreground)]\" data-kid=\"1-2-5-1-1-1-1\">\n                            Full Stack Developer\n                        </span>\n                        <a aria-label=\"Download CV\" class=\"dl -mr-1\" data-kid=\"1-2-5-1-1-1-2\" href=\"#\">\n                            <span aria-hidden=\"true\" class=\"dl__fill\" data-kid=\"1-2-5-1-1-1-2-1\">\n                            </span>\n                            <span data-kid=\"1-2-5-1-1-1-2-2\">\n                                Download CV\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl__slot\" data-kid=\"1-2-5-1-1-1-2-3\">\n                                <svg class=\"dl__icon\" data-kid=\"1-2-5-1-1-1-2-3-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl__tray\" data-kid=\"1-2-5-1-1-1-2-4\">\n                            </span>\n                        </a>\n                    </div>\n                </div>\n                <p class=\"mt-2.5 text-[11.5px] text-[var(--muted-foreground)]\" data-kid=\"1-2-5-1-2\">\n                    375px · single row, label intact\n                </p>\n            </div>\n            <div data-kid=\"1-2-5-2\">\n                <div class=\"w-[320px] rounded-2xl bg-[var(--card)] p-4\" data-kid=\"1-2-5-2-1\">\n                    <div class=\"flex min-w-0 flex-wrap items-center justify-between gap-x-2 gap-y-3\" data-kid=\"1-2-5-2-1-1\">\n                        <span class=\"min-w-0 truncate text-xs font-semibold text-[var(--muted-foreground)]\" data-kid=\"1-2-5-2-1-1-1\">\n                            Full Stack Developer\n                        </span>\n                        <a aria-label=\"Download CV\" class=\"dl -mr-1\" data-kid=\"1-2-5-2-1-1-2\" href=\"#\">\n                            <span aria-hidden=\"true\" class=\"dl__fill\" data-kid=\"1-2-5-2-1-1-2-1\">\n                            </span>\n                            <span data-kid=\"1-2-5-2-1-1-2-2\">\n                                Download CV\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl__slot\" data-kid=\"1-2-5-2-1-1-2-3\">\n                                <svg class=\"dl__icon\" data-kid=\"1-2-5-2-1-1-2-3-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl__tray\" data-kid=\"1-2-5-2-1-1-2-4\">\n                            </span>\n                        </a>\n                    </div>\n                </div>\n                <p class=\"mt-2.5 text-[11.5px] text-[var(--muted-foreground)]\" data-kid=\"1-2-5-2-2\">\n                    320px · still one row, 44px tall\n                </p>\n            </div>\n            <div data-kid=\"1-2-5-3\">\n                <div class=\"w-[240px] rounded-2xl bg-[var(--card)] p-4\" data-kid=\"1-2-5-3-1\">\n                    <div class=\"flex min-w-0 flex-wrap items-center justify-between gap-x-2 gap-y-3\" data-kid=\"1-2-5-3-1-1\">\n                        <span class=\"min-w-0 truncate text-xs font-semibold text-[var(--muted-foreground)]\" data-kid=\"1-2-5-3-1-1-1\">\n                            Full Stack Developer\n                        </span>\n                        <a aria-label=\"Download CV\" class=\"dl -mr-1\" data-kid=\"1-2-5-3-1-1-2\" href=\"#\">\n                            <span aria-hidden=\"true\" class=\"dl__fill\" data-kid=\"1-2-5-3-1-1-2-1\">\n                            </span>\n                            <span data-kid=\"1-2-5-3-1-1-2-2\">\n                                Download CV\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl__slot\" data-kid=\"1-2-5-3-1-1-2-3\">\n                                <svg class=\"dl__icon\" data-kid=\"1-2-5-3-1-1-2-3-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl__tray\" data-kid=\"1-2-5-3-1-1-2-4\">\n                            </span>\n                        </a>\n                    </div>\n                </div>\n                <p class=\"mt-2.5 text-[11.5px] text-[var(--muted-foreground)]\" data-kid=\"1-2-5-3-2\">\n                    240px · wraps to its own line, never truncates\n                </p>\n            </div>\n            <div class=\"min-w-[260px] flex-1 pt-1\" data-kid=\"1-2-5-4\" data-name=\"light preserved explanation\">\n                <p class=\"lbl mb-3\" data-kid=\"1-2-5-4-1\" data-name=\"light preserved title\">\n                    Preserved\n                </p>\n                <p class=\"text-[12.5px] leading-relaxed text-[var(--muted-foreground)]\" data-kid=\"1-2-5-4-2\" data-name=\"light preserved text\">\n                    Conditional render on\n                    <span class=\"code\" data-kid=\"1-2-5-4-2-1\" data-name=\"preserved code 1\">\n                        resumeUrl\n                    </span>\n                    ,\n                    <span class=\"code\" data-kid=\"1-2-5-4-2-2\" data-name=\"preserved code 2\">\n                        target=\"_blank\"\n                    </span>\n                    ,\n                    <span class=\"code\" data-kid=\"1-2-5-4-2-3\" data-name=\"preserved code 3\">\n                        rel=\"noopener noreferrer\"\n                    </span>\n                    ,\n                    <span class=\"code\" data-kid=\"1-2-5-4-2-4\" data-name=\"preserved code 4\">\n                        aria-label=\"Download CV\"\n                    </span>\n                    , icon\n                    <span class=\"code\" data-kid=\"1-2-5-4-2-5\" data-name=\"preserved code 5\">\n                        aria-hidden\n                    </span>\n                    , visible text label, 44px touch target.\n\t\t\t\t\tNo new dependencies — CSS and Tailwind only.\n                </p>\n            </div>\n        </div>\n    </div>\n</div>\n",
