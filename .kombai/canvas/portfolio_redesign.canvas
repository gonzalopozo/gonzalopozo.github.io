us</p>\n\t\t\t\t</div><div data-kid=\"151\" class=\"state-cell\">\n\t\t\t\t\t<a data-kid=\"152\" class=\"dl dl--compact\" data-state=\"active\" aria-label=\"Download CV\" href=\"#download-cv\" target=\"_blank\" rel=\"noopener noreferrer\">\n\t\t\t<span data-kid=\"153\" class=\"dl__surface\" aria-hidden=\"true\"></span>\n\t\t\t<span data-kid=\"154\" class=\"dl__label\">Download CV</span>\n\t\t\t<span data-kid=\"155\" class=\"dl__slot\" aria-hidden=\"true\">\n\t\t\t\t<svg data-kid=\"156\" class=\"dl__icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n\t<path data-kid=\"157\" d=\"M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z\"></path>\n\t<path data-kid=\"158\" d=\"M14 2v6h6\"></path>\n\t<path data-kid=\"159\" d=\"M8 13h8\"></path>\n\t<path data-kid=\"160\" d=\"M8 17h5\"></path>\n</svg>\n\t\t\t\t<span data-kid=\"161\" class=\"dl__tray\"></span>\n\t\t\t</span>\n\t\t\t<span data-kid=\"162\" class=\"dl__baseline\" aria-hidden=\"true\"></span>\n\t\t</a>\n\t\t\t\t\t<p data-kid=\"163\" class=\"state-name\">Pressed</p>\n\t\t\t\t</div><div data-kid=\"164\" class=\"state-cell\">\n\t\t\t\t\t<a data-kid=\"165\" class=\"dl dl--compact\" data-state=\"reduced\" aria-label=\"Download CV\" href=\"#download-cv\" target=\"_blank\" rel=\"noopener noreferrer\">\n\t\t\t<span data-kid=\"166\" class=\"dl__surface\" aria-hidden=\"true\"></span>\n\t\t\t<span data-kid=\"167\" class=\"dl__label\">Download CV</span>\n\t\t\t<span data-kid=\"168\" class=\"dl__slot\" aria-hidden=\"true\">\n\t\t\t\t<svg data-kid=\"169\" class=\"dl__icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n\t<path data-kid=\"170\" d=\"M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z\"></path>\n\t<path data-kid=\"171\" d=\"M14 2v6h6\"></path>\n\t<path data-kid=\"172\" d=\"M8 13h8\"></path>\n\t<path data-kid=\"173\" d=\"M8 17h5\"></path>\n</svg>\n\t\t\t\t<span data-kid=\"174\" class=\"dl__tray\"