      "modified": "2026-07-23T12:07:39.730896+00:00",
      "id": "var_97ad88183d63"
    },
    "var_ca81bf0dd8f0": {
      "type": "variant",
      "label": "Editorial B: Minimal Float",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<div class=\"min-h-screen bg-(--background) p-12 font-sans text-(--foreground) flex items-center justify-center\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Layout Imports -->\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n    </style>\n    <div class=\"relative w-full max-w-5xl\" data-kid=\"1-1\" data-name=\"layout centering wrapper\">\n        <!-- Main Card -->\n        <div class=\"bg-(--card) rounded-4xl border border-(--border)/50 p-12 shadow-[0_32px_64px_-16px_rgba(0,0,0,0.08)] grid grid-cols-1 md:grid-cols-[0.8fr_1.2fr] gap-16 items-center\" data-kid=\"1-1-1\" data-name=\"main content card\">\n            <!-- Image Column (40%) -->\n            <div class=\"relative group\" data-kid=\"1-1-1-1\" data-name=\"profile image column container\">\n                <!-- Floating Image Wrapper -->\n                <div class=\"relative z-10 -ml-16 -mt-16 md:-ml-20 md:-mt-20 lg:-ml-24 lg:-mt-24 transition-transform duration-500 ease-out group-hover:scale-[1.02]\" data-kid=\"1-1-1-1-1\" data-name=\"floating image perspective container\">\n                    <!-- Glowing Ring (Status) -->\n                    <div class=\"absolute -inset-2 rounded-[2.5rem] bg-gradient-to-br from-(--status-active) to-(--primary)/20 opacity-20 blur-xl animate-pulse\" data-kid=\"1-1-1-1-1-1\" data-name=\"pulsing glow effect background\">\n                    </div>\n                    <!-- Image -->\n                    <div class=\"relative aspect-[3/4] w-full max-w-sm rounded-[2rem] overflow-hidden border-4 border-(--card) shadow-2xl\" data-kid=\"1-1-1-1-1-2\" data-name=\"image and status pill container\">\n                        <img alt=\"Gonzalo Pozo\" class=\"w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700\" data-kid=\"1-1-1-1-1-2-1\" data-name=\"profile portrait image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/cv_pic.png\"/>\n                        <!-- Status Pill (Floating) -->\n                        <div class=\"absolute bottom-6 left-6 bg-(--card)/90 backdrop-blur-md px-4 py-2 rounded-full flex items-center gap-2 border border-(--border)/20 shadow-lg\" data-kid=\"1-1-1-1-1-2-2\" data-name=\"floating status pill container\">\n                            <span class=\"relative flex size-2.5\" data-kid=\"1-1-1-1-1-2-2-1\" data-name=\"status ping indicator container\">\n                                <span class=\"absolute inline-flex h-full w-full animate-ping rounded-full bg-(--status-active) opacity-75\" data-kid=\"1-1-1-1-1-2-2-1-1\" data-name=\"ping ripple animation\">\n                                </span>\n                                <span class=\"relative inline-flex size-2.5 rounded-full bg-(--status-active)\" data-kid=\"1-1-1-1-1-2-2-1-2\" data-name=\"status active dot\">\n                                </span>\n                            </span>\n                            <span class=\"text-[10px] font-bold tracking-widest uppercase text-(--muted-foreground)\" data-kid=\"1-1-1-1-1-2-2-2\" data-name=\"status text label\">\n                                Working\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <!-- Background Motif (Optional shadow/depth element) -->\n                <div class=\"absolute inset-0 bg-(--secondary) rounded-[2.5rem] -z-0 translate-x-4 translate-y-4 opacity-50\" data-kid=\"1-1-1-1-2\" data-name=\"background depth accent rectangle\">\n                </div>\n            </div>\n            <!-- Content Column (60%) -->\n            <div class=\"flex flex-col gap-10\" data-kid=\"1-1-1-2\" data-name=\"bio content column container\">\n                <!-- Top Metadata -->\n                <div class=\"flex items-center justify-between\" data-kid=\"1-1-1-2-1\" data-name=\"header metadata area\">\n                    <span class=\"text-[10px] font-bold tracking-[0.2em] uppercase text-(--primary) opacity-70\" data-kid=\"1-1-1-2-1-1\" data-name=\"introduction label text\">\n                        Introduction\n                    </span>\n                    <a class=\"flex items-center gap-2 text-xs font-semibold text-(--muted-foreground) hover:text-(--primary) transition-colors group/cv\" data-kid=\"1-1-1-2-1-2\" data-name=\"resume download link\" href=\"#\">\n                        <svg class=\"transition-transform group-hover/cv:-translate-y-0.5\" data-kid=\"1-1-1-2-1-2-1\" data-name=\"download icon\" fill=\"none\" height=\"16\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"16\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\">\n                            </path>\n                            <polyline points=\"7 10 12 15 17 10\">\n                            </polyline>\n                            <line x1=\"12\" x2=\"12\" y1=\"15\" y2=\"3\">\n                            </line>\n                        </svg>\n                        <span class=\"border-b border-transparent group-hover:border-(--primary)/30 pb-0.5\" data-kid=\"1-1-1-2-1-2-2\" data-name=\"resume link text\">\n                            Resume / CV\n                        </span>\n                    </a>\n                </div>\n                <!-- Bio -->\n                <div class=\"space-y-6\" data-kid=\"1-1-1-2-2\" data-name=\"bio section\">\n                    <h1 class=\"text-5xl md:text-6xl font-extrabold tracking-tight text-(--foreground) leading-[1.1]\" data-kid=\"1-1-1-2-2-1\" data-name=\"main greeting headline\">\n                        Hey, I'm\n                        <span class=\"text-(--primary) relative inline-block\" data-kid=\"1-1-1-2-2-1-1\" data-name=\"name highlight container\">\n                            Gonzalo\n                            <span class=\"absolute -bottom-2 left-0 w-full h-1.5 bg-(--primary)/10 -rotate-1\" data-kid=\"1-1-1-2-2-1-1-1\" data-name=\"name underline decoration\">\n                            </span>\n                        </span>\n                    </h1>\n                    <p class=\"text-lg md:text-xl text-(--muted-foreground) leading-relaxed max-w-md\" data-kid=\"1-1-1-2-2-2\" data-name=\"bio body text\">\n                        A full-stack developer from Madrid who loves turning ideas into real products. I care about\n                        <span class=\"text-(--foreground) font-medium underline decoration-(--primary)/20 decoration-2 underline-offset-4\" data-kid=\"1-1-1-2-2-2-1\" data-name=\"highlighted emphasis text\">\n                            thoughtful interfaces\n                        </span>\n                        , solid foundations, and curious collaboration.\n                    </p>\n                </div>\n                <!-- Actions -->\n                <div class=\"pt-4\" data-kid=\"1-1-1-2-3\" data-name=\"actions container\">\n                    <button class=\"group/btn relative flex items-center gap-6 text-sm font-bold tracking-widest uppercase\" data-kid=\"1-1-1-2-3-1\" data-name=\"call-to-action button\">\n                        <span class=\"relative z-10 transition-colors group-hover/btn:text-(--primary)\" data-kid=\"1-1-1-2-3-1-1\" data-name=\"action button text\">\n                            Explore my story\n                        </span>\n                        <div class=\"relative flex items-center justify-center size-14 rounded-full bg-(--secondary) transition-all duration-500 group-hover/btn:bg-(--primary) group-hover/btn:scale-110 group-hover/btn:shadow-xl group-hover/btn:shadow-(--primary)/20\" data-kid=\"1-1-1-2-3-1-2\" data-name=\"action button icon container\">\n                            <svg class=\"transition-all duration-500 group-hover/btn:translate-x-1 group-hover/btn:text-white\" data-kid=\"1-1-1-2-3-1-2-1\" data-name=\"arrow icon\" fill=\"none\" height=\"20\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" width=\"20\" xmlns=\"http://www.w3.org/2000/svg\">\n                                <line x1=\"5\" x2=\"19\" y1=\"12\" y2=\"12\">\n                                </line>\n                                <polyline points=\"12 5 19 12 12 19\">\n                                </polyline>\n                            </svg>\n                        </div>\n                        <!-- Progress Line -->\n                        <div class=\"absolute bottom-0 left-0 h-0.5 w-0 bg-(--primary) transition-all duration-700 group-hover/btn:w-full\" data-kid=\"1-1-1-2-3-1-3\" data-name=\"button underline progress element\">\n                        </div>\n                    </button>\n                </div>\n            </div>\n        </div>\n        <!-- Background Decoration -->\n        <div class=\"absolute -top-20 -right-20 size-64 bg-(--primary)/5 rounded-full blur-3xl -z-10\" data-kid=\"1-1-2\" data-name=\"top right blurred background orb\">\n        </div>\n        <div class=\"absolute -bottom-20 -left-20 size-96 bg-(--accent)/5 rounded-full blur-3xl -z-10\" data-kid=\"1-1-3\" data-name=\"bottom left blurred background orb\">\n        </div>\n    </div>\n</div>\n",
      "comments": [],
      "created": "2026-07-23T12:07:29.135869+00:00",
      "modified": "2026-07-23T12:07:42.573120+00:00",
      "id": "var_ca81bf0dd8f0"
    },
    "var_6ab1bb0440b1": {
      "type": "variant",
      "label": "Download CV A — Masked Slot Descent",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4140,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap');\n\n.sheet {\n\tfont-family: 'Geist', ui-sans-serif, system-ui, sans-serif;\n\n\t--background: oklch(0.975 0.008 270);\n\t--foreground: oklch(0.155 0.025 270);\n\t--card: oklch(1 0 0);\n\t--card-foreground: oklch(0.155 0.025 270);\n\t--primary: oklch(0.4 0.17 250);\n\t--primary-foreground: oklch(0.985 0.005 250);\n\t--secondary: oklch(0.945 0.012 270);\n\t--secondary-foreground: oklch(0.195 0.025 270);\n\t--muted: oklch(0.92 0.008 270);\n\t--muted-foreground: oklch(0.43 0.02 265);\n\t--accent: oklch(0.7 0.18 55);\n\t--accent-foreground: oklch(0.2 0.05 55);\n\t--border: oklch(0.885 0.012 270);\n\t--ring: oklch(0.48 0.17 250);\n\t--status-active: oklch(0.52 0.175 155);\n}\n\n.dark {\n\t--background: oklch(0.12 0.025 275);\n\t--foreground: oklch(0.95 0.008 265);\n\t--card: oklch(0.175 0.022 270);\n\t--card-foreground: oklch(0.95 0.008 265);\n\t--primary: oklch(0.75 0.17 235);\n\t--primary-foreground: oklch(0.12 0.035 235);\n\t--secondary: oklch(0.225 0.018 275);\n\t--secondary-foreground: oklch(0.91 0.008 265);\n\t--muted: oklch(0.225 0.018 275);\n\t--muted-foreground: oklch(0.58 0.016 265);\n\t--accent: oklch(0.8 0.17 50);\n\t--accent-foreground: oklch(0.12 0.045 50);\n\t--border: oklch(0.265 0.018 275);\n\t--ring: oklch(0.75 0.17 235);\n\t--status-active: oklch(0.7 0.175 155);\n}\n\n/* ============================================================\n   THE CONTROL — variant A: masked slot descent\n   Outer <a> geometry is frozen: no transform, and padding / gap /\n   font-size / border-width / width / height never change.\n   Only surface, border-color, text-color, tray and the icons move.\n   ============================================================ */\n.dl {\n\tposition: relative;\n\tdisplay: inline-flex;\n\tflex-shrink: 0;\n\talign-items: center;\n\tgap: 0.375rem;\n\tmin-height: 2.75rem;\n\tpadding-inline: 0.75rem;\n\tborder: 1px solid color-mix(in oklch, var(--border) 80%, transparent);\n\tborder-radius: 9999px;\n\toverflow: hidden;\n\tfont-size: 0.75rem;\n\tline-height: 1rem;\n\tfont-weight: 600;\n\tletter-spacing: 0.025em;\n\ttext-decoration: none;\n\twhite-space: nowrap;\n\tcolor: var(--muted-foreground);\n\tbackground-color: color-mix(in oklch, var(--secondary) 45%, transparent);\n\toutline: none;\n\ttransition:\n\t\tbackground-color 320ms cubic-bezier(0.16, 1, 0.3, 1),\n\t\tborder-color 320ms cubic-bezier(0.16, 1, 0.3, 1),\n\t\tcolor 320ms cubic-bezier(0.16, 1, 0.3, 1),\n\t\tbox-shadow 180ms ease-out;\n}\n\n.dl__label,\n.dl__slot {\n\tposition: relative;\n\tz-index: 1;\n}\n\n/* hairline tray pinned to the bottom inside edge — present at rest */\n.dl__tray {\n\tposition: absolute;\n\tleft: 0.75rem;\n\tright: 0.75rem;\n\tbottom: 6px;\n\theight: 1px;\n\tz-index: 1;\n\tbackground-color: var(--border);\n\topacity: 0.5;\n\tpointer-events: none;\n\ttransition:\n\t\topacity 320ms cubic-bezier(0.16, 1, 0.3, 1),\n\t\tbackground-color 320ms cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n/* pressed overlay — sits under the content, keeps geometry frozen */\n.dl__press {\n\tposition: absolute;\n\tinset: 0;\n\tz-index: 0;\n\tborder-radius: inherit;\n\topacity: 0;\n\tbackground-color: color-mix(in oklch, var(--accent) 20%, transparent);\n\tbox-shadow: inset 0 1px 2px color-mix(in oklch, var(--foreground) 28%, transparent);\n\tpointer-events: none;\n\ttransition: opacity 120ms ease-out;\n}\n\n/* fixed inline slot — reserves the icon area so nothing can reflow */\n.dl__slot {\n\twidth: 0.875rem;\n\theight: 0.875rem;\n\tflex-shrink: 0;\n\toverflow: hidden;\n}\n\n.dl__icon {\n\tposition: absolute;\n\tinset: 0;\n\twidth: 0.875rem;\n\theight: 0.875rem;\n}\n\n.dl__icon--b {\n\ttransform: translateY(-100%);\n}\n\n/* --- emphasis: gold accent, never primary cyan --- */\n.dl:hover,\n.dl:focus-visible,\n.dl.is-hover,\n.dl.is-focus,\n.dl.is-active {\n\tbackground-color: color-mix(in oklch, var(--accent) 12%, transparent);\n\tborder-color: color-mix(in oklch, var(--accent) 45%, transparent);\n\tcolor: var(--foreground);\n}\n\n.dl:hover .dl__tray,\n.dl:focus-visible .dl__tray,\n.dl.is-hover .dl__tray,\n.dl.is-focus .dl__tray,\n.dl.is-active .dl__tray {\n\topacity: 1;\n\tbackground-color: var(--accent);\n}\n\n/* signature offset focus ring — drawn outside the box, zero layout cost */\n.dl:focus-visible,\n.dl.is-focus {\n\tbox-shadow:\n\t\t0 0 0 2px var(--card),\n\t\t0 0 0 4px color-mix(in oklch, var(--accent) 55%, transparent);\n}\n\n.dl:active .dl__press,\n.dl.is-active .dl__press {\n\topacity: 1;\n}\n\n/* --- motion, gated: under reduced motion the icons simply hold still --- */\n@media (prefers-reduced-motion: no-preference) {\n\t.dl:not(.is-reduced) .dl__icon {\n\t\ttransition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);\n\t}\n\t.dl:not(.is-reduced) .dl__icon--b {\n\t\ttransition-delay: 40ms;\n\t}\n\t.dl:not(.is-reduced):hover .dl__icon--a,\n\t.dl:not(.is-reduced):focus-visible .dl__icon--a,\n\t.dl:not(.is-reduced).is-hover .dl__icon--a,\n\t.dl:not(.is-reduced).is-focus .dl__icon--a,\n\t.dl:not(.is-reduced).is-active .dl__icon--a {\n\t\ttransform: translateY(100%);\n\t}\n\t.dl:not(.is-reduced):hover .dl__icon--b,\n\t.dl:not(.is-reduced):focus-visible .dl__icon--b,\n\t.dl:not(.is-reduced).is-hover .dl__icon--b,\n\t.dl:not(.is-reduced).is-focus .dl__icon--b,\n\t.dl:not(.is-reduced).is-active .dl__icon--b {\n\t\ttransform: translateY(0);\n\t}\n}\n\n.guide {\n\tposition: absolute;\n\ttop: 0;\n\tbottom: 0;\n\twidth: 0;\n\tborder-left: 1px dashed color-mix(in oklch, var(--accent) 55%, transparent);\n\tpointer-events: none;\n}\n</style>\n<div class=\"sheet w-full bg-[var(--background)] text-[var(--foreground)]\" data-kid=\"1\">\n    <!-- ============ TITLE ============ -->\n    <div class=\"border-b border-[var(--border)] px-14 pt-12 pb-8\" data-kid=\"1-1\">\n        <p class=\"text-[11px] font-semibold tracking-[0.18em] text-[var(--muted-foreground)] uppercase\" data-kid=\"1-1-1\">\n            Micro-interaction spec · Download CV · Variant A of 3\n        </p>\n        <h1 class=\"mt-3 text-[22px] font-semibold tracking-tight\" data-kid=\"1-1-2\">\n            A — Masked Slot Descent\n        </h1>\n        <p class=\"mt-2 max-w-2xl text-[13px] leading-relaxed text-[var(--muted-foreground)]\" data-kid=\"1-1-3\">\n            The arrow falls out of a fixed 14px slot while a second copy drops in behind it, clipped\n\t\t\tby the slot so nothing escapes the pill. The pill itself never moves — only its surface,\n\t\t\tborder, tray line and the icons inside change.\n        </p>\n    </div>\n    <!-- ============================================================\n\t     DARK\n\t     ============================================================ -->\n    <div class=\"dark bg-[var(--background)] px-14 py-12 text-[var(--foreground)]\" data-kid=\"1-2\">\n        <p class=\"text-[11px] font-semibold tracking-[0.18em] text-[var(--muted-foreground)] uppercase\" data-kid=\"1-2-1\">\n            Dark theme\n        </p>\n        <div class=\"mt-6 grid grid-cols-[580px_minmax(0,1fr)] items-start gap-10\" data-kid=\"1-2-2\">\n            <!-- ---------- 01 in context ---------- -->\n            <div data-kid=\"1-2-2-1\">\n                <p class=\"mb-3 text-[11px] font-semibold tracking-[0.18em] text-[var(--muted-foreground)] uppercase\" data-kid=\"1-2-2-1-1\">\n                    01 · In context\n                </p>\n                <div class=\"grid h-[288px] w-[580px] grid-cols-[minmax(0,2fr)_minmax(0,3fr)] overflow-hidden rounded-[2rem] bg-[var(--card)] text-[var(--card-foreground)]\" data-kid=\"1-2-2-1-2\">\n                    <div class=\"relative flex min-h-0 min-w-0 items-center justify-center border-r border-[var(--border)] p-5\" data-kid=\"1-2-2-1-2-1\">\n                        <div class=\"relative h-full max-w-[17.5rem] overflow-hidden rounded-2xl bg-[var(--muted)]\" data-kid=\"1-2-2-1-2-1-1\" style=\"aspect-ratio: 3 / 4\">\n                            <img alt=\"Gonzalo Pozo, Full Stack Developer\" class=\"size-full object-cover grayscale\" data-kid=\"1-2-2-1-2-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/cv_pic.png\"/>\n                        </div>\n                    </div>\n                    <div class=\"grid min-h-0 min-w-0 grid-rows-[auto_minmax(0,1fr)_auto] gap-3 p-5\" data-kid=\"1-2-2-1-2-2\">\n                        <div class=\"flex min-w-0 flex-wrap items-center justify-between gap-x-2 gap-y-3\" data-kid=\"1-2-2-1-2-2-1\">\n                            <span class=\"min-w-0 truncate text-xs font-semibold text-[var(--muted-foreground)]\" data-kid=\"1-2-2-1-2-2-1-1\">\n                                Full Stack Developer\n                            </span>\n                            <a aria-label=\"Download CV\" class=\"dl\" data-kid=\"1-2-2-1-2-2-1-2\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                                <span class=\"dl__press\" data-kid=\"1-2-2-1-2-2-1-2-1\">\n                                </span>\n                                <span class=\"dl__tray\" data-kid=\"1-2-2-1-2-2-1-2-2\">\n                                </span>\n                                <span class=\"dl__label\" data-kid=\"1-2-2-1-2-2-1-2-3\">\n                                    Download CV\n                                </span>\n                                <span class=\"dl__slot\" data-kid=\"1-2-2-1-2-2-1-2-4\">\n                                    <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--a\" data-kid=\"1-2-2-1-2-2-1-2-4-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                        <path d=\"M12 17V3\">\n                                        </path>\n                                        <path d=\"m6 11 6 6 6-6\">\n                                        </path>\n                                        <path d=\"M19 21H5\">\n                                        </path>\n                                    </svg>\n                                    <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--b\" data-kid=\"1-2-2-1-2-2-1-2-4-2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                        <path d=\"M12 17V3\">\n                                        </path>\n                                        <path d=\"m6 11 6 6 6-6\">\n                                        </path>\n                                        <path d=\"M19 21H5\">\n                                        </path>\n                                    </svg>\n                                </span>\n                            </a>\n                            <div class=\"flex max-h-16 min-w-0 basis-full items-start gap-2.5 rounded-xl border border-[color-mix(in_oklch,var(--status-active)_35%,transparent)] bg-[color-mix(in_oklch,var(--status-active)_10%,transparent)] px-3 py-2 text-xs/relaxed font-semibold text-[var(--foreground)]\" data-kid=\"1-2-2-1-2-2-1-3\">\n                                <span class=\"mt-1 size-2 shrink-0 rounded-full bg-[var(--status-active)] motion-safe:animate-pulse\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-2-1-3-1\" data-name=\"active status indicator pulse\" data-reason=\"animated by motion-safe:animate-pulse class\">\n                                </span>\n                                <span class=\"min-w-0 normal-case\" data-kid=\"1-2-2-1-2-2-1-3-2\">\n                                    Actualmente buscando empleo\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"flex min-h-0 min-w-0 flex-col justify-center gap-2 overflow-hidden\" data-kid=\"1-2-2-1-2-2-2\">\n                            <h2 class=\"text-2xl/tight font-bold tracking-tight text-[var(--foreground)]\" data-kid=\"1-2-2-1-2-2-2-1\">\n                                Hey, I'm Gonzalo.\n                            </h2>\n                            <p class=\"line-clamp-3 max-w-md text-sm/relaxed text-[var(--muted-foreground)]\" data-kid=\"1-2-2-1-2-2-2-2\">\n                                I love turning ideas into real products people can use. I care about\n\t\t\t\t\t\t\t\tthoughtful interfaces, solid backend foundations, and the kind of\n\t\t\t\t\t\t\t\tcurious, collaborative work that keeps improving the product, the\n\t\t\t\t\t\t\t\tcode, and the people building it.\n                            </p>\n                        </div>\n                        <div class=\"flex min-w-0 justify-end\" data-kid=\"1-2-2-1-2-2-3\">\n                            <span class=\"inline-flex min-h-11 items-center gap-2 rounded-full bg-[var(--primary)] px-5 text-sm font-medium text-[var(--primary-foreground)]\" data-kid=\"1-2-2-1-2-2-3-1\">\n                                About Me\n                                <svg aria-hidden=\"true\" class=\"size-4\" data-kid=\"1-2-2-1-2-2-3-1-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                    <path d=\"M5 12h14\">\n                                    </path>\n                                    <path d=\"m12 5 7 7-7 7\">\n                                    </path>\n                                </svg>\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <p class=\"mt-3 text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-2-2-1-3\">\n                    Live — hover or tab into the control. The cyan is now spent only on the About Me\n\t\t\t\t\tCTA; the eyebrow and status label are sentence case.\n                </p>\n                <!-- ---------- 03 mechanic diagram ---------- -->\n                <p class=\"mt-10 mb-3 text-[11px] font-semibold tracking-[0.18em] text-[var(--muted-foreground)] uppercase\" data-kid=\"1-2-2-1-4\">\n                    03 · Mechanic\n                </p>\n                <div class=\"rounded-2xl bg-[var(--card)] p-6\" data-kid=\"1-2-2-1-5\">\n                    <div class=\"flex items-start gap-10\" data-kid=\"1-2-2-1-5-1\">\n                        <!-- frame 0 -->\n                        <div data-kid=\"1-2-2-1-5-1-1\">\n                            <div class=\"relative size-[42px]\" data-kid=\"1-2-2-1-5-1-1-1\" style=\"border: 1px dashed color-mix(in oklch, var(--accent) 55%, transparent)\">\n                                <!-- ghosts (outside the slot) -->\n                                <div class=\"absolute inset-0 opacity-20\" data-kid=\"1-2-2-1-5-1-1-1-1\">\n                                    <svg aria-hidden=\"true\" class=\"absolute inset-0 size-[42px] text-[var(--foreground)]\" data-kid=\"1-2-2-1-5-1-1-1-1-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" style=\"transform: translateY(0)\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                        <path d=\"M12 17V3\">\n                                        </path>\n                                        <path d=\"m6 11 6 6 6-6\">\n                                        </path>\n                                        <path d=\"M19 21H5\">\n                                        </path>\n                                    </svg>\n                                    <svg aria-hidden=\"true\" class=\"absolute inset-0 size-[42px] text-[var(--accent)]\" data-kid=\"1-2-2-1-5-1-1-1-1-2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" style=\"transform: translateY(-100%)\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                        <path d=\"M12 17V3\">\n                                        </path>\n                                        <path d=\"m6 11 6 6 6-6\">\n                                        </path>\n                                        <path d=\"M19 21H5\">\n                                        </path>\n                                    </svg>\n                                </div>\n                                <!-- clipped (inside the slot) -->\n                                <div class=\"absolute inset-0 overflow-hidden\" data-kid=\"1-2-2-1-5-1-1-1-2\">\n                                    <svg aria-hidden=\"true\" class=\"absolute inset-0 size-[42px] text-[var(--foreground)]\" data-kid=\"1-2-2-1-5-1-1-1-2-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" style=\"transform: translateY(0)\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                        <path d=\"M12 17V3\">\n                                        </path>\n                                        <path d=\"m6 11 6 6 6-6\">\n                                        </path>\n                                        <path d=\"M19 21H5\">\n                                        </path>\n                                    </svg>\n                                    <svg aria-hidden=\"true\" class=\"absolute inset-0 size-[42px] text-[var(--accent)]\" data-kid=\"1-2-2-1-5-1-1-1-2-2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" style=\"transform: translateY(-100%)\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                        <path d=\"M12 17V3\">\n                                        </path>\n                                        <path d=\"m6 11 6 6 6-6\">\n                                        </path>\n                                        <path d=\"M19 21H5\">\n                                        </path>\n                                    </svg>\n                                </div>\n                            </div>\n                            <p class=\"mt-3 text-[11px] font-semibold text-[var(--foreground)]\" data-kid=\"1-2-2-1-5-1-1-2\">\n                                0 ms\n                            </p>\n                            <p class=\"text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-2-2-1-5-1-1-3\">\n                                rest\n                            </p>\n                        </div>\n                        <!-- frame 160 -->\n                        <div data-kid=\"1-2-2-1-5-1-2\">\n                            <div class=\"relative size-[42px]\" data-kid=\"1-2-2-1-5-1-2-1\" style=\"border: 1px dashed color-mix(in oklch, var(--accent) 55%, transparent)\">\n                                <div class=\"absolute inset-0 opacity-20\" data-kid=\"1-2-2-1-5-1-2-1-1\">\n                                    <svg aria-hidden=\"true\" class=\"absolute inset-0 size-[42px] text-[var(--foreground)]\" data-kid=\"1-2-2-1-5-1-2-1-1-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" style=\"transform: translateY(58%)\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                        <path d=\"M12 17V3\">\n                                        </path>\n                                        <path d=\"m6 11 6 6 6-6\">\n                                        </path>\n                                        <path d=\"M19 21H5\">\n                                        </path>\n                                    </svg>\n                                    <svg aria-hidden=\"true\" class=\"absolute inset-0 size-[42px] text-[var(--accent)]\" data-kid=\"1-2-2-1-5-1-2-1-1-2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" style=\"transform: translateY(-38%)\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                        <path d=\"M12 17V3\">\n                                        </path>\n                                        <path d=\"m6 11 6 6 6-6\">\n                                        </path>\n                                        <path d=\"M19 21H5\">\n                                        </path>\n                                    </svg>\n                                </div>\n                                <div class=\"absolute inset-0 overflow-hidden\" data-kid=\"1-2-2-1-5-1-2-1-2\">\n                                    <svg aria-hidden=\"true\" class=\"absolute inset-0 size-[42px] text-[var(--foreground)]\" data-kid=\"1-2-2-1-5-1-2-1-2-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" style=\"transform: translateY(58%)\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                        <path d=\"M12 17V3\">\n                                        </path>\n                                        <path d=\"m6 11 6 6 6-6\">\n                                        </path>\n                                        <path d=\"M19 21H5\">\n                                        </path>\n                                    </svg>\n                                    <svg aria-hidden=\"true\" class=\"absolute inset-0 size-[42px] text-[var(--accent)]\" data-kid=\"1-2-2-1-5-1-2-1-2-2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" style=\"transform: translateY(-38%)\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                        <path d=\"M12 17V3\">\n                                        </path>\n                                        <path d=\"m6 11 6 6 6-6\">\n                                        </path>\n                                        <path d=\"M19 21H5\">\n                                        </path>\n                                    </svg>\n                                </div>\n                            </div>\n                            <p class=\"mt-3 text-[11px] font-semibold text-[var(--foreground)]\" data-kid=\"1-2-2-1-5-1-2-2\">\n                                160 ms\n                            </p>\n                            <p class=\"text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-2-2-1-5-1-2-3\">\n                                hand-off\n                            </p>\n                        </div>\n                        <!-- frame 320 -->\n                        <div data-kid=\"1-2-2-1-5-1-3\">\n                            <div class=\"relative size-[42px]\" data-kid=\"1-2-2-1-5-1-3-1\" style=\"border: 1px dashed color-mix(in oklch, var(--accent) 55%, transparent)\">\n                                <div class=\"absolute inset-0 opacity-20\" data-kid=\"1-2-2-1-5-1-3-1-1\">\n                                    <svg aria-hidden=\"true\" class=\"absolute inset-0 size-[42px] text-[var(--foreground)]\" data-kid=\"1-2-2-1-5-1-3-1-1-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" style=\"transform: translateY(100%)\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                        <path d=\"M12 17V3\">\n                                        </path>\n                                        <path d=\"m6 11 6 6 6-6\">\n                                        </path>\n                                        <path d=\"M19 21H5\">\n                                        </path>\n                                    </svg>\n                                </div>\n                                <div class=\"absolute inset-0 overflow-hidden\" data-kid=\"1-2-2-1-5-1-3-1-2\">\n                                    <svg aria-hidden=\"true\" class=\"absolute inset-0 size-[42px] text-[var(--accent)]\" data-kid=\"1-2-2-1-5-1-3-1-2-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" style=\"transform: translateY(0)\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                        <path d=\"M12 17V3\">\n                                        </path>\n                                        <path d=\"m6 11 6 6 6-6\">\n                                        </path>\n                                        <path d=\"M19 21H5\">\n                                        </path>\n                                    </svg>\n                                </div>\n                            </div>\n                            <p class=\"mt-3 text-[11px] font-semibold text-[var(--foreground)]\" data-kid=\"1-2-2-1-5-1-3-2\">\n                                320 ms\n                            </p>\n                            <p class=\"text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-2-2-1-5-1-3-3\">\n                                settled\n                            </p>\n                        </div>\n                        <div class=\"max-w-[15rem] border-l border-[var(--border)] pl-6 text-[11px] leading-relaxed text-[var(--muted-foreground)]\" data-kid=\"1-2-2-1-5-1-4\">\n                            <p class=\"font-semibold text-[var(--foreground)]\" data-kid=\"1-2-2-1-5-1-4-1\">\n                                Timing tokens\n                            </p>\n                            <p class=\"mt-2\" data-kid=\"1-2-2-1-5-1-4-2\">\n                                duration\n                                <span class=\"text-[var(--foreground)]\" data-kid=\"1-2-2-1-5-1-4-2-1\">\n                                    320 ms\n                                </span>\n                            </p>\n                            <p data-kid=\"1-2-2-1-5-1-4-3\">\n                                easing\n                                <span class=\"text-[var(--foreground)]\" data-kid=\"1-2-2-1-5-1-4-3-1\">\n                                    cubic-bezier(0.16, 1, 0.3, 1)\n                                </span>\n                            </p>\n                            <p data-kid=\"1-2-2-1-5-1-4-4\">\n                                hand-off delay\n                                <span class=\"text-[var(--foreground)]\" data-kid=\"1-2-2-1-5-1-4-4-1\">\n                                    40 ms\n                                </span>\n                                on copy B\n                            </p>\n                            <p class=\"mt-3\" data-kid=\"1-2-2-1-5-1-4-5\">\n                                Dashed box = the 14px slot (shown 3×). Ghosted strokes are clipped away by\n                                <span class=\"text-[var(--foreground)]\" data-kid=\"1-2-2-1-5-1-4-5-1\">\n                                    overflow-hidden\n                                </span>\n                                and never paint outside the pill.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- ---------- 02 state matrix ---------- -->\n            <div data-kid=\"1-2-2-2\">\n                <p class=\"mb-3 text-[11px] font-semibold tracking-[0.18em] text-[var(--muted-foreground)] uppercase\" data-kid=\"1-2-2-2-1\">\n                    02 · State matrix\n                </p>\n                <div class=\"rounded-2xl bg-[var(--card)] p-6\" data-kid=\"1-2-2-2-2\">\n                    <div class=\"relative w-fit\" data-kid=\"1-2-2-2-2-1\">\n                        <span class=\"guide\" data-kid=\"1-2-2-2-2-1-1\" style=\"left: 0\">\n                        </span>\n                        <span class=\"guide\" data-kid=\"1-2-2-2-2-1-2\" style=\"right: 0\">\n                        </span>\n                        <div class=\"flex flex-col items-start gap-4\" data-kid=\"1-2-2-2-2-1-3\">\n                            <!-- rest -->\n                            <div class=\"relative\" data-kid=\"1-2-2-2-2-1-3-1\">\n                                <span class=\"dl\" data-kid=\"1-2-2-2-2-1-3-1-1\">\n                                    <span class=\"dl__press\" data-kid=\"1-2-2-2-2-1-3-1-1-1\">\n                                    </span>\n                                    <span class=\"dl__tray\" data-kid=\"1-2-2-2-2-1-3-1-1-2\">\n                                    </span>\n                                    <span class=\"dl__label\" data-kid=\"1-2-2-2-2-1-3-1-1-3\">\n                                        Download CV\n                                    </span>\n                                    <span class=\"dl__slot\" data-kid=\"1-2-2-2-2-1-3-1-1-4\">\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--a\" data-kid=\"1-2-2-2-2-1-3-1-1-4-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--b\" data-kid=\"1-2-2-2-2-1-3-1-1-4-2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                    </span>\n                                </span>\n                                <span class=\"absolute top-1/2 left-[calc(100%+2rem)] -translate-y-1/2 text-[11px] whitespace-nowrap text-[var(--muted-foreground)]\" data-kid=\"1-2-2-2-2-1-3-1-2\">\n                                    Rest — hairline border + faint surface + tray at 50%\n                                </span>\n                            </div>\n                            <!-- hover -->\n                            <div class=\"relative\" data-kid=\"1-2-2-2-2-1-3-2\">\n                                <span class=\"dl is-hover\" data-kid=\"1-2-2-2-2-1-3-2-1\">\n                                    <span class=\"dl__press\" data-kid=\"1-2-2-2-2-1-3-2-1-1\">\n                                    </span>\n                                    <span class=\"dl__tray\" data-kid=\"1-2-2-2-2-1-3-2-1-2\">\n                                    </span>\n                                    <span class=\"dl__label\" data-kid=\"1-2-2-2-2-1-3-2-1-3\">\n                                        Download CV\n                                    </span>\n                                    <span class=\"dl__slot\" data-kid=\"1-2-2-2-2-1-3-2-1-4\">\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--a\" data-kid=\"1-2-2-2-2-1-3-2-1-4-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--b\" data-kid=\"1-2-2-2-2-1-3-2-1-4-2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                    </span>\n                                </span>\n                                <span class=\"absolute top-1/2 left-[calc(100%+2rem)] -translate-y-1/2 text-[11px] whitespace-nowrap text-[var(--muted-foreground)]\" data-kid=\"1-2-2-2-2-1-3-2-2\">\n                                    Hover — accent surface, tray to 100%, copy B landed\n                                </span>\n                            </div>\n                            <!-- focus -->\n                            <div class=\"relative\" data-kid=\"1-2-2-2-2-1-3-3\">\n                                <span class=\"dl is-focus\" data-kid=\"1-2-2-2-2-1-3-3-1\">\n                                    <span class=\"dl__press\" data-kid=\"1-2-2-2-2-1-3-3-1-1\">\n                                    </span>\n                                    <span class=\"dl__tray\" data-kid=\"1-2-2-2-2-1-3-3-1-2\">\n                                    </span>\n                                    <span class=\"dl__label\" data-kid=\"1-2-2-2-2-1-3-3-1-3\">\n                                        Download CV\n                                    </span>\n                                    <span class=\"dl__slot\" data-kid=\"1-2-2-2-2-1-3-3-1-4\">\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--a\" data-kid=\"1-2-2-2-2-1-3-3-1-4-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--b\" data-kid=\"1-2-2-2-2-1-3-3-1-4-2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                    </span>\n                                </span>\n                                <span class=\"absolute top-1/2 left-[calc(100%+2rem)] -translate-y-1/2 text-[11px] whitespace-nowrap text-[var(--muted-foreground)]\" data-kid=\"1-2-2-2-2-1-3-3-2\">\n                                    Focus-visible — 2px accent ring, 2px card offset\n                                </span>\n                            </div>\n                            <!-- active -->\n                            <div class=\"relative\" data-kid=\"1-2-2-2-2-1-3-4\">\n                                <span class=\"dl is-active\" data-kid=\"1-2-2-2-2-1-3-4-1\">\n                                    <span class=\"dl__press\" data-kid=\"1-2-2-2-2-1-3-4-1-1\">\n                                    </span>\n                                    <span class=\"dl__tray\" data-kid=\"1-2-2-2-2-1-3-4-1-2\">\n                                    </span>\n                                    <span class=\"dl__label\" data-kid=\"1-2-2-2-2-1-3-4-1-3\">\n                                        Download CV\n                                    </span>\n                                    <span class=\"dl__slot\" data-kid=\"1-2-2-2-2-1-3-4-1-4\">\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--a\" data-kid=\"1-2-2-2-2-1-3-4-1-4-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--b\" data-kid=\"1-2-2-2-2-1-3-4-1-4-2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                    </span>\n                                </span>\n                                <span class=\"absolute top-1/2 left-[calc(100%+2rem)] -translate-y-1/2 text-[11px] whitespace-nowrap text-[var(--muted-foreground)]\" data-kid=\"1-2-2-2-2-1-3-4-2\">\n                                    Active — inset press overlay, no scale on the link\n                                </span>\n                            </div>\n                            <!-- reduced motion -->\n                            <div class=\"relative\" data-kid=\"1-2-2-2-2-1-3-5\">\n                                <span class=\"dl is-reduced is-hover\" data-kid=\"1-2-2-2-2-1-3-5-1\">\n                                    <span class=\"dl__press\" data-kid=\"1-2-2-2-2-1-3-5-1-1\">\n                                    </span>\n                                    <span class=\"dl__tray\" data-kid=\"1-2-2-2-2-1-3-5-1-2\">\n                                    </span>\n                                    <span class=\"dl__label\" data-kid=\"1-2-2-2-2-1-3-5-1-3\">\n                                        Download CV\n                                    </span>\n                                    <span class=\"dl__slot\" data-kid=\"1-2-2-2-2-1-3-5-1-4\">\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--a\" data-kid=\"1-2-2-2-2-1-3-5-1-4-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--b\" data-kid=\"1-2-2-2-2-1-3-5-1-4-2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                    </span>\n                                </span>\n                                <span class=\"absolute top-1/2 left-[calc(100%+2rem)] -translate-y-1/2 text-[11px] whitespace-nowrap text-[var(--muted-foreground)]\" data-kid=\"1-2-2-2-2-1-3-5-2\">\n                                    Reduced motion (hover) — icon holds, colour + tray still fire\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                    <p class=\"mt-6 border-t border-[var(--border)] pt-4 text-[11px] leading-relaxed text-[var(--muted-foreground)]\" data-kid=\"1-2-2-2-2-2\">\n                        The two dashed guides are pinned to the Rest pill's edges. Every state lands\n\t\t\t\t\t\ton them, so the pill's width and height are provably identical throughout —\n\t\t\t\t\t\tno reflow of the label, the status pill or anything else in the card.\n                    </p>\n                </div>\n                <!-- ---------- 04 responsive ---------- -->\n                <p class=\"mt-10 mb-3 text-[11px] font-semibold tracking-[0.18em] text-[var(--muted-foreground)] uppercase\" data-kid=\"1-2-2-2-3\">\n                    04 · Responsive\n                </p>\n                <div class=\"flex items-start gap-6\" data-kid=\"1-2-2-2-4\">\n                    <div data-kid=\"1-2-2-2-4-1\">\n                        <div class=\"w-[320px] rounded-2xl bg-[var(--card)] p-4\" data-kid=\"1-2-2-2-4-1-1\">\n                            <div class=\"flex min-w-0 flex-wrap items-center justify-between gap-x-2 gap-y-3\" data-kid=\"1-2-2-2-4-1-1-1\">\n                                <span class=\"min-w-0 truncate text-xs font-semibold text-[var(--muted-foreground)]\" data-kid=\"1-2-2-2-4-1-1-1-1\">\n                                    Full Stack Developer\n                                </span>\n                                <a aria-label=\"Download CV\" class=\"dl\" data-kid=\"1-2-2-2-4-1-1-1-2\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                                    <span class=\"dl__press\" data-kid=\"1-2-2-2-4-1-1-1-2-1\">\n                                    </span>\n                                    <span class=\"dl__tray\" data-kid=\"1-2-2-2-4-1-1-1-2-2\">\n                                    </span>\n                                    <span class=\"dl__label\" data-kid=\"1-2-2-2-4-1-1-1-2-3\">\n                                        Download CV\n                                    </span>\n                                    <span class=\"dl__slot\" data-kid=\"1-2-2-2-4-1-1-1-2-4\">\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--a\" data-kid=\"1-2-2-2-4-1-1-1-2-4-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--b\" data-kid=\"1-2-2-2-4-1-1-1-2-4-2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                    </span>\n                                </a>\n                            </div>\n                        </div>\n                        <p class=\"mt-2 text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-2-2-2-4-1-2\">\n                            320px — wraps, 44px tall, no truncation\n                        </p>\n                    </div>\n                    <div data-kid=\"1-2-2-2-4-2\">\n                        <div class=\"w-[375px] rounded-2xl bg-[var(--card)] p-4\" data-kid=\"1-2-2-2-4-2-1\">\n                            <div class=\"flex min-w-0 flex-wrap items-center justify-between gap-x-2 gap-y-3\" data-kid=\"1-2-2-2-4-2-1-1\">\n                                <span class=\"min-w-0 truncate text-xs font-semibold text-[var(--muted-foreground)]\" data-kid=\"1-2-2-2-4-2-1-1-1\">\n                                    Full Stack Developer\n                                </span>\n                                <a aria-label=\"Download CV\" class=\"dl\" data-kid=\"1-2-2-2-4-2-1-1-2\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                                    <span class=\"dl__press\" data-kid=\"1-2-2-2-4-2-1-1-2-1\">\n                                    </span>\n                                    <span class=\"dl__tray\" data-kid=\"1-2-2-2-4-2-1-1-2-2\">\n                                    </span>\n                                    <span class=\"dl__label\" data-kid=\"1-2-2-2-4-2-1-1-2-3\">\n                                        Download CV\n                                    </span>\n                                    <span class=\"dl__slot\" data-kid=\"1-2-2-2-4-2-1-1-2-4\">\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--a\" data-kid=\"1-2-2-2-4-2-1-1-2-4-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--b\" data-kid=\"1-2-2-2-4-2-1-1-2-4-2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                    </span>\n                                </a>\n                            </div>\n                        </div>\n                        <p class=\"mt-2 text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-2-2-2-4-2-2\">\n                            375px — fits on one line\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <!-- ============================================================\n\t     LIGHT\n\t     ============================================================ -->\n    <div class=\"border-t border-[var(--border)] bg-[var(--background)] px-14 py-12\" data-kid=\"1-3\">\n        <p class=\"text-[11px] font-semibold tracking-[0.18em] text-[var(--muted-foreground)] uppercase\" data-kid=\"1-3-1\">\n            Light theme\n        </p>\n        <div class=\"mt-6 grid grid-cols-[580px_minmax(0,1fr)] items-start gap-10\" data-kid=\"1-3-2\">\n            <div data-kid=\"1-3-2-1\">\n                <p class=\"mb-3 text-[11px] font-semibold tracking-[0.18em] text-[var(--muted-foreground)] uppercase\" data-kid=\"1-3-2-1-1\">\n                    01 · In context\n                </p>\n                <div class=\"grid h-[288px] w-[580px] grid-cols-[minmax(0,2fr)_minmax(0,3fr)] overflow-hidden rounded-[2rem] bg-[var(--card)] text-[var(--card-foreground)]\" data-kid=\"1-3-2-1-2\">\n                    <div class=\"relative flex min-h-0 min-w-0 items-center justify-center border-r border-[var(--border)] p-5\" data-kid=\"1-3-2-1-2-1\">\n                        <div class=\"relative h-full max-w-[17.5rem] overflow-hidden rounded-2xl bg-[var(--muted)]\" data-kid=\"1-3-2-1-2-1-1\" style=\"aspect-ratio: 3 / 4\">\n                            <img alt=\"Gonzalo Pozo, Full Stack Developer\" class=\"size-full object-cover grayscale\" data-kid=\"1-3-2-1-2-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/cv_pic.png\"/>\n                        </div>\n                    </div>\n                    <div class=\"grid min-h-0 min-w-0 grid-rows-[auto_minmax(0,1fr)_auto] gap-3 p-5\" data-kid=\"1-3-2-1-2-2\">\n                        <div class=\"flex min-w-0 flex-wrap items-center justify-between gap-x-2 gap-y-3\" data-kid=\"1-3-2-1-2-2-1\">\n                            <span class=\"min-w-0 truncate text-xs font-semibold text-[var(--muted-foreground)]\" data-kid=\"1-3-2-1-2-2-1-1\">\n                                Full Stack Developer\n                            </span>\n                            <a aria-label=\"Download CV\" class=\"dl\" data-kid=\"1-3-2-1-2-2-1-2\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                                <span class=\"dl__press\" data-kid=\"1-3-2-1-2-2-1-2-1\">\n                                </span>\n                                <span class=\"dl__tray\" data-kid=\"1-3-2-1-2-2-1-2-2\">\n                                </span>\n                                <span class=\"dl__label\" data-kid=\"1-3-2-1-2-2-1-2-3\">\n                                    Download CV\n                                </span>\n                                <span class=\"dl__slot\" data-kid=\"1-3-2-1-2-2-1-2-4\">\n                                    <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--a\" data-kid=\"1-3-2-1-2-2-1-2-4-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                        <path d=\"M12 17V3\">\n                                        </path>\n                                        <path d=\"m6 11 6 6 6-6\">\n                                        </path>\n                                        <path d=\"M19 21H5\">\n                                        </path>\n                                    </svg>\n                                    <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--b\" data-kid=\"1-3-2-1-2-2-1-2-4-2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                        <path d=\"M12 17V3\">\n                                        </path>\n                                        <path d=\"m6 11 6 6 6-6\">\n                                        </path>\n                                        <path d=\"M19 21H5\">\n                                        </path>\n                                    </svg>\n                                </span>\n                            </a>\n                            <div class=\"flex max-h-16 min-w-0 basis-full items-start gap-2.5 rounded-xl border border-[color-mix(in_oklch,var(--status-active)_35%,transparent)] bg-[color-mix(in_oklch,var(--status-active)_10%,transparent)] px-3 py-2 text-xs/relaxed font-semibold text-[var(--foreground)]\" data-kid=\"1-3-2-1-2-2-1-3\">\n                                <span class=\"mt-1 size-2 shrink-0 rounded-full bg-[var(--status-active)] motion-safe:animate-pulse\" data-dynamic=\"true\" data-kid=\"1-3-2-1-2-2-1-3-1\" data-name=\"active status indicator pulse\" data-reason=\"animated by motion-safe:animate-pulse class\">\n                                </span>\n                                <span class=\"min-w-0 normal-case\" data-kid=\"1-3-2-1-2-2-1-3-2\">\n                                    Actualmente buscando empleo\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"flex min-h-0 min-w-0 flex-col justify-center gap-2 overflow-hidden\" data-kid=\"1-3-2-1-2-2-2\">\n                            <h2 class=\"text-2xl/tight font-bold tracking-tight text-[var(--foreground)]\" data-kid=\"1-3-2-1-2-2-2-1\">\n                                Hey, I'm Gonzalo.\n                            </h2>\n                            <p class=\"line-clamp-3 max-w-md text-sm/relaxed text-[var(--muted-foreground)]\" data-kid=\"1-3-2-1-2-2-2-2\">\n                                I love turning ideas into real products people can use. I care about\n\t\t\t\t\t\t\t\tthoughtful interfaces, solid backend foundations, and the kind of\n\t\t\t\t\t\t\t\tcurious, collaborative work that keeps improving the product, the\n\t\t\t\t\t\t\t\tcode, and the people building it.\n                            </p>\n                        </div>\n                        <div class=\"flex min-w-0 justify-end\" data-kid=\"1-3-2-1-2-2-3\">\n                            <span class=\"inline-flex min-h-11 items-center gap-2 rounded-full bg-[var(--primary)] px-5 text-sm font-medium text-[var(--primary-foreground)]\" data-kid=\"1-3-2-1-2-2-3-1\">\n                                About Me\n                                <svg aria-hidden=\"true\" class=\"size-4\" data-kid=\"1-3-2-1-2-2-3-1-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                    <path d=\"M5 12h14\">\n                                    </path>\n                                    <path d=\"m12 5 7 7-7 7\">\n                                    </path>\n                                </svg>\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <p class=\"mt-3 text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-3-2-1-3\">\n                    Live — the accent reads as warm gold on white, still clearly separate from the\n\t\t\t\t\tsapphire CTA.\n                </p>\n            </div>\n            <div data-kid=\"1-3-2-2\">\n                <p class=\"mb-3 text-[11px] font-semibold tracking-[0.18em] text-[var(--muted-foreground)] uppercase\" data-kid=\"1-3-2-2-1\">\n                    02 · State matrix\n                </p>\n                <div class=\"rounded-2xl bg-[var(--card)] p-6\" data-kid=\"1-3-2-2-2\">\n                    <div class=\"relative w-fit\" data-kid=\"1-3-2-2-2-1\">\n                        <span class=\"guide\" data-kid=\"1-3-2-2-2-1-1\" style=\"left: 0\">\n                        </span>\n                        <span class=\"guide\" data-kid=\"1-3-2-2-2-1-2\" style=\"right: 0\">\n                        </span>\n                        <div class=\"flex flex-col items-start gap-4\" data-kid=\"1-3-2-2-2-1-3\">\n                            <div class=\"relative\" data-kid=\"1-3-2-2-2-1-3-1\">\n                                <span class=\"dl\" data-kid=\"1-3-2-2-2-1-3-1-1\">\n                                    <span class=\"dl__press\" data-kid=\"1-3-2-2-2-1-3-1-1-1\">\n                                    </span>\n                                    <span class=\"dl__tray\" data-kid=\"1-3-2-2-2-1-3-1-1-2\">\n                                    </span>\n                                    <span class=\"dl__label\" data-kid=\"1-3-2-2-2-1-3-1-1-3\">\n                                        Download CV\n                                    </span>\n                                    <span class=\"dl__slot\" data-kid=\"1-3-2-2-2-1-3-1-1-4\">\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--a\" data-kid=\"1-3-2-2-2-1-3-1-1-4-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--b\" data-kid=\"1-3-2-2-2-1-3-1-1-4-2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                    </span>\n                                </span>\n                                <span class=\"absolute top-1/2 left-[calc(100%+2rem)] -translate-y-1/2 text-[11px] whitespace-nowrap text-[var(--muted-foreground)]\" data-kid=\"1-3-2-2-2-1-3-1-2\">\n                                    Rest\n                                </span>\n                            </div>\n                            <div class=\"relative\" data-kid=\"1-3-2-2-2-1-3-2\">\n                                <span class=\"dl is-hover\" data-kid=\"1-3-2-2-2-1-3-2-1\">\n                                    <span class=\"dl__press\" data-kid=\"1-3-2-2-2-1-3-2-1-1\">\n                                    </span>\n                                    <span class=\"dl__tray\" data-kid=\"1-3-2-2-2-1-3-2-1-2\">\n                                    </span>\n                                    <span class=\"dl__label\" data-kid=\"1-3-2-2-2-1-3-2-1-3\">\n                                        Download CV\n                                    </span>\n                                    <span class=\"dl__slot\" data-kid=\"1-3-2-2-2-1-3-2-1-4\">\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--a\" data-kid=\"1-3-2-2-2-1-3-2-1-4-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--b\" data-kid=\"1-3-2-2-2-1-3-2-1-4-2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                    </span>\n                                </span>\n                                <span class=\"absolute top-1/2 left-[calc(100%+2rem)] -translate-y-1/2 text-[11px] whitespace-nowrap text-[var(--muted-foreground)]\" data-kid=\"1-3-2-2-2-1-3-2-2\">\n                                    Hover\n                                </span>\n                            </div>\n                            <div class=\"relative\" data-kid=\"1-3-2-2-2-1-3-3\">\n                                <span class=\"dl is-focus\" data-kid=\"1-3-2-2-2-1-3-3-1\">\n                                    <span class=\"dl__press\" data-kid=\"1-3-2-2-2-1-3-3-1-1\">\n                                    </span>\n                                    <span class=\"dl__tray\" data-kid=\"1-3-2-2-2-1-3-3-1-2\">\n                                    </span>\n                                    <span class=\"dl__label\" data-kid=\"1-3-2-2-2-1-3-3-1-3\">\n                                        Download CV\n                                    </span>\n                                    <span class=\"dl__slot\" data-kid=\"1-3-2-2-2-1-3-3-1-4\">\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--a\" data-kid=\"1-3-2-2-2-1-3-3-1-4-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--b\" data-kid=\"1-3-2-2-2-1-3-3-1-4-2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                    </span>\n                                </span>\n                                <span class=\"absolute top-1/2 left-[calc(100%+2rem)] -translate-y-1/2 text-[11px] whitespace-nowrap text-[var(--muted-foreground)]\" data-kid=\"1-3-2-2-2-1-3-3-2\">\n                                    Focus-visible\n                                </span>\n                            </div>\n                            <div class=\"relative\" data-kid=\"1-3-2-2-2-1-3-4\">\n                                <span class=\"dl is-active\" data-kid=\"1-3-2-2-2-1-3-4-1\">\n                                    <span class=\"dl__press\" data-kid=\"1-3-2-2-2-1-3-4-1-1\">\n                                    </span>\n                                    <span class=\"dl__tray\" data-kid=\"1-3-2-2-2-1-3-4-1-2\">\n                                    </span>\n                                    <span class=\"dl__label\" data-kid=\"1-3-2-2-2-1-3-4-1-3\">\n                                        Download CV\n                                    </span>\n                                    <span class=\"dl__slot\" data-kid=\"1-3-2-2-2-1-3-4-1-4\">\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--a\" data-kid=\"1-3-2-2-2-1-3-4-1-4-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--b\" data-kid=\"1-3-2-2-2-1-3-4-1-4-2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                    </span>\n                                </span>\n                                <span class=\"absolute top-1/2 left-[calc(100%+2rem)] -translate-y-1/2 text-[11px] whitespace-nowrap text-[var(--muted-foreground)]\" data-kid=\"1-3-2-2-2-1-3-4-2\">\n                                    Active\n                                </span>\n                            </div>\n                            <div class=\"relative\" data-kid=\"1-3-2-2-2-1-3-5\">\n                                <span class=\"dl is-reduced is-hover\" data-kid=\"1-3-2-2-2-1-3-5-1\">\n                                    <span class=\"dl__press\" data-kid=\"1-3-2-2-2-1-3-5-1-1\">\n                                    </span>\n                                    <span class=\"dl__tray\" data-kid=\"1-3-2-2-2-1-3-5-1-2\">\n                                    </span>\n                                    <span class=\"dl__label\" data-kid=\"1-3-2-2-2-1-3-5-1-3\">\n                                        Download CV\n                                    </span>\n                                    <span class=\"dl__slot\" data-kid=\"1-3-2-2-2-1-3-5-1-4\">\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--a\" data-kid=\"1-3-2-2-2-1-3-5-1-4-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--b\" data-kid=\"1-3-2-2-2-1-3-5-1-4-2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                    </span>\n                                </span>\n                                <span class=\"absolute top-1/2 left-[calc(100%+2rem)] -translate-y-1/2 text-[11px] whitespace-nowrap text-[var(--muted-foreground)]\" data-kid=\"1-3-2-2-2-1-3-5-2\">\n                                    Reduced motion (hover)\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <p class=\"mt-10 mb-3 text-[11px] font-semibold tracking-[0.18em] text-[var(--muted-foreground)] uppercase\" data-kid=\"1-3-2-2-3\">\n                    04 · Responsive\n                </p>\n                <div class=\"flex items-start gap-6\" data-kid=\"1-3-2-2-4\">\n                    <div data-kid=\"1-3-2-2-4-1\">\n                        <div class=\"w-[320px] rounded-2xl bg-[var(--card)] p-4\" data-kid=\"1-3-2-2-4-1-1\">\n                            <div class=\"flex min-w-0 flex-wrap items-center justify-between gap-x-2 gap-y-3\" data-kid=\"1-3-2-2-4-1-1-1\">\n                                <span class=\"min-w-0 truncate text-xs font-semibold text-[var(--muted-foreground)]\" data-kid=\"1-3-2-2-4-1-1-1-1\">\n                                    Full Stack Developer\n                                </span>\n                                <a aria-label=\"Download CV\" class=\"dl\" data-kid=\"1-3-2-2-4-1-1-1-2\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                                    <span class=\"dl__press\" data-kid=\"1-3-2-2-4-1-1-1-2-1\">\n                                    </span>\n                                    <span class=\"dl__tray\" data-kid=\"1-3-2-2-4-1-1-1-2-2\">\n                                    </span>\n                                    <span class=\"dl__label\" data-kid=\"1-3-2-2-4-1-1-1-2-3\">\n                                        Download CV\n                                    </span>\n                                    <span class=\"dl__slot\" data-kid=\"1-3-2-2-4-1-1-1-2-4\">\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--a\" data-kid=\"1-3-2-2-4-1-1-1-2-4-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--b\" data-kid=\"1-3-2-2-4-1-1-1-2-4-2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                    </span>\n                                </a>\n                            </div>\n                        </div>\n                        <p class=\"mt-2 text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-3-2-2-4-1-2\">\n                            320px\n                        </p>\n                    </div>\n                    <div data-kid=\"1-3-2-2-4-2\">\n                        <div class=\"w-[375px] rounded-2xl bg-[var(--card)] p-4\" data-kid=\"1-3-2-2-4-2-1\">\n                            <div class=\"flex min-w-0 flex-wrap items-center justify-between gap-x-2 gap-y-3\" data-kid=\"1-3-2-2-4-2-1-1\">\n                                <span class=\"min-w-0 truncate text-xs font-semibold text-[var(--muted-foreground)]\" data-kid=\"1-3-2-2-4-2-1-1-1\">\n                                    Full Stack Developer\n                                </span>\n                                <a aria-label=\"Download CV\" class=\"dl\" data-kid=\"1-3-2-2-4-2-1-1-2\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                                    <span class=\"dl__press\" data-kid=\"1-3-2-2-4-2-1-1-2-1\">\n                                    </span>\n                                    <span class=\"dl__tray\" data-kid=\"1-3-2-2-4-2-1-1-2-2\">\n                                    </span>\n                                    <span class=\"dl__label\" data-kid=\"1-3-2-2-4-2-1-1-2-3\">\n                                        Download CV\n                                    </span>\n                                    <span class=\"dl__slot\" data-kid=\"1-3-2-2-4-2-1-1-2-4\">\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--a\" data-kid=\"1-3-2-2-4-2-1-1-2-4-1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                        <svg aria-hidden=\"true\" class=\"dl__icon dl__icon--b\" data-kid=\"1-3-2-2-4-2-1-1-2-4-2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                            <path d=\"M12 17V3\">\n                                            </path>\n                                            <path d=\"m6 11 6 6 6-6\">\n                                            </path>\n                                            <path d=\"M19 21H5\">\n                                            </path>\n                                        </svg>\n                                    </span>\n                                </a>\n                            </div>\n                        </div>\n                        <p class=\"mt-2 text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-3-2-2-4-2-2\">\n                            375px\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n",
      "comments": [],
      "created": "2026-08-17T12:10:02.315093+00:00",
      "modified": "2026-08-17T12:12:35.018907+00:00",
      "id": "var_6ab1bb0440b1",
