    },
    "var_c5f810af9e9d": {
      "type": "variant",
      "label": "Download CV C — Label Swap & Notch",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 5520,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap');\n\n  :root {\n    --background: oklch(0.975 0.008 270);\n    --foreground: oklch(0.155 0.025 270);\n    --card: oklch(1 0 0);\n    --card-foreground: oklch(0.155 0.025 270);\n    --primary: oklch(0.4 0.17 250);\n    --primary-foreground: oklch(0.985 0.005 250);\n    --secondary: oklch(0.945 0.012 270);\n    --secondary-foreground: oklch(0.195 0.025 270);\n    --muted: oklch(0.92 0.008 270);\n    --muted-foreground: oklch(0.43 0.02 265);\n    --accent: oklch(0.7 0.18 55);\n    --accent-foreground: oklch(0.2 0.05 55);\n    --border: oklch(0.885 0.012 270);\n    --ring: oklch(0.48 0.17 250);\n    --status-active: oklch(0.52 0.175 155);\n  }\n\n  .dark {\n    --background: oklch(0.12 0.025 275);\n    --foreground: oklch(0.95 0.008 265);\n    --card: oklch(0.175 0.022 270);\n    --card-foreground: oklch(0.95 0.008 265);\n    --primary: oklch(0.75 0.17 235);\n    --primary-foreground: oklch(0.12 0.035 235);\n    --secondary: oklch(0.225 0.018 275);\n    --secondary-foreground: oklch(0.91 0.008 265);\n    --muted: oklch(0.225 0.018 275);\n    --muted-foreground: oklch(0.58 0.016 265);\n    --accent: oklch(0.8 0.17 50);\n    --accent-foreground: oklch(0.12 0.045 50);\n    --border: oklch(0.265 0.018 275);\n    --ring: oklch(0.75 0.17 235);\n    --status-active: oklch(0.7 0.175 155);\n  }\n\n  /* ============================================================\n     VARIANT C — \"Label Swap & Notch\"\n     Outer <a> geometry is frozen: width 9.75rem, min-height 2.75rem,\n     padding-inline .75rem, gap .375rem, border 1px, font-size .75rem.\n     Only color, and out-of-flow / masked children, ever change.\n     ============================================================ */\n  .dl-chip {\n    position: relative;\n    display: inline-flex;\n    flex-shrink: 0;\n    align-items: center;\n    justify-content: center;\n    gap: 0.375rem;\n    width: 9.75rem;\n    min-height: 2.75rem;\n    padding-inline: 0.75rem;\n    border: 1px solid var(--border);\n    border-radius: 9999px;\n    background: var(--card);\n    color: var(--muted-foreground);\n    font-family: inherit;\n    font-size: 0.75rem;\n    font-weight: 600;\n    letter-spacing: 0.025em;\n    text-decoration: none;\n    overflow: hidden;\n    -webkit-tap-highlight-color: transparent;\n    transition:\n      color 300ms cubic-bezier(0.16, 1, 0.3, 1),\n      background-color 300ms cubic-bezier(0.16, 1, 0.3, 1),\n      border-color 300ms cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  .dl-chip__dot {\n    width: 0.25rem;\n    height: 0.25rem;\n    flex-shrink: 0;\n    border-radius: 9999px;\n    background: var(--border);\n    transition: background-color 300ms cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  /* fixed-height mask: both label spans are absolute, so the pill can never resize */\n  .dl-chip__labels {\n    position: relative;\n    flex: 1 1 0%;\n    height: 1rem;\n    overflow: hidden;\n    text-align: left;\n  }\n  .dl-chip__label {\n    position: absolute;\n    inset: 0;\n    line-height: 1rem;\n    white-space: nowrap;\n  }\n  .dl-chip__label--b {\n    transform: translateY(100%);\n    font-size: 11px;\n    font-weight: 500;\n    letter-spacing: 0.01em;\n    color: var(--foreground);\n  }\n  .dl-chip__meta {\n    color: var(--muted-foreground);\n  }\n\n  /* reserved inline area for the icon — animation is clipped inside it */\n  .dl-chip__slot {\n    position: relative;\n    width: 0.875rem;\n    height: 0.875rem;\n    flex-shrink: 0;\n    overflow: hidden;\n  }\n  .dl-chip__icon {\n    width: 0.875rem;\n    height: 0.875rem;\n    display: block;\n  }\n\n  /* the notch: absolutely positioned, centred 19px from the right edge\n     (12px padding + half of the 14px slot) so widening it moves nothing */\n  .dl-chip__notch {\n    position: absolute;\n    right: 19px;\n    bottom: 0.375rem;\n    width: 0.625rem;\n    height: 2px;\n    transform: translateX(50%);\n    border-radius: 9999px;\n    background: color-mix(in oklch, var(--border) 70%, transparent);\n    transition:\n      background-color 300ms cubic-bezier(0.16, 1, 0.3, 1),\n      width 300ms cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  /* ---- colour response (always fires, even under reduced motion) ---- */\n  .dl-chip:hover,\n  .dl-chip:focus-visible,\n  .dl-chip[data-dl='hover'],\n  .dl-chip[data-dl='mid'],\n  .dl-chip[data-dl='focus'],\n  .dl-chip[data-dl='active'],\n  .dl-chip[data-dl='reduced'] {\n    border-color: color-mix(in oklch, var(--accent) 55%, transparent);\n    background: color-mix(in oklch, var(--accent) 10%, transparent);\n    color: var(--foreground);\n  }\n  .dl-chip:hover .dl-chip__dot,\n  .dl-chip:focus-visible .dl-chip__dot,\n  .dl-chip[data-dl='hover'] .dl-chip__dot,\n  .dl-chip[data-dl='mid'] .dl-chip__dot,\n  .dl-chip[data-dl='focus'] .dl-chip__dot,\n  .dl-chip[data-dl='active'] .dl-chip__dot,\n  .dl-chip[data-dl='reduced'] .dl-chip__dot {\n    background: var(--accent);\n  }\n  .dl-chip:hover .dl-chip__notch,\n  .dl-chip:focus-visible .dl-chip__notch,\n  .dl-chip[data-dl='hover'] .dl-chip__notch,\n  .dl-chip[data-dl='mid'] .dl-chip__notch,\n  .dl-chip[data-dl='focus'] .dl-chip__notch,\n  .dl-chip[data-dl='reduced'] .dl-chip__notch {\n    width: 1rem;\n    background: var(--accent);\n  }\n\n  /* ---- pressed ---- */\n  .dl-chip:active,\n  .dl-chip[data-dl='active'] {\n    background: color-mix(in oklch, var(--accent) 18%, transparent);\n    border-color: color-mix(in oklch, var(--accent) 70%, transparent);\n  }\n  .dl-chip:active .dl-chip__notch,\n  .dl-chip[data-dl='active'] .dl-chip__notch {\n    width: 0.875rem;\n    background: var(--accent);\n  }\n\n  /* ---- signature offset focus ring (drawn outside the box) ---- */\n  .dl-chip:focus-visible,\n  .dl-chip[data-dl='focus'] {\n    outline: none;\n    box-shadow:\n      0 0 0 2px var(--card),\n      0 0 0 4px color-mix(in oklch, var(--accent) 55%, transparent);\n  }\n\n  /* ---- motion: label roll + icon dock ---- */\n  @media (prefers-reduced-motion: no-preference) {\n    .dl-chip__label {\n      transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);\n    }\n    .dl-chip__label--b {\n      transition-delay: 30ms;\n    }\n    .dl-chip:hover .dl-chip__label--a,\n    .dl-chip:focus-visible .dl-chip__label--a {\n      transform: translateY(-100%);\n    }\n    .dl-chip:hover .dl-chip__label--b,\n    .dl-chip:focus-visible .dl-chip__label--b {\n      transform: translateY(0);\n    }\n    .dl-chip:hover .dl-chip__icon,\n    .dl-chip:focus-visible .dl-chip__icon {\n      animation: dl-dock 400ms cubic-bezier(0.16, 1, 0.3, 1);\n    }\n    .dl-chip[data-dl='hover'] .dl-chip__icon,\n    .dl-chip[data-dl='focus'] .dl-chip__icon {\n      animation: dl-dock-loop 1600ms cubic-bezier(0.16, 1, 0.3, 1) infinite;\n    }\n  }\n\n  /* forced states for the spec matrix / diagram — static, no transition */\n  .dl-chip[data-dl] .dl-chip__label {\n    transition: none;\n  }\n  .dl-chip[data-dl='hover'] .dl-chip__label--a,\n  .dl-chip[data-dl='focus'] .dl-chip__label--a,\n  .dl-chip[data-dl='active'] .dl-chip__label--a {\n    transform: translateY(-100%);\n  }\n  .dl-chip[data-dl='hover'] .dl-chip__label--b,\n  .dl-chip[data-dl='focus'] .dl-chip__label--b,\n  .dl-chip[data-dl='active'] .dl-chip__label--b {\n    transform: translateY(0);\n  }\n  .dl-chip[data-dl='mid'] .dl-chip__label--a {\n    transform: translateY(-50%);\n  }\n  .dl-chip[data-dl='mid'] .dl-chip__label--b {\n    transform: translateY(50%);\n  }\n  /* reduced-motion cell: colour only, label stays put */\n  .dl-chip[data-dl='reduced'] .dl-chip__label--a {\n    transform: translateY(0);\n  }\n  .dl-chip[data-dl='reduced'] .dl-chip__label--b {\n    transform: translateY(100%);\n  }\n\n  .dl-frame .dl-chip__icon {\n    animation: none !important;\n  }\n  .dl-frame .dl-chip[data-dl='mid'] .dl-chip__icon {\n    transform: translateY(3px);\n  }\n\n  @keyframes dl-dock {\n    0% {\n      transform: translateY(0);\n    }\n    45% {\n      transform: translateY(3px);\n    }\n    100% {\n      transform: translateY(0);\n    }\n  }\n  @keyframes dl-dock-loop {\n    0%,\n    62%,\n    100% {\n      transform: translateY(0);\n    }\n    22% {\n      transform: translateY(3px);\n    }\n  }\n</style>\n<div class=\"font-[Geist,ui-sans-serif,system-ui,sans-serif] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- =================== DARK HALF =================== -->\n    <div class=\"dark bg-[var(--background)] px-14 pt-12 pb-16 text-[var(--foreground)]\" data-kid=\"1-1\" data-name=\"dark mode section\">\n        <div class=\"mb-10 flex items-end justify-between gap-8 border-b border-[var(--border)] pb-6\" data-kid=\"1-1-1\" data-name=\"header row container\">\n            <div class=\"min-w-0\" data-kid=\"1-1-1-1\" data-name=\"title area\">\n                <p class=\"mb-2 text-[11px] font-medium tracking-[0.18em] text-[var(--muted-foreground)] uppercase\" data-kid=\"1-1-1-1-1\" data-name=\"spec description text\">\n                    Micro-interaction spec · variant C of 3\n                </p>\n                <h1 class=\"text-[22px] leading-tight font-semibold tracking-tight\" data-kid=\"1-1-1-1-2\" data-name=\"section title\">\n                    C — Label Swap & Notch\n                </h1>\n                <p class=\"mt-2 max-w-2xl text-[13px] leading-relaxed text-[var(--muted-foreground)]\" data-kid=\"1-1-1-1-3\" data-name=\"section description text\">\n                    The pill's label rolls up inside a fixed-height mask to reveal what you're\n\t\t\t\t\tactually getting, while the arrow docks into a notch cut along the bottom inside\n\t\t\t\t\tedge. Width is pinned to the wider of the two strings, so nothing can resize.\n                </p>\n            </div>\n            <div class=\"hidden shrink-0 rounded-xl border border-[var(--border)] bg-[var(--card)] px-4 py-3 text-[11px] leading-relaxed text-[var(--muted-foreground)] lg:block\" data-kid=\"1-1-1-2\" data-name=\"geometry info box\">\n                <span class=\"font-semibold text-[var(--foreground)]\" data-kid=\"1-1-1-2-1\" data-name=\"geometry title\">\n                    Geometry lock\n                </span>\n                <br data-kid=\"1-1-1-2-2\" data-name=\"line break\"/>\n                w 156px · h 44px · px 12 · gap 6\n                <br data-kid=\"1-1-1-2-3\" data-name=\"line break\"/>\n                identical in rest / hover / focus / active\n            </div>\n        </div>\n        <!-- 01 in context -->\n        <div class=\"mb-4 flex items-center gap-3\" data-kid=\"1-1-2\" data-name=\"context header row\">\n            <p class=\"text-[11px] font-medium tracking-[0.18em] text-[var(--muted-foreground)] uppercase\" data-kid=\"1-1-2-1\" data-name=\"context header label\">\n                01 — In context · dark\n            </p>\n            <span class=\"h-px flex-1 bg-[var(--border)]\" data-kid=\"1-1-2-2\" data-name=\"divider line\">\n            </span>\n            <p class=\"text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-1-2-3\" data-name=\"interaction hint\">\n                live — hover the chip\n            </p>\n        </div>\n        <div class=\"mb-14 flex flex-wrap items-start gap-8\" data-kid=\"1-1-3\" data-name=\"interactive demonstration section\">\n            <div class=\"grid h-[236px] w-[580px] grid-cols-[minmax(0,2fr)_minmax(0,3fr)] overflow-hidden rounded-[2rem] bg-[var(--card)]\" data-kid=\"1-1-3-1\" data-name=\"cv card component\">\n                <div class=\"flex min-h-0 min-w-0 items-center justify-center border-r border-[var(--border)] p-5\" data-kid=\"1-1-3-1-1\" data-name=\"cv profile image container\">\n                    <div class=\"h-full w-auto max-w-[17.5rem] overflow-hidden rounded-2xl bg-[var(--muted)] shadow-inner\" data-kid=\"1-1-3-1-1-1\" data-name=\"image wrapper\" style=\"aspect-ratio: 3 / 4\">\n                        <img alt=\"Gonzalo Pozo, Full Stack Developer\" class=\"size-full object-cover grayscale\" data-kid=\"1-1-3-1-1-1-1\" data-name=\"profile image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/cv_pic.png\"/>\n                    </div>\n                </div>\n                <div class=\"grid min-h-0 min-w-0 grid-rows-[auto_minmax(0,1fr)_auto] gap-3 p-5\" data-kid=\"1-1-3-1-2\" data-name=\"cv details content\">\n                    <div class=\"flex min-w-0 flex-wrap items-center justify-between gap-x-2 gap-y-3\" data-kid=\"1-1-3-1-2-1\" data-name=\"chip row\">\n                        <span class=\"min-w-0 truncate text-xs font-semibold tracking-normal text-[var(--muted-foreground)]\" data-kid=\"1-1-3-1-2-1-1\" data-name=\"job title\">\n                            Full Stack Developer\n                        </span>\n                        <a aria-label=\"Download CV\" class=\"dl-chip\" data-kid=\"1-1-3-1-2-1-2\" data-name=\"download cv chip\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            <span aria-hidden=\"true\" class=\"dl-chip__dot\" data-kid=\"1-1-3-1-2-1-2-1\" data-name=\"chip status dot\">\n                            </span>\n                            <span class=\"dl-chip__labels\" data-kid=\"1-1-3-1-2-1-2-2\" data-name=\"chip text mask\">\n                                <span class=\"dl-chip__label dl-chip__label--a\" data-kid=\"1-1-3-1-2-1-2-2-1\" data-name=\"chip label primary\">\n                                    Download CV\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl-chip__label dl-chip__label--b\" data-kid=\"1-1-3-1-2-1-2-2-2\" data-name=\"chip label secondary\">\n                                    CV · PDF ·\n                                    <span class=\"dl-chip__meta\" data-kid=\"1-1-3-1-2-1-2-2-2-1\" data-name=\"chip meta text\">\n                                        148 KB\n                                    </span>\n                                </span>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__slot\" data-kid=\"1-1-3-1-2-1-2-3\" data-name=\"chip slot\">\n                                <svg class=\"dl-chip__icon\" data-kid=\"1-1-3-1-2-1-2-3-1\" data-name=\"download icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__notch\" data-kid=\"1-1-3-1-2-1-2-4\" data-name=\"chip notch\">\n                            </span>\n                        </a>\n                        <div class=\"flex max-h-16 min-w-0 basis-full items-start gap-2.5 rounded-xl border px-3 py-2 text-xs/relaxed font-semibold text-[var(--foreground)] normal-case\" data-kid=\"1-1-3-1-2-1-3\" data-name=\"status indicator pill\" role=\"status\" style=\"\n\t\t\t\t\t\t\t\tborder-color: color-mix(in oklch, var(--status-active) 35%, transparent);\n\t\t\t\t\t\t\t\tbackground: color-mix(in oklch, var(--status-active) 10%, transparent);\n\t\t\t\t\t\t\t\">\n                            <span aria-hidden=\"true\" class=\"mt-1 size-2 shrink-0 rounded-full bg-[var(--status-active)] motion-safe:animate-pulse\" data-dynamic=\"true\" data-kid=\"1-1-3-1-2-1-3-1\" data-name=\"status pulse dot\" data-reason=\"animation re-initializes or maintains pulse state\">\n                            </span>\n                            <span class=\"min-w-0 text-pretty\" data-kid=\"1-1-3-1-2-1-3-2\" data-name=\"status text\">\n                                Actualmente buscando empleo\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"flex min-h-0 min-w-0 flex-col justify-center gap-2 overflow-hidden\" data-kid=\"1-1-3-1-2-2\" data-name=\"cv summary\">\n                        <p class=\"text-2xl/tight font-bold tracking-tight text-balance\" data-kid=\"1-1-3-1-2-2-1\" data-name=\"cv headline\">\n                            Hey, I'm Gonzalo.\n                        </p>\n                        <p class=\"line-clamp-3 max-w-md text-sm/relaxed text-pretty text-[var(--muted-foreground)]\" data-kid=\"1-1-3-1-2-2-2\" data-name=\"cv summary text\">\n                            I love turning ideas into real products people can use. I care about\n\t\t\t\t\t\t\tthoughtful interfaces, solid backend foundations, and the kind of\n\t\t\t\t\t\t\tcurious, collaborative work that keeps improving the product, the code,\n\t\t\t\t\t\t\tand the people building it.\n                        </p>\n                    </div>\n                    <div class=\"flex min-w-0 justify-end\" data-kid=\"1-1-3-1-2-3\" data-name=\"about me call-to-action\">\n                        <span class=\"inline-flex min-h-11 items-center gap-2 rounded-full bg-[var(--primary)] px-5 text-sm font-medium text-[var(--primary-foreground)]\" data-kid=\"1-1-3-1-2-3-1\" data-name=\"about me link\">\n                            About Me\n                            <svg aria-hidden=\"true\" class=\"size-4\" data-kid=\"1-1-3-1-2-3-1-1\" data-name=\"right arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n                                <path d=\"M5 12h14\">\n                                </path>\n                                <path d=\"m12 5 7 7-7 7\">\n                                </path>\n                            </svg>\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"max-w-[380px] space-y-3 pt-1\" data-kid=\"1-1-3-2\" data-name=\"changes description list\">\n                <p class=\"text-[11px] font-medium tracking-[0.18em] text-[var(--muted-foreground)] uppercase\" data-kid=\"1-1-3-2-1\" data-name=\"list title\">\n                    What changed in the header row\n                </p>\n                <ul class=\"space-y-2.5 text-[13px] leading-relaxed text-[var(--muted-foreground)]\" data-kid=\"1-1-3-2-2\" data-name=\"changes list\">\n                    <li class=\"flex gap-2.5\" data-kid=\"1-1-3-2-2-1\" data-name=\"list item\">\n                        <span class=\"mt-1.5 size-1.5 shrink-0 rounded-full bg-[var(--accent)]\" data-kid=\"1-1-3-2-2-1-1\" data-name=\"list item bullet\">\n                        </span>\n                        <span data-kid=\"1-1-3-2-2-1-2\" data-name=\"list item text\">\n                            Eyebrow dropped from cyan all-caps to\n                            <span class=\"text-[var(--foreground)]\" data-kid=\"1-1-3-2-2-1-2-1\" data-name=\"bolded text span\">\n                                sentence-case muted\n                            </span>\n                            — it's\n\t\t\t\t\t\t\ta label, not a headline.\n                        </span>\n                    </li>\n                    <li class=\"flex gap-2.5\" data-kid=\"1-1-3-2-2-2\" data-name=\"list item\">\n                        <span class=\"mt-1.5 size-1.5 shrink-0 rounded-full bg-[var(--accent)]\" data-kid=\"1-1-3-2-2-2-1\" data-name=\"list item bullet\">\n                        </span>\n                        <span data-kid=\"1-1-3-2-2-2-2\" data-name=\"list item text\">\n                            Status pill keeps its dot but loses the shouting caps, so the row has\n\t\t\t\t\t\t\tone emphasis instead of three.\n                        </span>\n                    </li>\n                    <li class=\"flex gap-2.5\" data-kid=\"1-1-3-2-2-3\" data-name=\"list item\">\n                        <span class=\"mt-1.5 size-1.5 shrink-0 rounded-full bg-[var(--accent)]\" data-kid=\"1-1-3-2-2-3-1\" data-name=\"list item bullet\">\n                        </span>\n                        <span data-kid=\"1-1-3-2-2-3-2\" data-name=\"list item text\">\n                            The chip now reads as an action\n                            <span class=\"text-[var(--foreground)]\" data-kid=\"1-1-3-2-2-3-2-1\" data-name=\"bolded text span\">\n                                at rest\n                            </span>\n                            — hairline border,\n\t\t\t\t\t\t\tcard surface, quiet marker dot.\n                        </span>\n                    </li>\n                    <li class=\"flex gap-2.5\" data-kid=\"1-1-3-2-2-4\" data-name=\"list item\">\n                        <span class=\"mt-1.5 size-1.5 shrink-0 rounded-full bg-[var(--accent)]\" data-kid=\"1-1-3-2-2-4-1\" data-name=\"list item bullet\">\n                        </span>\n                        <span data-kid=\"1-1-3-2-2-4-2\" data-name=\"list item text\">\n                            Interaction spends the\n                            <span class=\"text-[var(--accent)]\" data-kid=\"1-1-3-2-2-4-2-1\" data-name=\"bolded text span\">\n                                gold accent\n                            </span>\n                            , never primary\n\t\t\t\t\t\t\tcyan — no collision with the rest of the card.\n                        </span>\n                    </li>\n                </ul>\n            </div>\n        </div>\n        <!-- 02 state matrix -->\n        <div class=\"mb-4 flex items-center gap-3\" data-kid=\"1-1-4\" data-name=\"state matrix header\">\n            <p class=\"text-[11px] font-medium tracking-[0.18em] text-[var(--muted-foreground)] uppercase\" data-kid=\"1-1-4-1\" data-name=\"matrix title\">\n                02 — State matrix · dark\n            </p>\n            <span class=\"h-px flex-1 bg-[var(--border)]\" data-kid=\"1-1-4-2\" data-name=\"divider line\">\n            </span>\n            <p class=\"text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-1-4-3\" data-name=\"matrix hint\">\n                dashed guides = the rest chip's left / right edges\n            </p>\n        </div>\n        <div class=\"mb-14 rounded-2xl bg-[var(--card)] p-6\" data-kid=\"1-1-5\" data-name=\"state matrix container\">\n            <div class=\"relative w-fit\" data-kid=\"1-1-5-1\" data-name=\"matrix grid\">\n                <div class=\"pointer-events-none absolute top-0 bottom-0 left-[192px] w-[156px] border-x border-dashed\" data-kid=\"1-1-5-1-1\" data-name=\"grid guide line\" style=\"border-color: color-mix(in oklch, var(--accent) 45%, transparent)\">\n                </div>\n                <div class=\"relative flex flex-col gap-4\" data-kid=\"1-1-5-1-2\" data-name=\"state rows container\">\n                    <div class=\"flex items-center gap-6\" data-kid=\"1-1-5-1-2-1\" data-name=\"rest state row\">\n                        <p class=\"w-[168px] text-right text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-1-5-1-2-1-1\" data-name=\"state label\">\n                            Rest\n                        </p>\n                        <a aria-label=\"Download CV\" class=\"dl-chip\" data-dl=\"rest\" data-kid=\"1-1-5-1-2-1-2\" data-name=\"download cv chip\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            <span aria-hidden=\"true\" class=\"dl-chip__dot\" data-kid=\"1-1-5-1-2-1-2-1\" data-name=\"chip status dot\">\n                            </span>\n                            <span class=\"dl-chip__labels\" data-kid=\"1-1-5-1-2-1-2-2\" data-name=\"chip text mask\">\n                                <span class=\"dl-chip__label dl-chip__label--a\" data-kid=\"1-1-5-1-2-1-2-2-1\" data-name=\"chip label primary\">\n                                    Download CV\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl-chip__label dl-chip__label--b\" data-kid=\"1-1-5-1-2-1-2-2-2\" data-name=\"chip label secondary\">\n                                    CV · PDF ·\n                                    <span class=\"dl-chip__meta\" data-kid=\"1-1-5-1-2-1-2-2-2-1\" data-name=\"chip meta text\">\n                                        148 KB\n                                    </span>\n                                </span>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__slot\" data-kid=\"1-1-5-1-2-1-2-3\" data-name=\"chip slot\">\n                                <svg class=\"dl-chip__icon\" data-kid=\"1-1-5-1-2-1-2-3-1\" data-name=\"download icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__notch\" data-kid=\"1-1-5-1-2-1-2-4\" data-name=\"chip notch\">\n                            </span>\n                        </a>\n                        <p class=\"text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-1-5-1-2-1-3\" data-name=\"state description\">\n                            outlined chip · muted label · dim notch\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-6\" data-kid=\"1-1-5-1-2-2\" data-name=\"hover state row\">\n                        <p class=\"w-[168px] text-right text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-1-5-1-2-2-1\" data-name=\"state label\">\n                            Hover\n                        </p>\n                        <a aria-label=\"Download CV\" class=\"dl-chip\" data-dl=\"hover\" data-kid=\"1-1-5-1-2-2-2\" data-name=\"download cv chip\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            <span aria-hidden=\"true\" class=\"dl-chip__dot\" data-kid=\"1-1-5-1-2-2-2-1\" data-name=\"chip status dot\">\n                            </span>\n                            <span class=\"dl-chip__labels\" data-kid=\"1-1-5-1-2-2-2-2\" data-name=\"chip text mask\">\n                                <span class=\"dl-chip__label dl-chip__label--a\" data-kid=\"1-1-5-1-2-2-2-2-1\" data-name=\"chip label primary\">\n                                    Download CV\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl-chip__label dl-chip__label--b\" data-kid=\"1-1-5-1-2-2-2-2-2\" data-name=\"chip label secondary\">\n                                    CV · PDF ·\n                                    <span class=\"dl-chip__meta\" data-kid=\"1-1-5-1-2-2-2-2-2-1\" data-name=\"chip meta text\">\n                                        148 KB\n                                    </span>\n                                </span>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__slot\" data-kid=\"1-1-5-1-2-2-2-3\" data-name=\"chip slot\">\n                                <svg class=\"dl-chip__icon\" data-kid=\"1-1-5-1-2-2-2-3-1\" data-name=\"download icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__notch\" data-kid=\"1-1-5-1-2-2-2-4\" data-name=\"chip notch\">\n                            </span>\n                        </a>\n                        <p class=\"text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-1-5-1-2-2-3\" data-name=\"state description\">\n                            label rolled to file meta · icon docking · notch lit + widened\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-6\" data-kid=\"1-1-5-1-2-3\" data-name=\"focus-visible state row\">\n                        <p class=\"w-[168px] text-right text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-1-5-1-2-3-1\" data-name=\"state label\">\n                            Focus-visible\n                        </p>\n                        <a aria-label=\"Download CV\" class=\"dl-chip\" data-dl=\"focus\" data-kid=\"1-1-5-1-2-3-2\" data-name=\"download cv chip\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            <span aria-hidden=\"true\" class=\"dl-chip__dot\" data-kid=\"1-1-5-1-2-3-2-1\" data-name=\"chip status dot\">\n                            </span>\n                            <span class=\"dl-chip__labels\" data-kid=\"1-1-5-1-2-3-2-2\" data-name=\"chip text mask\">\n                                <span class=\"dl-chip__label dl-chip__label--a\" data-kid=\"1-1-5-1-2-3-2-2-1\" data-name=\"chip label primary\">\n                                    Download CV\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl-chip__label dl-chip__label--b\" data-kid=\"1-1-5-1-2-3-2-2-2\" data-name=\"chip label secondary\">\n                                    CV · PDF ·\n                                    <span class=\"dl-chip__meta\" data-kid=\"1-1-5-1-2-3-2-2-2-1\" data-name=\"chip meta text\">\n                                        148 KB\n                                    </span>\n                                </span>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__slot\" data-kid=\"1-1-5-1-2-3-2-3\" data-name=\"chip slot\">\n                                <svg class=\"dl-chip__icon\" data-kid=\"1-1-5-1-2-3-2-3-1\" data-name=\"download icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__notch\" data-kid=\"1-1-5-1-2-3-2-4\" data-name=\"chip notch\">\n                            </span>\n                        </a>\n                        <p class=\"text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-1-5-1-2-3-3\" data-name=\"state description\">\n                            2px accent ring, 2px offset in card colour — drawn outside the box\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-6\" data-kid=\"1-1-5-1-2-4\" data-name=\"active state row\">\n                        <p class=\"w-[168px] text-right text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-1-5-1-2-4-1\" data-name=\"state label\">\n                            Active / pressed\n                        </p>\n                        <a aria-label=\"Download CV\" class=\"dl-chip\" data-dl=\"active\" data-kid=\"1-1-5-1-2-4-2\" data-name=\"download cv chip\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            <span aria-hidden=\"true\" class=\"dl-chip__dot\" data-kid=\"1-1-5-1-2-4-2-1\" data-name=\"chip status dot\">\n                            </span>\n                            <span class=\"dl-chip__labels\" data-kid=\"1-1-5-1-2-4-2-2\" data-name=\"chip text mask\">\n                                <span class=\"dl-chip__label dl-chip__label--a\" data-kid=\"1-1-5-1-2-4-2-2-1\" data-name=\"chip label primary\">\n                                    Download CV\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl-chip__label dl-chip__label--b\" data-kid=\"1-1-5-1-2-4-2-2-2\" data-name=\"chip label secondary\">\n                                    CV · PDF ·\n                                    <span class=\"dl-chip__meta\" data-kid=\"1-1-5-1-2-4-2-2-2-1\" data-name=\"chip meta text\">\n                                        148 KB\n                                    </span>\n                                </span>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__slot\" data-kid=\"1-1-5-1-2-4-2-3\" data-name=\"chip slot\">\n                                <svg class=\"dl-chip__icon\" data-kid=\"1-1-5-1-2-4-2-3-1\" data-name=\"download icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__notch\" data-kid=\"1-1-5-1-2-4-2-4\" data-name=\"chip notch\">\n                            </span>\n                        </a>\n                        <p class=\"text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-1-5-1-2-4-3\" data-name=\"state description\">\n                            surface one step deeper · notch fills the slot · no scale on the link\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-6\" data-kid=\"1-1-5-1-2-5\" data-name=\"reduced motion state row\">\n                        <p class=\"w-[168px] text-right text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-1-5-1-2-5-1\" data-name=\"state label\">\n                            Reduced motion (hover)\n                        </p>\n                        <a aria-label=\"Download CV\" class=\"dl-chip\" data-dl=\"reduced\" data-kid=\"1-1-5-1-2-5-2\" data-name=\"download cv chip\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            <span aria-hidden=\"true\" class=\"dl-chip__dot\" data-kid=\"1-1-5-1-2-5-2-1\" data-name=\"chip status dot\">\n                            </span>\n                            <span class=\"dl-chip__labels\" data-kid=\"1-1-5-1-2-5-2-2\" data-name=\"chip text mask\">\n                                <span class=\"dl-chip__label dl-chip__label--a\" data-kid=\"1-1-5-1-2-5-2-2-1\" data-name=\"chip label primary\">\n                                    Download CV\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl-chip__label dl-chip__label--b\" data-kid=\"1-1-5-1-2-5-2-2-2\" data-name=\"chip label secondary\">\n                                    CV · PDF ·\n                                    <span class=\"dl-chip__meta\" data-kid=\"1-1-5-1-2-5-2-2-2-1\" data-name=\"chip meta text\">\n                                        148 KB\n                                    </span>\n                                </span>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__slot\" data-kid=\"1-1-5-1-2-5-2-3\" data-name=\"chip slot\">\n                                <svg class=\"dl-chip__icon\" data-kid=\"1-1-5-1-2-5-2-3-1\" data-name=\"download icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__notch\" data-kid=\"1-1-5-1-2-5-2-4\" data-name=\"chip notch\">\n                            </span>\n                        </a>\n                        <p class=\"text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-1-5-1-2-5-3\" data-name=\"state description\">\n                            no roll, no dock — border, surface, dot and notch still respond\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- 03 mechanic -->\n        <div class=\"mb-4 flex items-center gap-3\" data-kid=\"1-1-6\" data-name=\"mechanic header\">\n            <p class=\"text-[11px] font-medium tracking-[0.18em] text-[var(--muted-foreground)] uppercase\" data-kid=\"1-1-6-1\" data-name=\"mechanic title\">\n                03 — Mechanic · 3× scale\n            </p>\n            <span class=\"h-px flex-1 bg-[var(--border)]\" data-kid=\"1-1-6-2\" data-name=\"divider line\">\n            </span>\n        </div>\n        <div class=\"mb-14 rounded-2xl bg-[var(--card)] p-8\" data-kid=\"1-1-7\" data-name=\"mechanic section container\">\n            <div class=\"dl-frame flex flex-wrap items-start gap-10\" data-kid=\"1-1-7-1\" data-name=\"mechanic frame\">\n                <div class=\"space-y-3\" data-kid=\"1-1-7-1-1\" data-name=\"rest phase column\">\n                    <div class=\"h-[132px] w-[468px] overflow-visible\" data-kid=\"1-1-7-1-1-1\" data-name=\"visual demonstration wrapper\">\n                        <div class=\"origin-top-left scale-[3]\" data-kid=\"1-1-7-1-1-1-1\" data-name=\"scaled chip container\">\n                            <a aria-label=\"Download CV\" class=\"dl-chip\" data-dl=\"rest\" data-kid=\"1-1-7-1-1-1-1-1\" data-name=\"download cv chip\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                                <span aria-hidden=\"true\" class=\"dl-chip__dot\" data-kid=\"1-1-7-1-1-1-1-1-1\" data-name=\"chip status dot\">\n                                </span>\n                                <span class=\"dl-chip__labels\" data-kid=\"1-1-7-1-1-1-1-1-2\" data-name=\"chip text mask\">\n                                    <span class=\"dl-chip__label dl-chip__label--a\" data-kid=\"1-1-7-1-1-1-1-1-2-1\" data-name=\"chip label primary\">\n                                        Download CV\n                                    </span>\n                                    <span aria-hidden=\"true\" class=\"dl-chip__label dl-chip__label--b\" data-kid=\"1-1-7-1-1-1-1-1-2-2\" data-name=\"chip label secondary\">\n                                        CV · PDF ·\n                                        <span class=\"dl-chip__meta\" data-kid=\"1-1-7-1-1-1-1-1-2-2-1\" data-name=\"chip meta text\">\n                                            148 KB\n                                        </span>\n                                    </span>\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl-chip__slot\" data-kid=\"1-1-7-1-1-1-1-1-3\" data-name=\"chip slot\">\n                                    <svg class=\"dl-chip__icon\" data-kid=\"1-1-7-1-1-1-1-1-3-1\" data-name=\"download icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                        <path d=\"M12 17V3\">\n                                        </path>\n                                        <path d=\"m6 11 6 6 6-6\">\n                                        </path>\n                                        <path d=\"M19 21H5\">\n                                        </path>\n                                    </svg>\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl-chip__notch\" data-kid=\"1-1-7-1-1-1-1-1-4\" data-name=\"chip notch\">\n                                </span>\n                            </a>\n                        </div>\n                    </div>\n                    <p class=\"text-[11px] font-semibold\" data-kid=\"1-1-7-1-1-2\" data-name=\"phase label\">\n                        0 ms — rest\n                    </p>\n                    <p class=\"max-w-[420px] text-[11px] leading-relaxed text-[var(--muted-foreground)]\" data-kid=\"1-1-7-1-1-3\" data-name=\"phase description\">\n                        \"Download CV\" sits at the top of a 16px mask. The file-meta string is\n\t\t\t\t\t\talready rendered one line below, clipped out of sight.\n                    </p>\n                </div>\n                <div class=\"space-y-3\" data-kid=\"1-1-7-1-2\" data-name=\"mid phase column\">\n                    <div class=\"h-[132px] w-[468px] overflow-visible\" data-kid=\"1-1-7-1-2-1\" data-name=\"visual demonstration wrapper\">\n                        <div class=\"origin-top-left scale-[3]\" data-kid=\"1-1-7-1-2-1-1\" data-name=\"scaled chip container\">\n                            <a aria-label=\"Download CV\" class=\"dl-chip\" data-dl=\"mid\" data-kid=\"1-1-7-1-2-1-1-1\" data-name=\"download cv chip\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                                <span aria-hidden=\"true\" class=\"dl-chip__dot\" data-kid=\"1-1-7-1-2-1-1-1-1\" data-name=\"chip status dot\">\n                                </span>\n                                <span class=\"dl-chip__labels\" data-kid=\"1-1-7-1-2-1-1-1-2\" data-name=\"chip text mask\">\n                                    <span class=\"dl-chip__label dl-chip__label--a\" data-kid=\"1-1-7-1-2-1-1-1-2-1\" data-name=\"chip label primary\">\n                                        Download CV\n                                    </span>\n                                    <span aria-hidden=\"true\" class=\"dl-chip__label dl-chip__label--b\" data-kid=\"1-1-7-1-2-1-1-1-2-2\" data-name=\"chip label secondary\">\n                                        CV · PDF ·\n                                        <span class=\"dl-chip__meta\" data-kid=\"1-1-7-1-2-1-1-1-2-2-1\" data-name=\"chip meta text\">\n                                            148 KB\n                                        </span>\n                                    </span>\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl-chip__slot\" data-kid=\"1-1-7-1-2-1-1-1-3\" data-name=\"chip slot\">\n                                    <svg class=\"dl-chip__icon\" data-kid=\"1-1-7-1-2-1-1-1-3-1\" data-name=\"download icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                        <path d=\"M12 17V3\">\n                                        </path>\n                                        <path d=\"m6 11 6 6 6-6\">\n                                        </path>\n                                        <path d=\"M19 21H5\">\n                                        </path>\n                                    </svg>\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl-chip__notch\" data-kid=\"1-1-7-1-2-1-1-1-4\" data-name=\"chip notch\">\n                                </span>\n                            </a>\n                        </div>\n                    </div>\n                    <p class=\"text-[11px] font-semibold\" data-kid=\"1-1-7-1-2-2\" data-name=\"phase label\">\n                        150 ms — mid roll\n                    </p>\n                    <p class=\"max-w-[420px] text-[11px] leading-relaxed text-[var(--muted-foreground)]\" data-kid=\"1-1-7-1-2-3\" data-name=\"phase description\">\n                        Both strings travel up one line height together; the mask crops them, so\n\t\t\t\t\t\thalf of each is visible. The arrow is at the bottom of its 14px slot — its\n\t\t\t\t\t\tdeepest point.\n                    </p>\n                </div>\n                <div class=\"space-y-3\" data-kid=\"1-1-7-1-3\" data-name=\"hover phase column\">\n                    <div class=\"h-[132px] w-[468px] overflow-visible\" data-kid=\"1-1-7-1-3-1\" data-name=\"visual demonstration wrapper\">\n                        <div class=\"origin-top-left scale-[3]\" data-kid=\"1-1-7-1-3-1-1\" data-name=\"scaled chip container\">\n                            <a aria-label=\"Download CV\" class=\"dl-chip\" data-dl=\"hover\" data-kid=\"1-1-7-1-3-1-1-1\" data-name=\"download cv chip\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                                <span aria-hidden=\"true\" class=\"dl-chip__dot\" data-kid=\"1-1-7-1-3-1-1-1-1\" data-name=\"chip status dot\">\n                                </span>\n                                <span class=\"dl-chip__labels\" data-kid=\"1-1-7-1-3-1-1-1-2\" data-name=\"chip text mask\">\n                                    <span class=\"dl-chip__label dl-chip__label--a\" data-kid=\"1-1-7-1-3-1-1-1-2-1\" data-name=\"chip label primary\">\n                                        Download CV\n                                    </span>\n                                    <span aria-hidden=\"true\" class=\"dl-chip__label dl-chip__label--b\" data-kid=\"1-1-7-1-3-1-1-1-2-2\" data-name=\"chip label secondary\">\n                                        CV · PDF ·\n                                        <span class=\"dl-chip__meta\" data-kid=\"1-1-7-1-3-1-1-1-2-2-1\" data-name=\"chip meta text\">\n                                            148 KB\n                                        </span>\n                                    </span>\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl-chip__slot\" data-kid=\"1-1-7-1-3-1-1-1-3\" data-name=\"chip slot\">\n                                    <svg class=\"dl-chip__icon\" data-kid=\"1-1-7-1-3-1-1-1-3-1\" data-name=\"download icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                        <path d=\"M12 17V3\">\n                                        </path>\n                                        <path d=\"m6 11 6 6 6-6\">\n                                        </path>\n                                        <path d=\"M19 21H5\">\n                                        </path>\n                                    </svg>\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl-chip__notch\" data-kid=\"1-1-7-1-3-1-1-1-4\" data-name=\"chip notch\">\n                                </span>\n                            </a>\n                        </div>\n                    </div>\n                    <p class=\"text-[11px] font-semibold\" data-kid=\"1-1-7-1-3-2\" data-name=\"phase label\">\n                        300 ms — settled\n                    </p>\n                    <p class=\"max-w-[420px] text-[11px] leading-relaxed text-[var(--muted-foreground)]\" data-kid=\"1-1-7-1-3-3\" data-name=\"phase description\">\n                        File meta holds the line, the arrow returns to centre, and the notch under it\n\t\t\t\t\t\thas lit to gold and widened — the only thing that changed size, and it's out\n\t\t\t\t\t\tof flow.\n                    </p>\n                </div>\n            </div>\n            <div class=\"mt-8 flex flex-wrap items-center gap-x-8 gap-y-3 border-t border-[var(--border)] pt-6 text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-1-7-2\" data-name=\"timing details footer\" style=\"font-family: 'Geist Mono', ui-monospace, monospace\">\n                <span data-kid=\"1-1-7-2-1\" data-name=\"timing item\">\n                    <span class=\"text-[var(--foreground)]\" data-kid=\"1-1-7-2-1-1\" data-name=\"timing value\">\n                        300ms\n                    </span>\n                    label roll\n                </span>\n                <span data-kid=\"1-1-7-2-2\" data-name=\"timing item\">\n                    <span class=\"text-[var(--foreground)]\" data-kid=\"1-1-7-2-2-1\" data-name=\"timing value\">\n                        30ms\n                    </span>\n                    hand-off delay\n                </span>\n                <span data-kid=\"1-1-7-2-3\" data-name=\"timing item\">\n                    <span class=\"text-[var(--foreground)]\" data-kid=\"1-1-7-2-3-1\" data-name=\"timing value\">\n                        400ms\n                    </span>\n                    icon dock\n                </span>\n                <span data-kid=\"1-1-7-2-4\" data-name=\"timing item\">\n                    <span class=\"text-[var(--foreground)]\" data-kid=\"1-1-7-2-4-1\" data-name=\"timing value\">\n                        cubic-bezier(0.16, 1, 0.3, 1)\n                    </span>\n                    shared easing\n                </span>\n                <span data-kid=\"1-1-7-2-5\" data-name=\"timing item\">\n                    <span class=\"text-[var(--foreground)]\" data-kid=\"1-1-7-2-5-1\" data-name=\"timing value\">\n                        300ms\n                    </span>\n                    colour + notch width\n                </span>\n            </div>\n            <p class=\"mt-4 max-w-3xl text-[12px] leading-relaxed text-[var(--muted-foreground)]\" data-kid=\"1-1-7-3\" data-name=\"mechanic summary text\">\n                <span class=\"font-semibold text-[var(--foreground)]\" data-kid=\"1-1-7-3-1\" data-name=\"bolded label\">\n                    Width is pinned\n                </span>\n                to\n                <span data-kid=\"1-1-7-3-2\" data-name=\"code font span\" style=\"font-family: 'Geist Mono', ui-monospace, monospace\">\n                    9.75rem\n                </span>\n                — the\n\t\t\t\twider of the two label strings — precisely because the text swaps. Both spans are\n\t\t\t\tabsolutely positioned inside a fixed-height mask, so neither string participates in\n\t\t\t\tlayout and the chip cannot resize no matter which one is showing.\n            </p>\n        </div>\n        <!-- 04 responsive -->\n        <div class=\"mb-4 flex items-center gap-3\" data-kid=\"1-1-8\" data-name=\"responsive header\">\n            <p class=\"text-[11px] font-medium tracking-[0.18em] text-[var(--muted-foreground)] uppercase\" data-kid=\"1-1-8-1\" data-name=\"responsive title\">\n                04 — Narrow widths · dark\n            </p>\n            <span class=\"h-px flex-1 bg-[var(--border)]\" data-kid=\"1-1-8-2\" data-name=\"divider line\">\n            </span>\n        </div>\n        <div class=\"flex flex-wrap items-start gap-8\" data-kid=\"1-1-9\" data-name=\"responsive examples\">\n            <div class=\"space-y-2\" data-kid=\"1-1-9-1\" data-name=\"example wrapper\">\n                <div class=\"w-[320px] rounded-2xl bg-[var(--card)] p-4\" data-kid=\"1-1-9-1-1\" data-name=\"card container\">\n                    <div class=\"flex min-w-0 flex-wrap items-center justify-between gap-x-2 gap-y-3\" data-kid=\"1-1-9-1-1-1\" data-name=\"chip row\">\n                        <span class=\"min-w-0 truncate text-xs font-semibold text-[var(--muted-foreground)]\" data-kid=\"1-1-9-1-1-1-1\" data-name=\"job title\">\n                            Full Stack Developer\n                        </span>\n                        <a aria-label=\"Download CV\" class=\"dl-chip\" data-kid=\"1-1-9-1-1-1-2\" data-name=\"download cv chip\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            <span aria-hidden=\"true\" class=\"dl-chip__dot\" data-kid=\"1-1-9-1-1-1-2-1\" data-name=\"chip status dot\">\n                            </span>\n                            <span class=\"dl-chip__labels\" data-kid=\"1-1-9-1-1-1-2-2\" data-name=\"chip text mask\">\n                                <span class=\"dl-chip__label dl-chip__label--a\" data-kid=\"1-1-9-1-1-1-2-2-1\" data-name=\"chip label primary\">\n                                    Download CV\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl-chip__label dl-chip__label--b\" data-kid=\"1-1-9-1-1-1-2-2-2\" data-name=\"chip label secondary\">\n                                    CV · PDF ·\n                                    <span class=\"dl-chip__meta\" data-kid=\"1-1-9-1-1-1-2-2-2-1\" data-name=\"chip meta text\">\n                                        148 KB\n                                    </span>\n                                </span>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__slot\" data-kid=\"1-1-9-1-1-1-2-3\" data-name=\"chip slot\">\n                                <svg class=\"dl-chip__icon\" data-kid=\"1-1-9-1-1-1-2-3-1\" data-name=\"download icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__notch\" data-kid=\"1-1-9-1-1-1-2-4\" data-name=\"chip notch\">\n                            </span>\n                        </a>\n                    </div>\n                </div>\n                <p class=\"text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-1-9-1-2\" data-name=\"example description\">\n                    320px — wraps, 44px tall\n                </p>\n            </div>\n            <div class=\"space-y-2\" data-kid=\"1-1-9-2\" data-name=\"example wrapper\">\n                <div class=\"w-[375px] rounded-2xl bg-[var(--card)] p-4\" data-kid=\"1-1-9-2-1\" data-name=\"card container\">\n                    <div class=\"flex min-w-0 flex-wrap items-center justify-between gap-x-2 gap-y-3\" data-kid=\"1-1-9-2-1-1\" data-name=\"chip row\">\n                        <span class=\"min-w-0 truncate text-xs font-semibold text-[var(--muted-foreground)]\" data-kid=\"1-1-9-2-1-1-1\" data-name=\"job title\">\n                            Full Stack Developer\n                        </span>\n                        <a aria-label=\"Download CV\" class=\"dl-chip\" data-kid=\"1-1-9-2-1-1-2\" data-name=\"download cv chip\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            <span aria-hidden=\"true\" class=\"dl-chip__dot\" data-kid=\"1-1-9-2-1-1-2-1\" data-name=\"chip status dot\">\n                            </span>\n                            <span class=\"dl-chip__labels\" data-kid=\"1-1-9-2-1-1-2-2\" data-name=\"chip text mask\">\n                                <span class=\"dl-chip__label dl-chip__label--a\" data-kid=\"1-1-9-2-1-1-2-2-1\" data-name=\"chip label primary\">\n                                    Download CV\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl-chip__label dl-chip__label--b\" data-kid=\"1-1-9-2-1-1-2-2-2\" data-name=\"chip label secondary\">\n                                    CV · PDF ·\n                                    <span class=\"dl-chip__meta\" data-kid=\"1-1-9-2-1-1-2-2-2-1\" data-name=\"chip meta text\">\n                                        148 KB\n                                    </span>\n                                </span>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__slot\" data-kid=\"1-1-9-2-1-1-2-3\" data-name=\"chip slot\">\n                                <svg class=\"dl-chip__icon\" data-kid=\"1-1-9-2-1-1-2-3-1\" data-name=\"download icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__notch\" data-kid=\"1-1-9-2-1-1-2-4\" data-name=\"chip notch\">\n                            </span>\n                        </a>\n                    </div>\n                </div>\n                <p class=\"text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-1-9-2-2\" data-name=\"example description\">\n                    375px — sits inline\n                </p>\n            </div>\n        </div>\n    </div>\n    <!-- =================== LIGHT HALF =================== -->\n    <div class=\"bg-[var(--background)] px-14 pt-12 pb-16 text-[var(--foreground)]\" data-kid=\"1-2\" data-name=\"light mode section\">\n        <div class=\"mb-4 flex items-center gap-3\" data-kid=\"1-2-1\" data-name=\"context header row\">\n            <p class=\"text-[11px] font-medium tracking-[0.18em] text-[var(--muted-foreground)] uppercase\" data-kid=\"1-2-1-1\" data-name=\"context header label\">\n                01 — In context · light\n            </p>\n            <span class=\"h-px flex-1 bg-[var(--border)]\" data-kid=\"1-2-1-2\" data-name=\"divider line\">\n            </span>\n            <p class=\"text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-2-1-3\" data-name=\"interaction hint\">\n                live — hover the chip\n            </p>\n        </div>\n        <div class=\"mb-14 flex flex-wrap items-start gap-8\" data-kid=\"1-2-2\" data-name=\"interactive demonstration section\">\n            <div class=\"grid h-[236px] w-[580px] grid-cols-[minmax(0,2fr)_minmax(0,3fr)] overflow-hidden rounded-[2rem] bg-[var(--card)]\" data-kid=\"1-2-2-1\" data-name=\"cv card component\">\n                <div class=\"flex min-h-0 min-w-0 items-center justify-center border-r border-[var(--border)] p-5\" data-kid=\"1-2-2-1-1\" data-name=\"cv profile image container\">\n                    <div class=\"h-full w-auto max-w-[17.5rem] overflow-hidden rounded-2xl bg-[var(--muted)] shadow-inner\" data-kid=\"1-2-2-1-1-1\" data-name=\"image wrapper\" style=\"aspect-ratio: 3 / 4\">\n                        <img alt=\"Gonzalo Pozo, Full Stack Developer\" class=\"size-full object-cover grayscale\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"profile image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/cv_pic.png\"/>\n                    </div>\n                </div>\n                <div class=\"grid min-h-0 min-w-0 grid-rows-[auto_minmax(0,1fr)_auto] gap-3 p-5\" data-kid=\"1-2-2-1-2\" data-name=\"cv details content\">\n                    <div class=\"flex min-w-0 flex-wrap items-center justify-between gap-x-2 gap-y-3\" data-kid=\"1-2-2-1-2-1\" data-name=\"chip row\">\n                        <span class=\"min-w-0 truncate text-xs font-semibold tracking-normal text-[var(--muted-foreground)]\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"job title\">\n                            Full Stack Developer\n                        </span>\n                        <a aria-label=\"Download CV\" class=\"dl-chip\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"download cv chip\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            <span aria-hidden=\"true\" class=\"dl-chip__dot\" data-kid=\"1-2-2-1-2-1-2-1\" data-name=\"chip status dot\">\n                            </span>\n                            <span class=\"dl-chip__labels\" data-kid=\"1-2-2-1-2-1-2-2\" data-name=\"chip text mask\">\n                                <span class=\"dl-chip__label dl-chip__label--a\" data-kid=\"1-2-2-1-2-1-2-2-1\" data-name=\"chip label primary\">\n                                    Download CV\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl-chip__label dl-chip__label--b\" data-kid=\"1-2-2-1-2-1-2-2-2\" data-name=\"chip label secondary\">\n                                    CV · PDF ·\n                                    <span class=\"dl-chip__meta\" data-kid=\"1-2-2-1-2-1-2-2-2-1\" data-name=\"chip meta text\">\n                                        148 KB\n                                    </span>\n                                </span>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__slot\" data-kid=\"1-2-2-1-2-1-2-3\" data-name=\"chip slot\">\n                                <svg class=\"dl-chip__icon\" data-kid=\"1-2-2-1-2-1-2-3-1\" data-name=\"download icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__notch\" data-kid=\"1-2-2-1-2-1-2-4\" data-name=\"chip notch\">\n                            </span>\n                        </a>\n                        <div class=\"flex max-h-16 min-w-0 basis-full items-start gap-2.5 rounded-xl border px-3 py-2 text-xs/relaxed font-semibold text-[var(--foreground)] normal-case\" data-kid=\"1-2-2-1-2-1-3\" data-name=\"status indicator pill\" role=\"status\" style=\"\n\t\t\t\t\t\t\t\tborder-color: color-mix(in oklch, var(--status-active) 35%, transparent);\n\t\t\t\t\t\t\t\tbackground: color-mix(in oklch, var(--status-active) 10%, transparent);\n\t\t\t\t\t\t\t\">\n                            <span aria-hidden=\"true\" class=\"mt-1 size-2 shrink-0 rounded-full bg-[var(--status-active)] motion-safe:animate-pulse\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-1-3-1\" data-name=\"status pulse dot\" data-reason=\"animation re-initializes or maintains pulse state\">\n                            </span>\n                            <span class=\"min-w-0 text-pretty\" data-kid=\"1-2-2-1-2-1-3-2\" data-name=\"status text\">\n                                Actualmente buscando empleo\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"flex min-h-0 min-w-0 flex-col justify-center gap-2 overflow-hidden\" data-kid=\"1-2-2-1-2-2\" data-name=\"cv summary\">\n                        <p class=\"text-2xl/tight font-bold tracking-tight text-balance\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"cv headline\">\n                            Hey, I'm Gonzalo.\n                        </p>\n                        <p class=\"line-clamp-3 max-w-md text-sm/relaxed text-pretty text-[var(--muted-foreground)]\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"cv summary text\">\n                            I love turning ideas into real products people can use. I care about\n\t\t\t\t\t\t\tthoughtful interfaces, solid backend foundations, and the kind of\n\t\t\t\t\t\t\tcurious, collaborative work that keeps improving the product, the code,\n\t\t\t\t\t\t\tand the people building it.\n                        </p>\n                    </div>\n                    <div class=\"flex min-w-0 justify-end\" data-kid=\"1-2-2-1-2-3\" data-name=\"about me call-to-action\">\n                        <span class=\"inline-flex min-h-11 items-center gap-2 rounded-full bg-[var(--primary)] px-5 text-sm font-medium text-[var(--primary-foreground)]\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"about me link\">\n                            About Me\n                            <svg aria-hidden=\"true\" class=\"size-4\" data-kid=\"1-2-2-1-2-3-1-1\" data-name=\"right arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n                                <path d=\"M5 12h14\">\n                                </path>\n                                <path d=\"m12 5 7 7-7 7\">\n                                </path>\n                            </svg>\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"max-w-[380px] space-y-3 pt-1\" data-kid=\"1-2-2-2\" data-name=\"changes description list\">\n                <p class=\"text-[11px] font-medium tracking-[0.18em] text-[var(--muted-foreground)] uppercase\" data-kid=\"1-2-2-2-1\" data-name=\"list title\">\n                    Light-mode notes\n                </p>\n                <ul class=\"space-y-2.5 text-[13px] leading-relaxed text-[var(--muted-foreground)]\" data-kid=\"1-2-2-2-2\" data-name=\"changes list\">\n                    <li class=\"flex gap-2.5\" data-kid=\"1-2-2-2-2-1\" data-name=\"list item\">\n                        <span class=\"mt-1.5 size-1.5 shrink-0 rounded-full bg-[var(--accent)]\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"list item bullet\">\n                        </span>\n                        <span data-kid=\"1-2-2-2-2-1-2\" data-name=\"list item text\">\n                            The chip's rest border is the same hairline as the card divider, so it\n\t\t\t\t\t\t\treads as part of the card rather than a floating button.\n                        </span>\n                    </li>\n                    <li class=\"flex gap-2.5\" data-kid=\"1-2-2-2-2-2\" data-name=\"list item\">\n                        <span class=\"mt-1.5 size-1.5 shrink-0 rounded-full bg-[var(--accent)]\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"list item bullet\">\n                        </span>\n                        <span data-kid=\"1-2-2-2-2-2-2\" data-name=\"list item text\">\n                            Gold at 10% over white stays warm and quiet — the hover never\n\t\t\t\t\t\t\tout-shouts the sapphire \"About Me\" CTA.\n                        </span>\n                    </li>\n                    <li class=\"flex gap-2.5\" data-kid=\"1-2-2-2-2-3\" data-name=\"list item\">\n                        <span class=\"mt-1.5 size-1.5 shrink-0 rounded-full bg-[var(--accent)]\" data-kid=\"1-2-2-2-2-3-1\" data-name=\"list item bullet\">\n                        </span>\n                        <span data-kid=\"1-2-2-2-2-3-2\" data-name=\"list item text\">\n                            File-meta text switches to\n                            <span class=\"text-[var(--foreground)]\" data-kid=\"1-2-2-2-2-3-2-1\" data-name=\"bolded text span\">\n                                foreground\n                            </span>\n                            , keeping it\n\t\t\t\t\t\t\tlegible at 11px on the pale surface.\n                        </span>\n                    </li>\n                </ul>\n            </div>\n        </div>\n        <div class=\"mb-4 flex items-center gap-3\" data-kid=\"1-2-3\" data-name=\"state matrix header\">\n            <p class=\"text-[11px] font-medium tracking-[0.18em] text-[var(--muted-foreground)] uppercase\" data-kid=\"1-2-3-1\" data-name=\"matrix title\">\n                02 — State matrix · light\n            </p>\n            <span class=\"h-px flex-1 bg-[var(--border)]\" data-kid=\"1-2-3-2\" data-name=\"divider line\">\n            </span>\n            <p class=\"text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-2-3-3\" data-name=\"matrix hint\">\n                dashed guides = the rest chip's left / right edges\n            </p>\n        </div>\n        <div class=\"mb-14 rounded-2xl bg-[var(--card)] p-6\" data-kid=\"1-2-4\" data-name=\"state matrix container\">\n            <div class=\"relative w-fit\" data-kid=\"1-2-4-1\" data-name=\"matrix grid\">\n                <div class=\"pointer-events-none absolute top-0 bottom-0 left-[192px] w-[156px] border-x border-dashed\" data-kid=\"1-2-4-1-1\" data-name=\"grid guide line\" style=\"border-color: color-mix(in oklch, var(--accent) 55%, transparent)\">\n                </div>\n                <div class=\"relative flex flex-col gap-4\" data-kid=\"1-2-4-1-2\" data-name=\"state rows container\">\n                    <div class=\"flex items-center gap-6\" data-kid=\"1-2-4-1-2-1\" data-name=\"rest state row\">\n                        <p class=\"w-[168px] text-right text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-2-4-1-2-1-1\" data-name=\"state label\">\n                            Rest\n                        </p>\n                        <a aria-label=\"Download CV\" class=\"dl-chip\" data-dl=\"rest\" data-kid=\"1-2-4-1-2-1-2\" data-name=\"download cv chip\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            <span aria-hidden=\"true\" class=\"dl-chip__dot\" data-kid=\"1-2-4-1-2-1-2-1\" data-name=\"chip status dot\">\n                            </span>\n                            <span class=\"dl-chip__labels\" data-kid=\"1-2-4-1-2-1-2-2\" data-name=\"chip text mask\">\n                                <span class=\"dl-chip__label dl-chip__label--a\" data-kid=\"1-2-4-1-2-1-2-2-1\" data-name=\"chip label primary\">\n                                    Download CV\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl-chip__label dl-chip__label--b\" data-kid=\"1-2-4-1-2-1-2-2-2\" data-name=\"chip label secondary\">\n                                    CV · PDF ·\n                                    <span class=\"dl-chip__meta\" data-kid=\"1-2-4-1-2-1-2-2-2-1\" data-name=\"chip meta text\">\n                                        148 KB\n                                    </span>\n                                </span>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__slot\" data-kid=\"1-2-4-1-2-1-2-3\" data-name=\"chip slot\">\n                                <svg class=\"dl-chip__icon\" data-kid=\"1-2-4-1-2-1-2-3-1\" data-name=\"download icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__notch\" data-kid=\"1-2-4-1-2-1-2-4\" data-name=\"chip notch\">\n                            </span>\n                        </a>\n                    </div>\n                    <div class=\"flex items-center gap-6\" data-kid=\"1-2-4-1-2-2\" data-name=\"hover state row\">\n                        <p class=\"w-[168px] text-right text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"state label\">\n                            Hover\n                        </p>\n                        <a aria-label=\"Download CV\" class=\"dl-chip\" data-dl=\"hover\" data-kid=\"1-2-4-1-2-2-2\" data-name=\"download cv chip\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            <span aria-hidden=\"true\" class=\"dl-chip__dot\" data-kid=\"1-2-4-1-2-2-2-1\" data-name=\"chip status dot\">\n                            </span>\n                            <span class=\"dl-chip__labels\" data-kid=\"1-2-4-1-2-2-2-2\" data-name=\"chip text mask\">\n                                <span class=\"dl-chip__label dl-chip__label--a\" data-kid=\"1-2-4-1-2-2-2-2-1\" data-name=\"chip label primary\">\n                                    Download CV\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl-chip__label dl-chip__label--b\" data-kid=\"1-2-4-1-2-2-2-2-2\" data-name=\"chip label secondary\">\n                                    CV · PDF ·\n                                    <span class=\"dl-chip__meta\" data-kid=\"1-2-4-1-2-2-2-2-2-1\" data-name=\"chip meta text\">\n                                        148 KB\n                                    </span>\n                                </span>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__slot\" data-kid=\"1-2-4-1-2-2-2-3\" data-name=\"chip slot\">\n                                <svg class=\"dl-chip__icon\" data-kid=\"1-2-4-1-2-2-2-3-1\" data-name=\"download icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" view