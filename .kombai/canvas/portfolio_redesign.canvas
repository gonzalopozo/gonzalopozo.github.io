on state row\">\n                        <p class=\"w-[168px] text-right text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-2-4-1-2-5-1\" data-name=\"state label\">\n                            Reduced motion (hover)\n                        </p>\n                        <a aria-label=\"Download CV\" class=\"dl-chip\" data-dl=\"reduced\" data-kid=\"1-2-4-1-2-5-2\" data-name=\"download cv chip\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            <span aria-hidden=\"true\" class=\"dl-chip__dot\" data-kid=\"1-2-4-1-2-5-2-1\" data-name=\"chip status dot\">\n                            </span>\n                            <span class=\"dl-chip__labels\" data-kid=\"1-2-4-1-2-5-2-2\" data-name=\"chip text mask\">\n                                <span class=\"dl-chip__label dl-chip__label--a\" data-kid=\"1-2-4-1-2-5-2-2-1\" data-name=\"chip label primary\">\n                                    Download CV\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl-chip__label dl-chip__label--b\" data-kid=\"1-2-4-1-2-5-2-2-2\" data-name=\"chip label secondary\">\n                                    CV · PDF ·\n                                    <span class=\"dl-chip__meta\" data-kid=\"1-2-4-1-2-5-2-2-2-1\" data-name=\"chip meta text\">\n                                        148 KB\n                                    </span>\n                                </span>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__slot\" data-kid=\"1-2-4-1-2-5-2-3\" data-name=\"chip slot\">\n                                <svg class=\"dl-chip__icon\" data-kid=\"1-2-4-1-2-5-2-3-1\" data-name=\"download icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__notch\" data-kid=\"1-2-4-1-2-5-2-4\" data-name=\"chip notch\">\n                            </span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"mb-4 flex items-center gap-3\" data-kid=\"1-2-5\" data-name=\"responsive header\">\n            <p class=\"text-[11px] font-medium tracking-[0.18em] text-[var(--muted-foreground)] uppercase\" data-kid=\"1-2-5-1\" data-name=\"responsive title\">\n                04 — Narrow widths · light\n            </p>\n            <span class=\"h-px flex-1 bg-[var(--border)]\" data-kid=\"1-2-5-2\" data-name=\"divider line\">\n            </span>\n        </div>\n        <div class=\"mb-12 flex flex-wrap items-start gap-8\" data-kid=\"1-2-6\" data-name=\"responsive examples\">\n            <div class=\"space-y-2\" data-kid=\"1-2-6-1\" data-name=\"example wrapper\">\n                <div class=\"w-[320px] rounded-2xl bg-[var(--card)] p-4\" data-kid=\"1-2-6-1-1\" data-name=\"card container\">\n                    <div class=\"flex min-w-0 flex-wrap items-center justify-between gap-x-2 gap-y-3\" data-kid=\"1-2-6-1-1-1\" data-name=\"chip row\">\n                        <span class=\"min-w-0 truncate text-xs font-semibold text-[var(--muted-foreground)]\" data-kid=\"1-2-6-1-1-1-1\" data-name=\"job title\">\n                            Full Stack Developer\n                        </span>\n                        <a aria-label=\"Download CV\" class=\"dl-chip\" data-kid=\"1-2-6-1-1-1-2\" data-name=\"download cv chip\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            <span aria-hidden=\"true\" class=\"dl-chip__dot\" data-kid=\"1-2-6-1-1-1-2-1\" data-name=\"chip status dot\">\n                            </span>\n                            <span class=\"dl-chip__labels\" data-kid=\"1-2-6-1-1-1-2-2\" data-name=\"chip text mask\">\n                                <span class=\"dl-chip__label dl-chip__label--a\" data-kid=\"1-2-6-1-1-1-2-2-1\" data-name=\"chip label primary\">\n                                    Download CV\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl-chip__label dl-chip__label--b\" data-kid=\"1-2-6-1-1-1-2-2-2\" data-name=\"chip label secondary\">\n                                    CV · PDF ·\n                                    <span class=\"dl-chip__meta\" data-kid=\"1-2-6-1-1-1-2-2-2-1\" data-name=\"chip meta text\">\n                                        148 KB\n                                    </span>\n                                </span>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__slot\" data-kid=\"1-2-6-1-1-1-2-3\" data-name=\"chip slot\">\n                                <svg class=\"dl-chip__icon\" data-kid=\"1-2-6-1-1-1-2-3-1\" data-name=\"download icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__notch\" data-kid=\"1-2-6-1-1-1-2-4\" data-name=\"chip notch\">\n                            </span>\n                        </a>\n                    </div>\n                </div>\n                <p class=\"text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-2-6-1-2\" data-name=\"example description\">\n                    320px — wraps, 44px tall\n                </p>\n            </div>\n            <div class=\"space-y-2\" data-kid=\"1-2-6-2\" data-name=\"example wrapper\">\n                <div class=\"w-[375px] rounded-2xl bg-[var(--card)] p-4\" data-kid=\"1-2-6-2-1\" data-name=\"card container\">\n                    <div class=\"flex min-w-0 flex-wrap items-center justify-between gap-x-2 gap-y-3\" data-kid=\"1-2-6-2-1-1\" data-name=\"chip row\">\n                        <span class=\"min-w-0 truncate text-xs font-semibold text-[var(--muted-foreground)]\" data-kid=\"1-2-6-2-1-1-1\" data-name=\"job title\">\n                            Full Stack Developer\n                        </span>\n                        <a aria-label=\"Download CV\" class=\"dl-chip\" data-kid=\"1-2-6-2-1-1-2\" data-name=\"download cv chip\" href=\"#\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            <span aria-hidden=\"true\" class=\"dl-chip__dot\" data-kid=\"1-2-6-2-1-1-2-1\" data-name=\"chip status dot\">\n                            </span>\n                            <span class=\"dl-chip__labels\" data-kid=\"1-2-6-2-1-1-2-2\" data-name=\"chip text mask\">\n                                <span class=\"dl-chip__label dl-chip__label--a\" data-kid=\"1-2-6-2-1-1-2-2-1\" data-name=\"chip label primary\">\n                                    Download CV\n                                </span>\n                                <span aria-hidden=\"true\" class=\"dl-chip__label dl-chip__label--b\" data-kid=\"1-2-6-2-1-1-2-2-2\" data-name=\"chip label secondary\">\n                                    CV · PDF ·\n                                    <span class=\"dl-chip__meta\" data-kid=\"1-2-6-2-1-1-2-2-2-1\" data-name=\"chip meta text\">\n                                        148 KB\n                                    </span>\n                                </span>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__slot\" data-kid=\"1-2-6-2-1-1-2-3\" data-name=\"chip slot\">\n                                <svg class=\"dl-chip__icon\" data-kid=\"1-2-6-2-1-1-2-3-1\" data-name=\"download icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 24 24\">\n                                    <path d=\"M12 17V3\">\n                                    </path>\n                                    <path d=\"m6 11 6 6 6-6\">\n                                    </path>\n                                    <path d=\"M19 21H5\">\n                                    </path>\n                                </svg>\n                            </span>\n                            <span aria-hidden=\"true\" class=\"dl-chip__notch\" data-kid=\"1-2-6-2-1-1-2-4\" data-name=\"chip notch\">\n                            </span>\n                        </a>\n                    </div>\n                </div>\n                <p class=\"text-[11px] text-[var(--muted-foreground)]\" data-kid=\"1-2-6-2-2\" data-name=\"example description\">\n                    375px — sits inline\n                </p>\n            </div>\n        </div>\n        <div class=\"rounded-2xl border border-[var(--border)] bg-[var(--card)] p-6\" data-kid=\"1-2-7\" data-name=\"accessibility section\">\n            <p class=\"mb-3 text-[11px] font-medium tracking-[0.18em] text-[var(--muted-foreground)] uppercase\" data-kid=\"1-2-7-1\" data-name=\"section title\">\n                Accessibility & semantics\n            </p>\n            <ul class=\"grid gap-2.5 text-[12px] leading-relaxed text-[var(--muted-foreground)] md:grid-cols-2\" data-kid=\"1-2-7-2\" data-name=\"accessibility list\">\n                <li data-kid=\"1-2-7-2-1\" data-name=\"accessibility item\">\n                    <span class=\"font-semibold text-[var(--foreground)]\" data-kid=\"1-2-7-2-1-1\" data-name=\"label text\">\n                        Accessible name never changes.\n                    </span>\n                    The link keeps\n                    <span data-kid=\"1-2-7-2-1-2\" data-name=\"code font span\" style=\"font-family: 'Geist Mono', ui-monospace, monospace\">\n                        aria-label=\"Download CV\"\n                    </span>\n                    ; the swapped-in \"CV · PDF · 148 KB\" string is\n                    <span data-kid=\"1-2-7-2-1-3\" data-name=\"code font span\" style=\"font-family: 'Geist Mono', ui-monospace, monospace\">\n                        aria-hidden\n                    </span>\n                    decoration.\n                </li>\n                <li data-kid=\"1-2-7-2-2\" data-name=\"accessibility item\">\n                    <span class=\"font-semibold text-[var(--foreground)]\" data-kid=\"1-2-7-2-2-1\" data-name=\"label text\">\n                        External link intact.\n                    </span>\n                    <span data-kid=\"1-2-7-2-2-2\" data-name=\"code font span\" style=\"font-family: 'Geist Mono', ui-monospace, monospace\">\n                        target=\"_blank\" rel=\"noopener noreferrer\"\n                    </span>\n                    on the configured resume URL, still conditionally rendered.\n                </li>\n                <li data-kid=\"1-2-7-2-3\" data-name=\"accessibility item\">\n                    <span class=\"font-semibold text-[var(--foreground)]\" data-kid=\"1-2-7-2-3-1\" data-name=\"label text\">\n                        Icon hidden from AT.\n                    </span>\n                    The arrow is\n                    <span data-kid=\"1-2-7-2-3-2\" data-name=\"code font span\" style=\"font-family: 'Geist Mono', ui-monospace, monospace\">\n                        aria-hidden=\"true\"\n                    </span>\n                    ,\n\t\t\t\t\tso the visible label alone carries meaning.\n                </li>\n                <li data-kid=\"1-2-7-2-4\" data-name=\"accessibility item\">\n                    <span class=\"font-semibold text-[var(--foreground)]\" data-kid=\"1-2-7-2-4-1\" data-name=\"label text\">\n                        44px touch target\n                    </span>\n                    preserved via\n                    <span data-kid=\"1-2-7-2-4-2\" data-name=\"code font span\" style=\"font-family: 'Geist Mono', ui-monospace, monospace\">\n                        min-h-11\n                    </span>\n                    , with a real\n\t\t\t\t\tpressed state for touch instead of relying on hover.\n                </li>\n                <li data-kid=\"1-2-7-2-5\" data-name=\"accessibility item\">\n                    <span class=\"font-semibold text-[var(--foreground)]\" data-kid=\"1-2-7-2-5-1\" data-name=\"label text\">\n                        Reduced motion is still legible.\n                    </span>\n                    Roll and dock are gated behind\n                    <span data-kid=\"1-2-7-2-5-2\" data-name=\"code font span\" style=\"font-family: 'Geist Mono', ui-monospace, monospace\">\n                        motion-safe:\n                    </span>\n                    ; border,\n\t\t\t\t\tsurface, dot and notch colour still change.\n                </li>\n                <li data-kid=\"1-2-7-2-6\" data-name=\"accessibility item\">\n                    <span class=\"font-semibold text-[var(--foreground)]\" data-kid=\"1-2-7-2-6-1\" data-name=\"label text\">\n                        Zero reflow.\n                    </span>\n                    Every animated\n\t\t\t\t\tpart is either masked, absolutely positioned, or inside a reserved fixed-size slot.\n                </li>\n            </ul>\n        </div>\n    </div>\n</div>\n",
