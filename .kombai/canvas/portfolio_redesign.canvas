      "html": "\n<style>\n* { box-sizing: border-box; }\n\n.sheet {\n\twidth: 100%;\n\tmin-height: 800px;\n\tpadding: 30px;\n\tbackground: oklch(0.94 0.012 270);\n\tcolor: oklch(0.155 0.025 270);\n\tfont-family: Geist, ui-sans-serif, system-ui, sans-serif;\n}\n\n.spec-header {\n\tdisplay: flex;\n\talign-items: end;\n\tjustify-content: space-between;\n\tgap: 24px;\n\tmargin-bottom: 22px;\n}\n\n.spec-kicker,\n.theme-kicker,\n.section-label {\n\tmargin: 0;\n\tcolor: oklch(0.43 0.02 265);\n\tfont-size: 10px;\n\tfont-weight: 700;\n\tletter-spacing: 0.16em;\n\ttext-transform: uppercase;\n}\n\n.spec-title {\n\tmargin: 5px 0 0;\n\tfont-size: 24px;\n\tline-height: 1.1;\n\tletter-spacing: -0.025em;\n}\n\n.spec-summary {\n\tmax-width: 520px;\n\tmargin: 0;\n\tcolor: oklch(0.43 0.02 265);\n\tfont-size: 12px;\n\tline-height: 1.5;\n\ttext-align: right;\n}\n\n.themes {\n\tdisplay: grid;\n\tgrid-template-columns: repeat(2, minmax(0, 1fr));\n\tgap: 22px;\n}\n\n.theme-panel {\n\t--background: oklch(0.975 0.008 270);\n\t--foreground: oklch(0.155 0.025 270);\n\t--card: oklch(1 0 0);\n\t--primary: oklch(0.4 0.17 250);\n\t--secondary: oklch(0.945 0.012 270);\n\t--muted-foreground: oklch(0.43 0.02 265);\n\t--accent: oklch(0.7 0.18 55);\n\t--border: oklch(0.885 0.012 270);\n\t--status-active: oklch(0.52 0.175 155);\n\n\tmin-width: 0;\n\theight: 660px;\n\toverflow: hidden;\n\tborder: 1px solid var(--border);\n\tborder-radius: 24px;\n\tbackground: var(--background);\n\tcolor: var(--foreground);\n\tpadding: 22px;\n}\n\n.theme-panel.dark {\n\t--background: oklch(0.12 0.025 275);\n\t--foreground: oklch(0.95 0.008 265);\n\t--card: oklch(0.175 0.022 270);\n\t--primary: oklch(0.75 0.17 235);\n\t--secondary: oklch(0.225 0.018 275);\n\t--muted-foreground: oklch(0.58 0.016 265);\n\t--accent: oklch(0.8 0.17 50);\n\t--border: oklch(0.265 0.018 275);\n\t--status-active: oklch(0.7 0.175 155);\n}\n\n.theme-kicker,\n.section-label {\n\tcolor: var(--muted-foreground);\n}\n\n.context-card {\n\tmargin-top: 12px;\n\tborder: 1px solid color-mix(in oklch, var(--border) 70%, transparent);\n\tborder-radius: 18px;\n\tbackground: var(--card);\n\tpadding: 14px;\n}\n\n.header-row {\n\tdisplay: flex;\n\tmin-width: 0;\n\tflex-wrap: wrap;\n\talign-items: center;\n\tjustify-content: space-between;\n\tgap: 8px 10px;\n}\n\n.role-label {\n\tmin-width: 0;\n\toverflow: hidden;\n\tcolor: var(--primary);\n\tfont-size: 12px;\n\tfont-weight: 600;\n\tletter-spacing: 0;\n\ttext-overflow: ellipsis;\n\twhite-space: nowrap;\n}\n\n.status {\n\tdisplay: flex;\n\tflex-basis: 100%;\n\talign-items: center;\n\tgap: 8px;\n\tmin-height: 34px;\n\tborder: 1px solid color-mix(in oklch, var(--status-active) 26%, transparent);\n\tborder-radius: 11px;\n\tbackground: color-mix(in oklch, var(--status-active) 7%, transparent);\n\tpadding: 7px 10px;\n\tcolor: var(--foreground);\n\tfont-size: 10px;\n\tfont-weight: 600;\n\tline-height: 1.35;\n}\n\n.status-dot {\n\twidth: 7px;\n\theight: 7px;\n\tflex: none;\n\tborder-radius: 999px;\n\tbackground: var(--status-active);\n}\n\n.live-note {\n\tmargin: 8px 0 0;\n\tcolor: var(--muted-foreground);\n\tfont-size: 10px;\n\tline-height: 1.4;\n}\n\n.states-block {\n\tmargin-top: 16px;\n}\n\n.state-grid {\n\tdisplay: grid;\n\tgrid-template-columns: repeat(3, minmax(0, 1fr));\n\tgap: 7px;\n\tmargin-top: 9px;\n}\n\n.state-cell {\n\tmin-width: 0;\n\tborder: 1px solid color-mix(in oklch, var(--border) 65%, transparent);\n\tborder-radius: 12px;\n\tpadding: 9px 6px;\n\tbackground: color-mix(in oklch, var(--card) 82%, transparent);\n\ttext-align: center;\n}\n\n.state-name {\n\tmargin: 7px 0 0;\n\tcolor: var(--muted-foreground);\n\tfont-size: 9px;\n\tfont-weight: 650;\n\tline-height: 1.2;\n}\n\n.mobile-proof {\n\tmargin-top: 16px;\n}\n\n.mobile-frame {\n\twidth: 320px;\n\tmax-width: 100%;\n\tmargin-top: 9px;\n\tborder: 1px dashed color-mix(in oklch, var(--border) 85%, transparent);\n\tborder-radius: 14px;\n\tbackground: var(--card);\n\tpadding: 10px;\n}\n\n.mobile-row {\n\tdisplay: flex;\n\tmin-width: 0;\n\tflex-wrap: wrap;\n\talign-items: center;\n\tjustify-content: space-between;\n\tgap: 8px;\n}\n\n.dl {\n\tposition: relative;\n\tisolation: isolate;\n\tdisplay: inline-flex;\n\twidth: 138px;\n\theight: 44px;\n\tflex: none;\n\ttouch-action: manipulation;\n\talign-items: center;\n\tjustify-content: center;\n\tgap: 8px;\n\tborder-width: 1px;\n\tborder-style: solid;\n\tborder-radius: 999px;\n\tpadding: 0 11px;\n\toverflow: visible;\n\tcolor: var(--muted-foreground);\n\tfont-size: 12px;\n\tfont-weight: 650;\n\tletter-spacing: 0.025em;\n\tline-height: 1;\n\ttext-decoration: none;\n\twhite-space: nowrap;\n\toutline: none;\n}\n\n.dl__surface {\n\tposition: absolute;\n\tinset: 0;\n\tz-index: -1;\n\tborder-radius: inherit;\n\tpointer-events: none;\n}\n\n.dl__label {\n\tposition: relative;\n\tz-index: 1;\n}\n\n.dl__slot {\n\tposition: relative;\n\tz-index: 1;\n\tdisplay: grid;\n\twidth: 20px;\n\theight: 20px;\n\tflex: none;\n\tplace-items: center;\n\toverflow: hidden;\n}\n\n.dl__icon {\n\twidth: 16px;\n\theight: 16px;\n\tstroke: currentColor;\n\tstroke-width: 2;\n}\n\n.dl__baseline,\n.dl__tray {\n\tposition: absolute;\n\tz-index: 1;\n\tpointer-events: none;\n}\n\n.dl:is(:focus-visible, [data-state='focus']) {\n\tbox-shadow:\n\t\t0 0 0 2px var(--card),\n\t\t0 0 0 4px color-mix(in oklch, var(--accent) 62%, transparent);\n}\n\n.dl:is(:active, [data-state='active']) .dl__surface {\n\tbox-shadow: inset 0 2px 5px color-mix(in oklch, var(--foreground) 22%, transparent);\n}\n\n@media (prefers-reduced-motion: no-preference) {\n\t.dl {\n\t\ttransition:\n\t\t\tbackground-color 180ms ease-out,\n\t\t\tborder-color 180ms ease-out,\n\t\t\tcolor 180ms ease-out;\n\t}\n\n\t.dl__icon {\n\t\ttransform-origin: center;\n\t\ttransition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);\n\t}\n}\n\n@media (forced-colors: active) {\n\t.dl:focus-visible {\n\t\toutline: 2px solid CanvasText;\n\t\toutline-offset: 2px;\n\t\tbox-shadow: none;\n\t}\n}\n</style>\n<style>\n.dl {\n\tborder-color: color-mix(in oklch, var(--border) 78%, transparent);\n\tbackground: color-mix(in oklch, var(--secondary) 42%, transparent);\n}\n\n.dl__slot {\n\tpadding-bottom: 2px;\n}\n\n.dl__tray {\n\tright: 1px;\n\tbottom: 1px;\n\tleft: 1px;\n\theight: 2px;\n\tborder-radius: 999px;\n\tbackground: color-mix(in oklch, var(--border) 80%, transparent);\n\topacity: 0.7;\n}\n\n.dl__baseline { display: none; }\n\n.dl:is(:hover, :focus-visible, [data-state='hover'], [data-state='focus'], [data-state='active'], [data-state='reduced']) {\n\tborder-color: color-mix(in oklch, var(--accent) 52%, transparent);\n\tbackground: color-mix(in oklch, var(--accent) 10%, transparent);\n\tcolor: var(--foreground);\n}\n\n.dl:is(:hover, :focus-visible, [data-state='hover'], [data-state='focus'], [data-state='active'], [data-state='reduced']) .dl__tray {\n\tbackground: var(--accent);\n\topacity: 1;\n}\n\n.dl:is(:active, [data-state='active']) {\n\tborder-color: color-mix(in oklch, var(--accent) 72%, transparent);\n\tbackground: color-mix(in oklch, var(--accent) 16%, transparent);\n}\n\n@media (prefers-reduced-motion: no-preference) {\n\t.dl:not([data-state='reduced']):is(:hover, :focus-visible, [data-state='hover'], [data-state='focus']) .dl__icon {\n\t\ttransform: scale(1.08);\n\t}\n\n\t.dl:not([data-state='reduced']):is(:active, [data-state='active']) .dl__icon {\n\t\ttransform: scale(1.05);\n\t}\n}\n</style>\n<main data-kid=\"1\" class=\"sheet\">\n\t<header data-kid=\"2\" class=\"spec-header\">\n\t\t<div data-kid=\"3\">\n\t\t\t<p data-kid=\"4\" class=\"spec-kicker\">Scale-only download interaction · Option 1 of 3</p>\n\t\t\t<h1 data-kid=\"5\" class=\"spec-title\">1 — Quiet Magnify</h1>\n\t\t</div>\n\t\t<p data-kid=\"6\" class=\"spec-summary\">The document icon grows by 8% from its center while the dock turns gold. This is the calmest option: clear action feedback with almost no visual noise.</p>\n\t</header>\n\t<div data-kid=\"7\" class=\"themes\">\n\t\t<section data-kid=\"73\" class=\"theme-panel\"