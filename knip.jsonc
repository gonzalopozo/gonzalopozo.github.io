{
	"$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
	// Extra entry points not covered by the Next.js plugin (see https://knip.dev/explanations/entry-files)
	"entry": [
		"commitlint.config.mts",
		"components/ui/**/*.{ts,tsx}",
		"lib/queries/**/*.ts",
		"scripts/**/*.{mts,ts}",
	],
	// Include repo-local TypeScript modules so Knip follows admin/public components behind route imports.
	"project": ["**/*.{js,jsx,ts,tsx,mts}"],
	// Retained shadcn/admin/map/testing packages and CSS-only imports that Knip cannot prove from the current graph.
	"ignoreDependencies": [
		"@commitlint/config-conventional",
		"@dnd-kit/helpers",
		"@number-flow/react",
		"@radix-ui/react-alert-dialog",
		"@radix-ui/react-checkbox",
		"@radix-ui/react-select",
		"@teritorio/openmaptiles-gl-language",
		"@testing-library/dom",
		"@testing-library/react",
		"crypto",
		"react-map-gl",
		"react-resizable",
		"tailwindcss-animate",
		"tw-animate-css",
		"util",
	],
	// The graph script uses the system Graphviz `dot` binary.
	"ignoreBinaries": ["dot"],
	// Drizzle config lives under db/ (default plugin only looks for ./drizzle.config.*)
	"drizzle": {
		"config": ["db/drizzle.config.ts"],
	},
}
