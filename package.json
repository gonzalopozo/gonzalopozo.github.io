		"skills:update": "pnpm dlx skills update -y",
		"skills:sync": "pnpm skills:check && pnpm skills:update",
		"icons:manifest": "pnpm tsx scripts/generate-icon-manifest.mts",
		"hooks:install": "pnpm exec husky",
		"prepare": "husky"
